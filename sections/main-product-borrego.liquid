      min-width: 46vw;
    }
  }

  @media screen and (max-width: 749px) {
    .borrego-product {
      padding-top: calc(var(--padding-top) * 0.72);
      padding-bottom: calc(var(--padding-bottom) * 0.72);
    }

    .borrego-product__inner {
      padding: 0 16px;
      gap: 34px;
    }

    .borrego-product__media-main,
    .borrego-product__image {
      min-height: 400px;
    }

    .borrego-product__image {
      padding: 6%;
      transform: scale(1.03);
    }

    .borrego-product__gallery-arrow {
      width: 34px;
      height: 34px;
      font-size: 22px;
    }

