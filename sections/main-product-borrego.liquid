    color: var(--text);
  }

  .borrego-related__media {
    height: 420px;
    background: var(--card-bg);
    overflow: hidden;
  }

  .borrego-related__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12%;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .borrego-related__card:hover .borrego-related__image {
    transform: scale(1.05) translateY(-4px);
  }

  .borrego-related__content {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding-top: 16px;
  }

  .borrego-related__content h3 {
    margin: 0;
    color: var(--text);
    font-size: 12px;
    line-height: 1.45;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .borrego-related__content span {
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
  }

  .borrego-product--animated .borrego-product__gallery,
  .borrego-product--animated .borrego-product__info,
  .borrego-product--animated .borrego-related {
    opacity: 0;
    transform: translateY(28px);
    animation: borregoProductReveal 950ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .borrego-product--animated .borrego-product__info {
    animation-delay: 120ms;
  }

  .borrego-product--animated .borrego-related {
    animation-delay: 220ms;
  }

  @keyframes borregoProductReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    .borrego-product__inner {
      grid-template-columns: 1fr;
      gap: 44px;
      padding: 0 28px;
    }

    .borrego-product__info {
      position: static;
    }

    .borrego-product__media-main,
    .borrego-product__image {
      min-height: 520px;
    }

    .borrego-related__card {
