  @media (prefers-reduced-motion: reduce) {
    .borrego-product *,
    .borrego-product *::before,
    .borrego-product *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
<script>
  (() => {
    const section = document.currentScript.closest('.borrego-product');
    if (!section) return;

    const thumbs = [...section.querySelectorAll('[data-borrego-thumb]')];
    const mediaItems = [...section.querySelectorAll('[data-borrego-media]')];
    const prevButton = section.querySelector('[data-gallery-prev]');
    const nextButton = section.querySelector('[data-gallery-next]');
    const variantData = section.querySelector('[data-borrego-variants]');
    const optionInputs = [...section.querySelectorAll('[data-option-position]')];
    const priceEl = section.querySelector('[data-borrego-price]');
    const availabilityEl = section.querySelector('[data-borrego-availability]');
    const whatsappButton = section.querySelector('[data-borrego-whatsapp]');
    const mainGallery = section.querySelector('.borrego-product__media-main');

    let currentIndex = mediaItems.findIndex((item) => item.classList.contains('is-active'));
    let touchStartX = 0;
    let variants = [];

    if (currentIndex < 0) currentIndex = 0;

    if (variantData) {
      try {
        variants = JSON.parse(variantData.textContent);
      } catch (error) {
        variants = [];
      }
    }

    const formatMoney = (cents) => {
      if (window.Shopify && Shopify.formatMoney) {
        return Shopify.formatMoney(cents, {{ shop.money_format | json }});
      }

      return (cents / 100).toFixed(2);
    };

    const showMedia = (index) => {
      if (!mediaItems.length) return;

      currentIndex = (index + mediaItems.length) % mediaItems.length;

      const activeItem = mediaItems[currentIndex];
      const activeId = activeItem.dataset.borregoMedia;

      mediaItems.forEach((item) => item.classList.remove('is-active'));
      thumbs.forEach((item) => item.classList.remove('is-active'));

      activeItem.classList.add('is-active');

      const activeThumb = section.querySelector(`[data-borrego-thumb="${activeId}"]`);
      activeThumb?.classList.add('is-active');
      activeThumb?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    };

    const getSelectedOptions = () => {
      const selected = [];

      optionInputs.forEach((input) => {
        if (!input.checked) return;
        selected[Number(input.dataset.optionPosition) - 1] = input.value;
      });

      return selected;
    };

    const getVariantFromOptions = (options) => {
      return variants.find((variant) => {
        return variant.options.every((option, index) => option === options[index]);
      });
    };

    const getSelectedVariant = () => {
      return getVariantFromOptions(getSelectedOptions());
    };

    const optionCanBeSelected = (position, value) => {
      const selectedOptions = getSelectedOptions();

      return variants.some((variant) => {
        if (!variant.available) return false;

        return variant.options.every((optionValue, index) => {
          if (index === position - 1) return optionValue === value;
          if (!selectedOptions[index]) return true;
          return optionValue === selectedOptions[index];
        });
      });
    };

    const selectVariant = (variant) => {
      if (!variant) return;

      variant.options.forEach((optionValue, index) => {
        const input = optionInputs.find((item) => {
          return Number(item.dataset.optionPosition) === index + 1 && item.value === optionValue;
        });

        if (input && !input.disabled) {
          input.checked = true;
        }
      });
    };

    const updateOptionStates = () => {
      optionInputs.forEach((input) => {
        const position = Number(input.dataset.optionPosition);
        const available = optionCanBeSelected(position, input.value);
        const label = input.closest('.borrego-product__option-value');

        input.disabled = !available;
        input.setAttribute('aria-disabled', String(!available));
        label?.classList.toggle('is-unavailable', !available);

        if (!available && input.checked) {
          input.checked = false;
        }
      });

      let selectedVariant = getSelectedVariant();

      if (!selectedVariant || !selectedVariant.available) {
        const firstAvailableVariant = variants.find((variant) => variant.available);
        selectVariant(firstAvailableVariant);
      }

      optionInputs.forEach((input) => {
        const position = Number(input.dataset.optionPosition);
        const available = optionCanBeSelected(position, input.value);
        const label = input.closest('.borrego-product__option-value');

        input.disabled = !available;
        input.setAttribute('aria-disabled', String(!available));
        label?.classList.toggle('is-unavailable', !available);
      });
    };

    const updateVariantUI = () => {
      updateOptionStates();

      const variant = getSelectedVariant();

      if (!variant || !variant.available) {
        if (availabilityEl) {
          availabilityEl.textContent = 'Selecciona una talla disponible';
        }

        whatsappButton?.classList.add('is-disabled');
        return;
      }

      if (priceEl) {
        priceEl.innerHTML = variant.compare_at_price && variant.compare_at_price > variant.price
          ? `${formatMoney(variant.price)} <span>${formatMoney(variant.compare_at_price)}</span>`
          : formatMoney(variant.price);
      }

      if (availabilityEl) {
        availabilityEl.textContent = 'Disponible para compra personalizada';
      }

      if (whatsappButton) {
        const url = new URL(whatsappButton.href);
        const productUrl = `${window.location.origin}{{ product.url }}`;
        const message = `{{ section.settings.whatsapp_message }} Producto: {{ product.title }}. Talla seleccionada: ${variant.title}. Link: ${productUrl}`;

        url.searchParams.set('text', message);
        whatsappButton.href = url.toString();
        whatsappButton.classList.remove('is-disabled');
      }

      if (variant.featured_media && variant.featured_media.id) {
        const mediaIndex = mediaItems.findIndex((item) => item.dataset.borregoMedia === String(variant.featured_media.id));
        if (mediaIndex >= 0) showMedia(mediaIndex);
      }
    };

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener('click', () => showMedia(index));
    });

    prevButton?.addEventListener('click', () => showMedia(currentIndex - 1));
    nextButton?.addEventListener('click', () => showMedia(currentIndex + 1));

    optionInputs.forEach((input) => {
      input.addEventListener('change', updateVariantUI);
    });

    whatsappButton?.addEventListener('click', (event) => {
      const variant = getSelectedVariant();

      if (!variant || !variant.available) {
        event.preventDefault();
        alert('Selecciona una talla disponible para continuar por WhatsApp.');
      }
    });

    mainGallery?.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0].clientX;
    }, { passive: true });

    mainGallery?.addEventListener('touchend', (event) => {
      const touchEndX = event.changedTouches[0].clientX;
      const diff = touchStartX - touchEndX;

      if (Math.abs(diff) < 45) return;

      if (diff > 0) {
        showMedia(currentIndex + 1);
      } else {
        showMedia(currentIndex - 1);
      }
    }, { passive: true });

    showMedia(currentIndex);
    updateVariantUI();
  })();
</script>

