      }

      .borrego-product .hanan-dev-size-guide-link {
        font-size: 8.5px;
        letter-spacing: 0.14em;
        min-height: 28px;
      }

      .borrego-product .hanan-dev-size-guide-modal {
        padding: 14px;
      }

      .borrego-product .hanan-dev-size-guide-dialog {
