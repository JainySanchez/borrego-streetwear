{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign base_whatsapp_message = section.settings.whatsapp_message | append: ' ' | append: product.title
  assign whatsapp_message = base_whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_message

  assign special_request_phone = section.settings.special_request_whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign special_request_message = section.settings.special_request_whatsapp_message | url_encode
  assign special_request_url = 'https://wa.me/' | append: special_request_phone

  if section.settings.special_request_whatsapp_message != blank
    assign special_request_url = special_request_url | append: '?text=' | append: special_request_message
  endif

  assign size_guide_image = section.settings.size_guide_image

  if product.metafields.custom.size_guide_image != blank
    assign size_guide_image = product.metafields.custom.size_guide_image.value
  endif

  assign has_size_guide = false

  if section.settings.show_size_guide and size_guide_image != blank
    assign has_size_guide = true
  endif

  assign size_guide_rendered = false
%}

<section
  class="borrego-product {% if section.settings.enable_animation %}borrego-product--animated{% endif %}"
  style="
    --bg: {{ section.settings.background_color }};
    --card-bg: {{ section.settings.card_background }};
    --text: {{ section.settings.text_color }};
    --muted: {{ section.settings.muted_text_color }};
    --accent: {{ section.settings.accent_color }};
    --button-bg: {{ section.settings.button_background }};
    --button-text: {{ section.settings.button_text }};
    --button-hover-bg: {{ section.settings.button_hover_background }};
    --button-hover-text: {{ section.settings.button_hover_text }};
    --border: {{ section.settings.border_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --hanan-dev-size-guide-modal-bg: {{ section.settings.size_guide_modal_background }};
    --hanan-dev-size-guide-overlay-opacity: {{ section.settings.size_guide_overlay_opacity | divided_by: 100.0 }};
    --hanan-dev-size-guide-close-color: {{ section.settings.size_guide_close_button_color }};
  "
>
  <script type="application/json" data-borrego-variants>
    {{ product.variants | json }}
  </script>

  <div class="borrego-product__inner">
    <div class="borrego-product__gallery">
      <div class="borrego-product__media-main">
        {% for media in product.media %}
          {% if media.media_type == 'image' %}
            <div
              class="borrego-product__media-item {% if forloop.first %}is-active{% endif %}"
              data-borrego-media="{{ media.id }}"
            >
              {{
                media
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '700, 900, 1200, 1500, 1800',
                  sizes: '(max-width: 749px) 100vw, 58vw',
                  class: 'borrego-product__image'
              }}
            </div>
          {% endif %}
        {% endfor %}

        {% if product.media.size > 1 %}
          <button
            class="borrego-product__gallery-arrow borrego-product__gallery-arrow--prev"
            type="button"
            aria-label="Imagen anterior"
            data-gallery-prev
          >
            ‹
          </button>
          <button
            class="borrego-product__gallery-arrow borrego-product__gallery-arrow--next"
            type="button"
            aria-label="Imagen siguiente"
            data-gallery-next
          >
            ›
          </button>
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div class="borrego-product__thumbs">
          {% for media in product.media %}
            {% if media.media_type == 'image' %}
              <button
                class="borrego-product__thumb {% if forloop.first %}is-active{% endif %}"
                type="button"
                data-borrego-thumb="{{ media.id }}"
              >
                {{
                  media
                  | image_url: width: 280
                  | image_tag:
                    loading: 'lazy',
                    widths: '140, 200, 280',
                    sizes: '108px',
                    class: 'borrego-product__thumb-image'
                }}
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="borrego-product__info">
      {% if section.settings.editorial_label != blank %}
        <p class="borrego-product__editorial-label">
          {{ section.settings.editorial_label }}
        </p>
      {% endif %}

      {% if product.vendor != blank %}
        <p class="borrego-product__vendor">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="borrego-product__title">{{ product.title }}</h1>

      <div class="borrego-product__price" data-borrego-price>
        {{ current_variant.price | money }}
        {% if current_variant.compare_at_price > current_variant.price %}
          <span>{{ current_variant.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <p class="borrego-product__availability" data-borrego-availability>
        {% if current_variant.available %}
          Disponible para compra personalizada
        {% else %}
          Sin disponibilidad inmediata
        {% endif %}
      </p>

      {% unless product.has_only_default_variant %}
        <div class="borrego-product__variants" data-borrego-options>
          {% for option in product.options_with_values %}
            {% liquid
              assign option_name_downcase = option.name | downcase
              assign show_size_guide_here = false

              if has_size_guide and size_guide_rendered == false
                if option_name_downcase contains 'talla' or option_name_downcase contains 'size' or option_name_downcase contains 'calzado' or forloop.first
                  assign show_size_guide_here = true
                  assign size_guide_rendered = true
                endif
              endif
            %}

            <fieldset class="borrego-product__option">
              <legend class="borrego-product__option-legend">
                <span>{{ option.name }}</span>

                {% if show_size_guide_here %}
                  <button
                    type="button"
                    class="hanan-dev-size-guide-link"
                    data-hanan-dev-size-guide-open
                    aria-label="{{ section.settings.size_guide_button_text | escape }}"
                  >
                    {{ section.settings.size_guide_button_text }}
                  </button>
                {% endif %}
              </legend>

              <div class="borrego-product__option-values">
                {% for value in option.values %}
                  <label class="borrego-product__option-value">
                    <input
                      type="radio"
                      name="options[{{ option.name | escape }}]"
                      value="{{ value | escape }}"
                      data-option-position="{{ option.position }}"
                      {% if option.selected_value == value %}
                        checked
                      {% endif %}
                    >
                    <span>{{ value }}</span>
                  </label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        </div>
      {% endunless %}

      {% if section.settings.purchase_microcopy != blank %}
        <div class="borrego-product__purchase-copy">
          {{ section.settings.purchase_microcopy }}
        </div>
      {% endif %}

      {% if section.settings.whatsapp_phone != blank %}
       
        <a
          href="{{ whatsapp_url }}"
          target="_blank"
          rel="noopener"
          class="borrego-product__primary-cta"
          data-borrego-whatsapp
        >
          {{ section.settings.primary_cta_label }} <span class="D" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M12.04 2C6.58 2 2.13 6.42 2.13 11.86c0 1.74.46 3.43 1.34 4.93L2 22l5.35-1.4a9.95 9.95 0 0 0 4.69 1.19h.01c5.46 0 9.91-4.42 9.91-9.86C21.96 6.45 17.51 2 12.04 2Zm.01 18.12h-.01a8.25 8.25 0 0 1-4.2-1.15l-.3-.18-3.18.83.85-3.09-.2-.32a8.13 8.13 0 0 1-1.25-4.35c0-4.51 3.72-8.18 8.3-8.18 2.21 0 4.29.86 5.85 2.4a8.08 8.08 0 0 1 2.43 5.78c0 4.51-3.72 8.26-8.29 8.26Zm4.55-6.18c-.25-.12-1.47-.72-1.7-.8-.23-.08-.4-.12-.56.12-.17.25-.65.8-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.38-2-1.22-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.77-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.08s.89 2.41 1.02 2.58c.12.17 1.76 2.68 4.27 3.76.6.26 1.06.41 1.42.52.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"></path>
                </svg>
              </span>
        </a>
        
      {% endif %}

      {% if section.settings.show_special_request_cta and section.settings.special_request_cta_text != blank and special_request_phone != blank %}
        <a
          href="{{ special_request_url }}"
          target="_blank"
          rel="noopener"
          class="hanan-dev-special-size-cta"
          data-hanan-dev-product-whatsapp-request
        >
          {{ section.settings.special_request_cta_text }}
        </a>
      {% endif %}

      {% if section.settings.show_showroom_availability %}
        <p class="borrego-product__showroom-note">
          {{ section.settings.showroom_availability_text }}
        </p>
      {% endif %}

      <div class="borrego-product__benefits">
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="borrego-product__benefit" {{ block.shopify_attributes }}>
              <span class="borrego-product__benefit-icon">
                {% case block.settings.icon %}
                  {% when 'authentic' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 3L19 6V11.5C19 16.2 16.2 19.4 12 21C7.8 19.4 5 16.2 5 11.5V6L12 3Z"/><path d="M8.8 12.2L11 14.4L15.4 9.8"/>
                    </svg>
                  {% when 'shipping' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M3.5 7.5H14.5V16.5H3.5V7.5Z"/><path d="M14.5 10H18.5L21 13V16.5H14.5V10Z"/><path d="M7 19C8.1 19 9 18.1 9 17C9 15.9 8.1 15 7 15C5.9 15 5 15.9 5 17C5 18.1 5.9 19 7 19Z"/><path d="M18 19C19.1 19 20 18.1 20 17C20 15.9 19.1 15 18 15C16.9 15 16 15.9 16 17C16 18.1 16.9 19 18 19Z"/>
                    </svg>
                  {% when 'payment' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M4 7H20V17H4V7Z"/><path d="M4 10H20"/><path d="M7 14H10"/>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 4C8.1 4 5 7.1 5 11V15.5C5 17.4 6.6 19 8.5 19H10"/><path d="M19 15.5V11C19 7.1 15.9 4 12 4"/><path d="M7 13H9.5V18H7V13Z"/><path d="M14.5 13H17V18H14.5V13Z"/>
                    </svg>
                {% endcase %}
              </span>
              <span>{{ block.settings.title }}</span>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="borrego-product__description">
        {% if section.settings.story_text != blank %}
          <div class="borrego-product__story">{{ section.settings.story_text }}</div>
        {% endif %}

        {% if product.description != blank %}
          <div class="borrego-product__rte">{{ product.description }}</div>
        {% endif %}
      </div>

      <div class="borrego-product__accordions">
        {% for block in section.blocks %}
          {% if block.type == 'accordion' %}
            <details class="borrego-product__accordion" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.title }}
                <span></span>
              </summary>
              <div>{{ block.settings.content }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.show_showroom %}
        <div class="borrego-product__showroom">
          <p>{{ section.settings.showroom_label }}</p>
          <h3>{{ section.settings.showroom_heading }}</h3>
          <div>{{ section.settings.showroom_text }}</div>
        </div>
      {% endif %}
    </div>
  </div>

  {% if has_size_guide %}
    <div
      class="hanan-dev-size-guide-modal"
      data-hanan-dev-size-guide-modal
      aria-hidden="true"
    >
      <div class="hanan-dev-size-guide-overlay" data-hanan-dev-size-guide-close></div>

      <div
        class="hanan-dev-size-guide-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="hanan-dev-size-guide-title-{{ section.id }}"
        tabindex="-1"
      >
        <button
          type="button"
          class="hanan-dev-size-guide-close"
          data-hanan-dev-size-guide-close
          aria-label="Cerrar guía de tallas"
        >
          ×
        </button>

        {% if section.settings.size_guide_modal_title != blank %}
          <h2 id="hanan-dev-size-guide-title-{{ section.id }}" class="hanan-dev-size-guide-title">
            {{ section.settings.size_guide_modal_title }}
          </h2>
        {% else %}
          <h2 id="hanan-dev-size-guide-title-{{ section.id }}" class="hanan-dev-size-guide-title visually-hidden">
            Guía de tallas
          </h2>
        {% endif %}

        <div class="hanan-dev-size-guide-content">
          <img
            src="{{ size_guide_image | image_url: width: 1200 }}"
            srcset="
              {{ size_guide_image | image_url: width: 500 }} 500w,
              {{ size_guide_image | image_url: width: 800 }} 800w,
              {{ size_guide_image | image_url: width: 1200 }} 1200w,
              {{ size_guide_image | image_url: width: 1600 }} 1600w
            "
            sizes="(max-width: 749px) calc(100vw - 40px), min(900px, 88vw)"
            alt="{{ section.settings.size_guide_image_alt | default: section.settings.size_guide_button_text | escape }}"
            width="{{ size_guide_image.width }}"
            height="{{ size_guide_image.height }}"
            loading="lazy"
            class="hanan-dev-size-guide-image"
          >
        </div>
      </div>
    </div>
  {% endif %}

  {% if section.settings.show_related and section.settings.related_collection != blank %}
    <div class="borrego-related">
      <h2>{{ section.settings.related_heading }}</h2>

      <div class="borrego-related__slider">
        {% for related_product in section.settings.related_collection.products limit: section.settings.related_limit %}
          {% unless related_product.id == product.id %}
            <a href="{{ related_product.url }}" class="borrego-related__card">
              <div class="borrego-related__media">
                {% if related_product.featured_image %}
                  {{
                    related_product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '400, 600, 800, 900',
                      sizes: '(max-width: 749px) 75vw, 25vw',
                      class: 'borrego-related__image'
                  }}
                {% endif %}
              </div>

              <div class="borrego-related__content">
                <h3>{{ related_product.title }}</h3>
                <span>{{ related_product.price | money }}</span>
              </div>
            </a>
          {% endunless %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
    .borrego-product {
      background: var(--bg);
      color: var(--text);
      padding-top: var(--padding-top);
      padding-bottom: var(--padding-bottom);
      overflow: hidden;
    }

    .borrego-product__inner {
      display: grid;
      grid-template-columns: minmax(0, 58%) minmax(360px, 42%);
      gap: clamp(38px, 5vw, 88px);
      padding: 0 5vw;
      align-items: start;
    }

    .borrego-product__gallery {
      display: grid;
      gap: 12px;
    }

    .borrego-product__media-main {
      position: relative;
      background:
        radial-gradient(circle at 50% 30%, rgba(255,255,255,0.72), transparent 34%),
        linear-gradient(145deg, var(--card-bg), #ffffff);
      overflow: hidden;
      min-height: 620px;
      box-shadow: 0 24px 60px rgba(17, 17, 12, 0.055);
    }

    .borrego-product__media-item {
      display: block;
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateX(10px) scale(1.01);
      transition:
        opacity 620ms cubic-bezier(0.16, 1, 0.3, 1),
        visibility 620ms ease,
        transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .borrego-product__media-item.is-active {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
    }

    .borrego-product__image {
      width: 100%;
      height: 100%;
      min-height: 620px;
      object-fit: contain;
      padding: 4.8%;
      transform: scale(1.04);
      transition: transform 1250ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .borrego-product__media-main:hover .borrego-product__media-item.is-active .borrego-product__image {
      transform: scale(1.075) translateY(-3px);
    }

    .borrego-product__gallery-arrow {
      position: absolute;
      top: 50%;
      z-index: 3;
      width: 38px;
      height: 38px;
      border: 1px solid rgba(17,17,12,0.16);
      border-radius: 999px;
      background: rgba(247, 247, 245, 0.82);
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
      transform: translateY(-50%);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition:
        background 420ms cubic-bezier(0.16, 1, 0.3, 1),
        color 420ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .borrego-product__gallery-arrow--prev {
      left: 28px;
    }

    .borrego-product__gallery-arrow--next {
      right: 28px;
    }

    .borrego-product__gallery-arrow:hover {
      background: var(--text);
      color: var(--bg);
      border-color: var(--text);
      transform: translateY(-50%) scale(1.04);
    }

    .borrego-product__thumbs {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 2px;
    }

    .borrego-product__thumbs::-webkit-scrollbar {
      display: none;
    }

    .borrego-product__thumb {
      width: 104px;
      height: 116px;
      flex: 0 0 104px;
      padding: 8px;
      border: 1px solid rgba(17,17,12,0.08);
      background:
        linear-gradient(145deg, var(--card-bg), #ffffff);
      cursor: pointer;
      opacity: 0.62;
      transition:
        opacity 420ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 420ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .borrego-product__thumb.is-active {
      opacity: 1;
      border-color: var(--accent);
      box-shadow: inset 0 0 0 1px var(--accent);
    }

    .borrego-product__thumb:hover {
      opacity: 1;
      transform: translateY(-2px);
      border-color: rgba(17,17,12,0.24);
    }

    .borrego-product__thumb-image {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .borrego-product__info {
      position: sticky;
      top: 108px;
    }

    .borrego-product__editorial-label,
    .borrego-product__vendor {
      margin: 0 0 11px;
      color: var(--accent);
      font-size: 8.5px;
      font-weight: 850;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }

    .borrego-product__vendor {
      color: var(--muted);
      margin-bottom: 14px;
    }

    .borrego-product__title {
      margin: 0;
      color: var(--text);
      line-height: 0.98;
      font-weight: 900;
      letter-spacing: 0.052em;
      text-transform: uppercase;
      font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
      font-size: 31px;
      line-height: 1;
    }

    .borrego-product__price {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-top: 24px;
      color: var(--text);
      font-size: 17px;
      letter-spacing: 0.075em;
    }

    .borrego-product__price span {
      color: var(--muted);
      text-decoration: line-through;
      font-size: 14px;
    }

    .borrego-product__availability {
      margin: 14px 0 28px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .borrego-product__variants {
      display: grid;
      gap: 22px;
      margin-bottom: 22px;
    }

    .borrego-product__option {
      margin: 0;
      padding: 0;
      border: 0;
    }

    .borrego-product__option-legend {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 13px;
      color: var(--text);
      font-size: 9px;
      font-weight: 850;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }

    .borrego-product__option-legend span {
      min-width: 0;
    }

    .borrego-product .hanan-dev-size-guide-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--accent);
      font-size: 9px;
      line-height: 1.2;
      font-weight: 850;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
      white-space: nowrap;
      transition: color 280ms ease, opacity 280ms ease;
    }

    .borrego-product .hanan-dev-size-guide-link:hover {
      color: var(--text);
    }

    .borrego-product .hanan-dev-size-guide-link:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
    }

    .borrego-product__option-values {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
    }

    .borrego-product__option-value input {
      position: absolute;
      opacity: 0;
    }

    .borrego-product__option-value span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 46px;
      height: 38px;
      padding: 0 14px;
      border: 1px solid var(--border);
      color: var(--text);
      background: rgba(255,255,255,0.18);
      font-size: 10px;
      font-weight: 780;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      cursor: pointer;
      transition:
        background 420ms cubic-bezier(0.16, 1, 0.3, 1),
        color 420ms cubic-bezier(0.16, 1, 0.3, 1),
        border-color 420ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
