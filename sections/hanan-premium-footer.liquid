<section
  class="hanan-footer {% if section.settings.mobile_accordion %}hanan-footer--accordion{% endif %} {% if section.settings.enable_animation %}hanan-footer--animated{% endif %}"
  style="
    --footer-bg: {{ section.settings.background_color }};
    --primary-color: {{ section.settings.primary_text_color }};
    --secondary-color: {{ section.settings.secondary_text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --divider-color: {{ section.settings.divider_color }};
    --hover-color: {{ section.settings.hover_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --heading-size: {{ section.settings.heading_size }}px;
  "
>
  <div class="hanan-footer__inner">
    {% if section.settings.enable_large_heading and section.settings.brand_statement != blank %}
      <div class="hanan-footer__statement">
        {{ section.settings.brand_statement }}
      </div>
    {% endif %}

    <div class="hanan-footer__brand-row">
      <div class="hanan-footer__brand">
        {% if section.settings.logo_image != blank %}
          {{
            section.settings.logo_image
            | image_url: width: 520
            | image_tag:
              loading: 'lazy',
              widths: '180, 260, 360, 520',
              sizes: '(max-width: 749px) 180px, 260px',
              class: 'hanan-footer__logo'
          }}
        {% else %}

        {% endif %}

        {% if section.settings.brand_description != blank %}
          <div class="hanan-footer__brand-description">
            {{ section.settings.brand_description }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="hanan-footer__main">
      <div class="hanan-footer__columns">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'menu_column' %}
              <div class="hanan-footer__column" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <button class="hanan-footer__column-title" type="button">
                    {{ block.settings.title }}
                    <span>+</span>
                  </button>
                {% endif %}

                <div class="hanan-footer__column-content">
                  {% if block.settings.menu != blank %}
                    {% for link in block.settings.menu.links %}
                      <a href="{{ link.url }}" class="hanan-footer__link">
                        {{ link.title }}
                      </a>
                    {% endfor %}
                  {% endif %}
                </div>
              </div>

            {% when 'custom_link' %}
              <div class="hanan-footer__column" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <button class="hanan-footer__column-title" type="button">
                    {{ block.settings.title }}
                    <span>+</span>
                  </button>
                {% endif %}

                <div class="hanan-footer__column-content">
                  {% if block.settings.link_label_1 != blank %}
                    <a href="{{ block.settings.link_url_1 }}" {% if block.settings.open_new_tab_1 %}target="_blank" rel="noopener"{% endif %} class="hanan-footer__link">{{ block.settings.link_label_1 }}</a>
                  {% endif %}
                  {% if block.settings.link_label_2 != blank %}
                    <a href="{{ block.settings.link_url_2 }}" {% if block.settings.open_new_tab_2 %}target="_blank" rel="noopener"{% endif %} class="hanan-footer__link">{{ block.settings.link_label_2 }}</a>
                  {% endif %}
                  {% if block.settings.link_label_3 != blank %}
                    <a href="{{ block.settings.link_url_3 }}" {% if block.settings.open_new_tab_3 %}target="_blank" rel="noopener"{% endif %} class="hanan-footer__link">{{ block.settings.link_label_3 }}</a>
                  {% endif %}
                  {% if block.settings.link_label_4 != blank %}
                    <a href="{{ block.settings.link_url_4 }}" {% if block.settings.open_new_tab_4 %}target="_blank" rel="noopener"{% endif %} class="hanan-footer__link">{{ block.settings.link_label_4 }}</a>
                  {% endif %}
                </div>
              </div>

            {% when 'social_link' %}
              <div class="hanan-footer__column" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <button class="hanan-footer__column-title" type="button">
                    {{ block.settings.title }}
                    <span>+</span>
                  </button>
                {% endif %}

                <div class="hanan-footer__column-content">
                  {% if block.settings.social_label_1 != blank %}
                    <a href="{{ block.settings.social_url_1 }}" target="_blank" rel="noopener" class="hanan-footer__link">{{ block.settings.social_label_1 }}</a>
                  {% endif %}
                  {% if block.settings.social_label_2 != blank %}
                    <a href="{{ block.settings.social_url_2 }}" target="_blank" rel="noopener" class="hanan-footer__link">{{ block.settings.social_label_2 }}</a>
                  {% endif %}
                  {% if block.settings.social_label_3 != blank %}
                    <a href="{{ block.settings.social_url_3 }}" target="_blank" rel="noopener" class="hanan-footer__link">{{ block.settings.social_label_3 }}</a>
                  {% endif %}
                </div>
              </div>

            {% when 'showroom_info' %}
              <div class="hanan-footer__column hanan-footer__column--showroom" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <button class="hanan-footer__column-title" type="button">
                    {{ block.settings.title }}
                    <span>+</span>
                  </button>
                {% endif %}

                <div class="hanan-footer__column-content">
                  {% if block.settings.label != blank %}
                    <p class="hanan-footer__showroom-label">{{ block.settings.label }}</p>
                  {% endif %}
                  {% if block.settings.address != blank %}
                    <p class="hanan-footer__text">{{ block.settings.address }}</p>
                  {% endif %}
                  {% if block.settings.schedule != blank %}
                    <p class="hanan-footer__text">{{ block.settings.schedule }}</p>
                  {% endif %}
                  {% if block.settings.detail != blank %}
                    <p class="hanan-footer__detail">{{ block.settings.detail }}</p>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <div class="hanan-footer__bottom">
      <div class="hanan-footer__bottom-left">
        {% if section.settings.copyright_text != blank %}
          <p>{{ section.settings.copyright_text }}</p>
        {% endif %}
        {% if section.settings.payment_text != blank %}
          <p>{{ section.settings.payment_text }}</p>
        {% endif %}
      </div>

      <div class="hanan-footer__bottom-right">
        <p>DEVELOPED BY HANAN</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hanan-footer {
    position: relative;
    width: 100%;
    background:
      radial-gradient(circle at 12% 0%, rgba(217, 178, 111, 0.16), transparent 30%),
      radial-gradient(circle at 88% 92%, rgba(17, 17, 12, 0.06), transparent 32%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.22), transparent 42%),
      var(--footer-bg);
    color: var(--primary-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hanan-footer::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.16;
    background-image:
      linear-gradient(rgba(17, 17, 12, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 17, 12, 0.04) 1px, transparent 1px);
    background-size: 84px 84px;
    mask-image: radial-gradient(circle at center, black, transparent 78%);
  }

  .hanan-footer__inner {
    position: relative;
    z-index: 2;
    padding: 0 5vw;
  }

  .hanan-footer__statement {
    max-width: 980px;
    margin: 0 0 54px;
    color: var(--primary-color);
    font-size: clamp(34px, 5vw, var(--heading-size));
    line-height: 0.95;
    font-weight: 850;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-footer__brand-row {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--divider-color);
  }

  .hanan-footer__brand {
    max-width: 560px;
  }

  .hanan-footer__logo {
    width: min(260px, 70vw);
    height: auto;
    display: block;
    object-fit: contain;
    object-position: left center;
    margin-bottom: 24px;
    filter: grayscale(1);
  }

  .hanan-footer__brand-name {
    margin: 0 0 20px;
    color: var(--primary-color);
    font-size: clamp(24px, 3vw, 42px);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-footer__brand-description {
    max-width: 430px;
    color: var(--secondary-color);
    font-size: 13px;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .hanan-footer__brand-description p {
    margin: 0;
  }

  .hanan-footer__main {
    padding-top: 42px;
  }

  .hanan-footer__columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 5vw, 86px);
  }

  .hanan-footer__column-title {
    width: 100%;
    margin: 0 0 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--accent-color);
    font-size: 10px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-align: left;
    font-family: inherit;
  }

  .hanan-footer__column-title span {
    display: none;
  }

  .hanan-footer__column-content {
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .hanan-footer__link {
    position: relative;
    width: fit-content;
    color: var(--secondary-color);
    text-decoration: none;
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    transition:
      color 520ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 520ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-footer__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -5px;
    width: 100%;
    height: 1px;
    background: var(--hover-color);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-footer__link:hover {
    color: var(--hover-color);
    transform: translateX(3px);
  }

  .hanan-footer__link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hanan-footer__showroom-label {
    margin: 0;
    color: var(--primary-color);
    font-size: 12px;
    line-height: 1.5;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hanan-footer__text {
    margin: 0;
    color: var(--secondary-color);
    font-size: 12px;
    line-height: 1.65;
    letter-spacing: 0.045em;
  }

  .hanan-footer__detail {
    width: fit-content;
    margin: 6px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--divider-color);
    color: var(--accent-color);
    font-size: 10px;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hanan-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid var(--divider-color);
  }

  .hanan-footer__bottom-left,
  .hanan-footer__bottom-right {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  .hanan-footer__bottom p {
    margin: 0;
    color: var(--secondary-color);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hanan-footer--animated .hanan-footer__statement,
  .hanan-footer--animated .hanan-footer__brand-row,
  .hanan-footer--animated .hanan-footer__main,
  .hanan-footer--animated .hanan-footer__bottom {
    opacity: 0;
    transform: translateY(22px);
    animation: hananFooterReveal 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hanan-footer--animated .hanan-footer__brand-row {
    animation-delay: 80ms;
  }

  .hanan-footer--animated .hanan-footer__main {
    animation-delay: 160ms;
  }

  .hanan-footer--animated .hanan-footer__bottom {
    animation-delay: 240ms;
  }

  @keyframes hananFooterReveal {
    from {
      opacity: 0;
      transform: translateY(22px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 42px 34px;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-footer {
      padding-top: calc(var(--padding-top) * 0.72);
      padding-bottom: calc(var(--padding-bottom) * 0.72);
    }

    .hanan-footer__inner {
      padding: 0 18px;
    }

    .hanan-footer__statement {
      margin-bottom: 38px;
      font-size: clamp(20px, 12vw, 28px);
      line-height: 0.95;
    }

    .hanan-footer__brand-row {
      padding-bottom: 34px;
    }

    .hanan-footer__logo {
      width: min(210px, 72vw);
      margin-bottom: 20px;
    }

    .hanan-footer__brand-name {
      font-size: 30px;
    }

    .hanan-footer__main {
      padding-top: 28px;
    }

    .hanan-footer__columns {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hanan-footer--accordion .hanan-footer__column {
      border-bottom: 1px solid var(--divider-color);
      padding: 18px 0;
    }

    .hanan-footer--accordion .hanan-footer__column-title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 0;
    }

    .hanan-footer--accordion .hanan-footer__column-title span {
      display: block;
    }

    .hanan-footer--accordion .hanan-footer__column-content {
      display: none;
      padding-top: 20px;
    }

    .hanan-footer--accordion .hanan-footer__column.is-open .hanan-footer__column-content {
      display: flex;
    }

    .hanan-footer:not(.hanan-footer--accordion) .hanan-footer__column {
      margin-bottom: 32px;
    }

    .hanan-footer__bottom {
      flex-direction: column;
      margin-top: 42px;
    }

    .hanan-footer__bottom-left,
    .hanan-footer__bottom-right {
      flex-direction: column;
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-footer__statement,
    .hanan-footer__brand-row,
    .hanan-footer__main,
    .hanan-footer__bottom,
    .hanan-footer__link,
    .hanan-footer__link::after {
      animation: none;
      transition: none;
    }

    .hanan-footer--animated .hanan-footer__statement,
    .hanan-footer--animated .hanan-footer__brand-row,
    .hanan-footer--animated .hanan-footer__main,
    .hanan-footer--animated .hanan-footer__bottom {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const footer = document.currentScript.closest('.hanan-footer');
    if (!footer) return;

    const columns = footer.querySelectorAll('.hanan-footer__column-title');

    columns.forEach((button) => {
      button.addEventListener('click', () => {
        if (!footer.classList.contains('hanan-footer--accordion')) return;

        const column = button.closest('.hanan-footer__column');
        if (!column) return;

        column.classList.toggle('is-open');
      });
    });
  })();
</script>

