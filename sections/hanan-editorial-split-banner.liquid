<section
  class="hanan-split-banner {% if section.settings.reverse_layout %}hanan-split-banner--reverse{% endif %}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hanan-split-banner__inner">
    <a href="{{ section.settings.button_link }}" class="hanan-split-banner__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1900
          | image_tag:
            loading: 'lazy',
            widths: '700, 900, 1200, 1500, 1900',
            sizes: '(max-width: 749px) 100vw, 68vw',
            class: 'hanan-split-banner__image'
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hanan-split-banner__placeholder' }}
      {% endif %}

      <div class="hanan-split-banner__overlay"></div>
    </a>

    <div class="hanan-split-banner__content">
      <div class="hanan-split-banner__eyebrow">
        HANAN EDITORIAL
      </div>

      {% if section.settings.heading != blank %}
        <h2 class="hanan-split-banner__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hanan-split-banner__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="hanan-split-banner__button">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hanan-split-banner {
    width: 100%;
    background: var(--section-bg);
    color: var(--text-color);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hanan-split-banner__inner {
    display: grid;
    grid-template-columns: 68% 32%;
    min-height: 68vh;
    max-height: 720px;
    padding: 0 4vw;
  }

  .hanan-split-banner--reverse .hanan-split-banner__inner {
    grid-template-columns: 32% 68%;
  }

  .hanan-split-banner--reverse .hanan-split-banner__media {
    order: 2;
  }

  .hanan-split-banner--reverse .hanan-split-banner__content {
    order: 1;
  }

  .hanan-split-banner__media {
    position: relative;
    display: block;
    overflow: hidden;
    background: #1a1914;
    opacity: 0;
    transform: translateY(22px) scale(0.99);
    animation: hananSplitReveal 1000ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hanan-split-banner__image,
  .hanan-split-banner__placeholder {
    width: 100%;
    height: 100%;
    min-height: 68vh;
    max-height: 720px;
    display: block;
    object-fit: cover;
    object-position: center 42%;
    transform: scale(1.04);
    filter: contrast(1.05) saturate(0.92) brightness(0.86);
    transition:
      transform 1400ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 1400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-split-banner__placeholder {
    background: #1a1914;
  }

  .hanan-split-banner__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(17, 17, 12, 0.12) 0%,
        rgba(17, 17, 12, 0.24) 52%,
        rgba(17, 17, 12, 0.72) 100%
      ),
      radial-gradient(
        circle at 50% 18%,
        rgba(242, 236, 221, 0.08) 0%,
        rgba(17, 17, 12, 0.08) 36%,
        rgba(17, 17, 12, 0.48) 100%
      ),
      rgba(17, 17, 12, var(--overlay-opacity));
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-split-banner__media:hover .hanan-split-banner__image {
    transform: scale(1.08);
    filter: contrast(1.08) saturate(0.95) brightness(0.78);
  }

  .hanan-split-banner__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 48px 4vw 48px 5vw;
    opacity: 0;
    transform: translateY(20px);
    animation: hananSplitReveal 1000ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 140ms;
  }

  .hanan-split-banner__eyebrow {
    margin-bottom: 16px;
    color: var(--accent-color);
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .hanan-split-banner__heading {
    max-width: 460px;
    margin: 0;
    color: var(--text-color);
    font-size: clamp(32px, 4vw, 66px);
    line-height: 0.88;
    font-weight: 900;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-split-banner__text {
    max-width: 390px;
    margin-top: 20px;
    color: rgba(242, 236, 221, 0.72);
    font-size: 14px;
    line-height: 1.65;
    letter-spacing: 0.035em;
  }

  .hanan-split-banner__text p {
    margin: 0;
  }

  .hanan-split-banner__button {
    position: relative;
    width: fit-content;
    display: inline-flex;
    margin-top: 26px;
    padding-bottom: 7px;
    color: var(--text-color);
    text-decoration: none;
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .hanan-split-banner__button::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 18px);
    height: 1px;
    background: var(--accent-color);
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-split-banner__button:hover::after {
    transform: scaleX(0.6);
  }

  @keyframes hananSplitReveal {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.99);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-split-banner__inner,
    .hanan-split-banner--reverse .hanan-split-banner__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      max-height: none;
      padding: 0 22px;
    }

    .hanan-split-banner--reverse .hanan-split-banner__media {
      order: 1;
    }

    .hanan-split-banner--reverse .hanan-split-banner__content {
      order: 2;
    }

    .hanan-split-banner__image,
    .hanan-split-banner__placeholder {
      min-height: 460px;
      max-height: 460px;
      object-position: center center;
    }

    .hanan-split-banner__content {
      padding: 40px 4px 0;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-split-banner {
      padding-top: calc(var(--padding-top) * 0.72);
      padding-bottom: calc(var(--padding-bottom) * 0.72);
    }

    .hanan-split-banner__inner {
      padding: 0 16px;
    }

    .hanan-split-banner__image,
    .hanan-split-banner__placeholder {
      min-height: 360px;
      max-height: 360px;
    }

    .hanan-split-banner__content {
      padding: 34px 2px 0;
    }

    .hanan-split-banner__eyebrow {
      margin-bottom: 14px;
      font-size: 8.5px;
      letter-spacing: 0.23em;
    }

    .hanan-split-banner__heading {
      font-size: 34px;
      line-height: 0.9;
      letter-spacing: 0.065em;
    }

    .hanan-split-banner__text {
      margin-top: 18px;
      font-size: 13.5px;
      line-height: 1.62;
    }

    .hanan-split-banner__button {
      margin-top: 24px;
      font-size: 8.5px;
      letter-spacing: 0.22em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-split-banner__media,
    .hanan-split-banner__content,
    .hanan-split-banner__image,
    .hanan-split-banner__placeholder,
    .hanan-split-banner__overlay,
    .hanan-split-banner__button::after {
      animation: none;
      transition: none;
    }

    .hanan-split-banner__media,
    .hanan-split-banner__content {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Split Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen editorial"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Invertir layout",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "CURATED FOR THE CULTURE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>A premium selection of sneakers, apparel, and essentials from the world’s most influential streetwear brands.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "EXPLORE COLLECTION →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link del botón"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#F5F1E8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color acento",
      "default": "#D9B26F"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "HANAN Split Banner"
    }
  ]
}
{% endschema %}