{%- liquid
  assign section_id = 'hanan-dev-how-it-works-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="hanan-dev-how-it-works"
  style="
    --hanan-dev-hiw-bg: {{ section.settings.background_color }};
    --hanan-dev-hiw-text: {{ section.settings.text_color }};
    --hanan-dev-hiw-accent: {{ section.settings.accent_color }};
    --hanan-dev-hiw-max-width: {{ section.settings.section_max_width }}px;
    --hanan-dev-hiw-padding-desktop: {{ section.settings.padding_desktop }}px;
    --hanan-dev-hiw-padding-mobile: {{ section.settings.padding_mobile }}px;
  "
  aria-labelledby="{{ section_id }}-heading"
>
  <div class="hanan-dev-how-it-works__inner">
    <div class="hanan-dev-how-it-works__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hanan-dev-how-it-works__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="{{ section_id }}-heading" class="hanan-dev-how-it-works__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="hanan-dev-how-it-works__description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hanan-dev-how-it-works__grid">
        {%- for block in section.blocks -%}
          <article class="hanan-dev-process-card" {{ block.shopify_attributes }}>
            <div class="hanan-dev-process-card__top">
              {%- if block.settings.step_number != blank -%}
                <span class="hanan-dev-process-card__number">
                  {{ block.settings.step_number }}
                </span>
              {%- endif -%}

              {%- if block.settings.icon != blank -%}
                <span class="hanan-dev-process-card__icon" aria-hidden="true">
                  {{ block.settings.icon }}
                </span>
              {%- endif -%}
            </div>

            <div class="hanan-dev-process-card__content">
              {%- if block.settings.step_title != blank -%}
                <h3 class="hanan-dev-process-card__title">
                  {{ block.settings.step_title }}
                </h3>
              {%- endif -%}

              {%- if block.settings.step_description != blank -%}
                <div class="hanan-dev-process-card__description">
                  {{ block.settings.step_description }}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_button and section.settings.button_text != blank -%}
      <div class="hanan-dev-how-it-works__actions">
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="hanan-dev-how-it-works__button"
          aria-label="{{ section.settings.button_text | escape }}"
          {% if section.settings.open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {{ section.settings.button_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--hanan-dev-hiw-bg);
    color: var(--hanan-dev-hiw-text);
    padding-top: var(--hanan-dev-hiw-padding-desktop);
    padding-bottom: var(--hanan-dev-hiw-padding-desktop);
    overflow: hidden;
  }

  #{{ section_id }} .hanan-dev-how-it-works__inner {
    width: min(100% - 40px, var(--hanan-dev-hiw-max-width));
    margin: 0 auto;
  }

  #{{ section_id }} .hanan-dev-how-it-works__header {
    max-width: 780px;
    margin: 0 0 clamp(34px, 5vw, 64px);
  }

  #{{ section_id }} .hanan-dev-how-it-works__eyebrow {
    margin: 0 0 18px;
    color: var(--hanan-dev-hiw-accent);
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 800;
  }

  #{{ section_id }} .hanan-dev-how-it-works__heading {
    margin: 0;
    max-width: 760px;
    color: currentColor;
    font-size: clamp(42px, 6.2vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-how-it-works__description {
    margin-top: clamp(22px, 2.6vw, 34px);
    max-width: 560px;
    color: currentColor;
    opacity: 0.76;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.7;
  }

  #{{ section_id }} .hanan-dev-how-it-works__description p {
    margin: 0;
  }

  #{{ section_id }} .hanan-dev-how-it-works__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 22px);
  }

  #{{ section_id }} .hanan-dev-process-card {
    position: relative;
    display: flex;
    min-height: 330px;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 2.8vw, 32px);
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 28px;
    background: color-mix(in srgb, var(--hanan-dev-hiw-bg) 88%, var(--hanan-dev-hiw-text) 12%);
    color: currentColor;
    overflow: hidden;
    isolation: isolate;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  #{{ section_id }} .hanan-dev-process-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--hanan-dev-hiw-accent) 26%, transparent), transparent 34%),
      linear-gradient(135deg, color-mix(in srgb, currentColor 5%, transparent), transparent 42%);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  #{{ section_id }} .hanan-dev-process-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--hanan-dev-hiw-accent) 74%, transparent);
    box-shadow: 0 26px 54px rgba(17, 17, 12, 0.12);
  }

  #{{ section_id }} .hanan-dev-process-card:hover::before {
    opacity: 1;
  }

  #{{ section_id }} .hanan-dev-process-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
  }

  #{{ section_id }} .hanan-dev-process-card__number {
    display: block;
    color: var(--hanan-dev-hiw-accent);
    font-size: clamp(48px, 5.2vw, 82px);
    line-height: 0.82;
    letter-spacing: -0.08em;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-process-card__icon {
    display: inline-flex;
    min-width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    border-radius: 999px;
    color: currentColor;
    font-size: 17px;
    line-height: 1;
    opacity: 0.9;
  }

  #{{ section_id }} .hanan-dev-process-card__content {
    margin-top: clamp(54px, 6vw, 86px);
  }

  #{{ section_id }} .hanan-dev-process-card__title {
    margin: 0;
    color: currentColor;
    font-size: clamp(22px, 2.2vw, 34px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-process-card__description {
    margin-top: 18px;
    color: currentColor;
    opacity: 0.72;
    font-size: 14px;
    line-height: 1.62;
  }

  #{{ section_id }} .hanan-dev-process-card__description p {
    margin: 0;
  }

  #{{ section_id }} .hanan-dev-how-it-works__actions {
    display: flex;
    justify-content: center;
    margin-top: clamp(36px, 5vw, 64px);
  }

  #{{ section_id }} .hanan-dev-how-it-works__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 16px 28px;
    border-radius: 999px;
    background: var(--hanan-dev-hiw-accent);
    border: 1px solid var(--hanan-dev-hiw-accent);
    color: #f2ecdd;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 900;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  #{{ section_id }} .hanan-dev-how-it-works__button:hover {
    transform: translateY(-2px);
    background: currentColor;
    border-color: currentColor;
    color: var(--hanan-dev-hiw-bg);
  }

  #{{ section_id }} .hanan-dev-how-it-works__button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .hanan-dev-how-it-works__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .hanan-dev-process-card {
      min-height: 300px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: var(--hanan-dev-hiw-padding-mobile);
      padding-bottom: var(--hanan-dev-hiw-padding-mobile);
    }

    #{{ section_id }} .hanan-dev-how-it-works__inner {
      width: min(100% - 32px, 100%);
    }

    #{{ section_id }} .hanan-dev-how-it-works__header {
      margin-bottom: 30px;
    }

    #{{ section_id }} .hanan-dev-how-it-works__eyebrow {
      margin-bottom: 16px;
    }

    #{{ section_id }} .hanan-dev-how-it-works__heading {
      font-size: clamp(38px, 13vw, 58px);
      line-height: 0.94;
      letter-spacing: -0.052em;
    }

    #{{ section_id }} .hanan-dev-how-it-works__description {
      margin-top: 22px;
      max-width: 100%;
      font-size: 15px;
      line-height: 1.65;
    }

    #{{ section_id }} .hanan-dev-how-it-works__grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #{{ section_id }} .hanan-dev-process-card {
      min-height: 260px;
      padding: 24px;
      border-radius: 24px;
    }

    #{{ section_id }} .hanan-dev-process-card__number {
      font-size: clamp(48px, 16vw, 70px);
    }

    #{{ section_id }} .hanan-dev-process-card__content {
      margin-top: 48px;
    }

    #{{ section_id }} .hanan-dev-process-card__title {
      font-size: clamp(24px, 8vw, 34px);
    }

    #{{ section_id }} .hanan-dev-process-card__description {
      font-size: 14px;
      line-height: 1.62;
    }

    #{{ section_id }} .hanan-dev-how-it-works__actions {
      margin-top: 32px;
    }

    #{{ section_id }} .hanan-dev-how-it-works__button {
      width: 100%;
      min-height: 54px;
    }
  }
</style>

{% schema %}
{
  "name": "Hanan Dev How It Works",
  "tag": "section",
  "class": "section-hanan-dev-how-it-works",
  "settings": [
    {
      "type": "header",
      "content": "Contenido superior"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "BORREGO EXPERIENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "¿CÓMO COMPRAR?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Un proceso simple para conseguir sneakers, apparel y piezas exclusivas.</p>"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Solicitar información"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8733D"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Section max width",
      "min": 960,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Desktop padding",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "step_title",
          "label": "Step title",
          "default": "Elige tu pieza"
        },
        {
          "type": "richtext",
          "id": "step_description",
          "label": "Step description",
          "default": "<p>Explora nuestra selección de sneakers, apparel y productos exclusivos.</p>"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Optional icon",
          "info": "Puedes colocar un símbolo corto como ↗, ✦, + o dejarlo vacío.",
          "default": "✦"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hanan Dev How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "step_title": "Elige tu pieza",
            "step_description": "<p>Explora nuestra selección de sneakers, apparel y productos exclusivos.</p>",
            "icon": "✦"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "step_title": "Escríbenos",
            "step_description": "<p>Contáctanos por WhatsApp para consultar disponibilidad, preventas o pedidos especiales.</p>",
            "icon": "↗"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "step_title": "Confirma tu pedido",
            "step_description": "<p>Coordinamos talla, stock, pago y todos los detalles de tu compra.</p>",
            "icon": "+"
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "04",
            "step_title": "Recíbelo",
            "step_description": "<p>Enviamos tu pedido de forma segura a cualquier parte del Perú.</p>",
            "icon": "✓"
          }
        }
      ]
    }
  ]
}
{% endschema %}