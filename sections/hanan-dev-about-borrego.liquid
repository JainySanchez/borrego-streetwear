{%- liquid
  assign section_id = 'hanan-dev-about-borrego-' | append: section.id
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign image_alt = section.settings.image_alt | default: section.settings.heading | escape
-%}

<section
  id="{{ section_id }}"
  class="hanan-dev-about-borrego hanan-dev-about-borrego--align-{{ section.settings.content_alignment }} hanan-dev-about-borrego--image-{{ section.settings.image_position }}"
  style="
    --hanan-dev-about-bg: {{ section.settings.background_color }};
    --hanan-dev-about-text: {{ section.settings.text_color }};
    --hanan-dev-about-max-width: {{ section.settings.section_max_width }}px;
    --hanan-dev-about-padding-desktop: {{ section.settings.padding_desktop }}px;
    --hanan-dev-about-padding-mobile: {{ section.settings.padding_mobile }}px;
    --hanan-dev-about-image-width: {{ section.settings.image_width }}px;
    --hanan-dev-about-image-radius: {{ section.settings.image_border_radius }}px;
  "
  aria-labelledby="{{ section_id }}-heading"
>
  <div class="hanan-dev-about-borrego__inner">
    {%- if desktop_image != blank or mobile_image != blank -%}
      <div class="hanan-dev-about-borrego__media">
        <picture>
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 240 }} 240w,
                {{ mobile_image | image_url: width: 360 }} 360w,
                {{ mobile_image | image_url: width: 520 }} 520w
              "
              sizes="(max-width: 749px) 42vw, {{ section.settings.image_width }}px"
            >
          {%- endif -%}

          {%- assign rendered_image = desktop_image | default: mobile_image -%}

          <img
            src="{{ rendered_image | image_url: width: 520 }}"
            srcset="
              {{ rendered_image | image_url: width: 240 }} 240w,
              {{ rendered_image | image_url: width: 360 }} 360w,
              {{ rendered_image | image_url: width: 520 }} 520w,
              {{ rendered_image | image_url: width: 720 }} 720w
            "
            sizes="(max-width: 749px) 42vw, {{ section.settings.image_width }}px"
            alt="{{ image_alt }}"
            width="{{ rendered_image.width }}"
            height="{{ rendered_image.height }}"
            loading="lazy"
            class="hanan-dev-about-borrego__image"
          >
        </picture>
      </div>
    {%- endif -%}

    <div class="hanan-dev-about-borrego__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hanan-dev-about-borrego__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="{{ section_id }}-heading" class="hanan-dev-about-borrego__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="hanan-dev-about-borrego__description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.metadata != blank -%}
        <p class="hanan-dev-about-borrego__metadata">
          {{ section.settings.metadata }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--hanan-dev-about-bg);
    color: var(--hanan-dev-about-text);
    padding-top: var(--hanan-dev-about-padding-desktop);
    padding-bottom: var(--hanan-dev-about-padding-desktop);
    overflow: hidden;
  }

  #{{ section_id }} .hanan-dev-about-borrego__inner {
    width: min(100% - 40px, var(--hanan-dev-about-max-width));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(160px, 0.32fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 76px);
  }

  #{{ section_id }}.hanan-dev-about-borrego--image-right .hanan-dev-about-borrego__media {
    order: 2;
    justify-content: flex-end;
  }

  #{{ section_id }}.hanan-dev-about-borrego--image-right .hanan-dev-about-borrego__content {
    order: 1;
  }

  #{{ section_id }} .hanan-dev-about-borrego__media {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
  }

  #{{ section_id }} .hanan-dev-about-borrego__image {
    display: block;
    width: min(100%, var(--hanan-dev-about-image-width));
    height: auto;
    max-height: 260px;
    object-fit: contain;
    border-radius: var(--hanan-dev-about-image-radius);
  }

  #{{ section_id }} .hanan-dev-about-borrego__content {
    min-width: 0;
    max-width: 860px;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-left .hanan-dev-about-borrego__content {
    text-align: left;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-center .hanan-dev-about-borrego__content {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-right .hanan-dev-about-borrego__content {
    text-align: right;
    margin-left: auto;
  }

  #{{ section_id }} .hanan-dev-about-borrego__eyebrow {
    margin: 0 0 clamp(16px, 2vw, 24px);
    color: #a8733d;
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 800;
  }

  #{{ section_id }} .hanan-dev-about-borrego__heading {
    margin: 0;
    color: currentColor;
    font-size: clamp(34px, 5vw, 78px);
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    font-weight: 900;
    max-width: 760px;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-center .hanan-dev-about-borrego__heading {
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-right .hanan-dev-about-borrego__heading {
    margin-left: auto;
  }

  #{{ section_id }} .hanan-dev-about-borrego__description {
    margin-top: clamp(20px, 2.5vw, 32px);
    max-width: 640px;
    color: currentColor;
    opacity: 0.78;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.7;
  }

  #{{ section_id }} .hanan-dev-about-borrego__description p {
    margin: 0;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-center .hanan-dev-about-borrego__description {
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }}.hanan-dev-about-borrego--align-right .hanan-dev-about-borrego__description {
    margin-left: auto;
  }

  #{{ section_id }} .hanan-dev-about-borrego__metadata {
    margin: clamp(22px, 2.5vw, 34px) 0 0;
    color: #a8733d;
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 800;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .hanan-dev-about-borrego__inner {
      grid-template-columns: minmax(120px, 0.28fr) minmax(0, 1fr);
      gap: 30px;
    }

    #{{ section_id }} .hanan-dev-about-borrego__image {
      max-height: 220px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: var(--hanan-dev-about-padding-mobile);
      padding-bottom: var(--hanan-dev-about-padding-mobile);
    }

    #{{ section_id }} .hanan-dev-about-borrego__inner {
      width: min(100% - 32px, 100%);
      grid-template-columns: 1fr;
      gap: 26px;
    }

    #{{ section_id }}.hanan-dev-about-borrego--image-right .hanan-dev-about-borrego__media,
    #{{ section_id }}.hanan-dev-about-borrego--image-right .hanan-dev-about-borrego__content {
      order: initial;
    }

    #{{ section_id }} .hanan-dev-about-borrego__media {
      justify-content: center;
    }

    #{{ section_id }} .hanan-dev-about-borrego__image {
      width: min(46vw, var(--hanan-dev-about-image-width));
      max-height: 150px;
    }

    #{{ section_id }} .hanan-dev-about-borrego__content,
    #{{ section_id }}.hanan-dev-about-borrego--align-left .hanan-dev-about-borrego__content,
    #{{ section_id }}.hanan-dev-about-borrego--align-right .hanan-dev-about-borrego__content {
      text-align: center;
      margin-left: auto;
      margin-right: auto;
    }

    #{{ section_id }} .hanan-dev-about-borrego__eyebrow {
      margin-bottom: 16px;
    }

    #{{ section_id }} .hanan-dev-about-borrego__heading {
      font-size: clamp(34px, 11vw, 52px);
      line-height: 0.96;
      letter-spacing: -0.045em;
      margin-left: auto;
      margin-right: auto;
    }

    #{{ section_id }} .hanan-dev-about-borrego__description {
      margin-top: 22px;
      max-width: 100%;
      font-size: 15px;
      line-height: 1.65;
      margin-left: auto;
      margin-right: auto;
    }

    #{{ section_id }} .hanan-dev-about-borrego__metadata {
      margin-top: 22px;
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "Hanan Dev About BORREGO",
  "tag": "section",
  "class": "section-hanan-dev-about-borrego",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "BORREGO STREETWEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CULTURA STREETWEAR CURADA"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>BORREGO nace de la cultura sneaker y streetwear, seleccionando piezas auténticas, exclusivas y difíciles de encontrar.</p>"
    },
    {
      "type": "text",
      "id": "metadata",
      "label": "Metadata text",
      "default": "Lima, Perú · Authentic Products"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Imagen"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Logo BORREGO Streetwear"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 80,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F2ECDD"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Section max width",
      "min": 960,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1180
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Desktop padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 32,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Hanan Dev About BORREGO"
    }
  ]
}
{% endschema %}