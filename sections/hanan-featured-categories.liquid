<section
  class="hanan-featured-categories"
  style="
    --section-bg: {{ section.settings.section_background }};
    --text-color: {{ section.settings.text_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --animation-speed: {{ section.settings.animation_speed }}ms;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hanan-featured-categories__inner">
    <div class="hanan-featured-categories__grid">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.button_link }}"
          class="hanan-category-card"
          {{ block.shopify_attributes }}
        >
          <div class="hanan-category-card__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '500, 700, 900, 1100, 1400, 1600',
                  sizes: '(max-width: 749px) 100vw, 33vw',
                  class: 'hanan-category-card__image'
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'hanan-category-card__placeholder' }}
            {% endif %}
          </div>

          <div class="hanan-category-card__overlay"></div>
          <div class="hanan-category-card__grain"></div>

          <div class="hanan-category-card__content">
            <p class="hanan-category-card__subtitle">
              {{ block.settings.subtitle }}
            </p>

            <h2 class="hanan-category-card__title">
              {{ block.settings.category_title }}
            </h2>

            {% if block.settings.button_label != blank %}
              <span class="hanan-category-card__button">
                {{ block.settings.button_label }}
                <span aria-hidden="true">→</span>
              </span>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .hanan-featured-categories {
    width: 100%;
    background: var(--section-bg);
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    overflow: hidden;
  }

  .hanan-featured-categories__inner {
    width: 100%;
    padding: 0 32px;
  }

  .hanan-featured-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .hanan-category-card {
    position: relative;
    display: block;
    min-height: 660px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text-color);
    background: #11110c;
    isolation: isolate;
    opacity: 0;
    transform: translateY(34px) scale(0.985);
    animation: hanan-card-reveal var(--animation-speed) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hanan-category-card:nth-child(2) {
    animation-delay: 160ms;
  }

  .hanan-category-card:nth-child(3) {
    animation-delay: 320ms;
  }

  .hanan-category-card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hanan-category-card__image,
  .hanan-category-card__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.04);
    filter: contrast(1.04) saturate(0.9) brightness(0.86);
    transition:
      transform 1400ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 1400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-category-card__placeholder {
    background: #1b1a14;
  }

  .hanan-category-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(17, 17, 12, 0.28) 0%,
        rgba(17, 17, 12, 0.22) 30%,
        rgba(17, 17, 12, 0.58) 68%,
        rgba(17, 17, 12, 0.94) 100%
      ),
      radial-gradient(
        circle at 50% 20%,
        rgba(242, 236, 221, 0.08) 0%,
        rgba(17, 17, 12, 0.08) 32%,
        rgba(17, 17, 12, 0.64) 100%
      ),
      rgba(17, 17, 12, var(--overlay-opacity));
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-category-card__grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(242, 236, 221, 0.035),
        transparent 32%,
        rgba(17, 17, 12, 0.14)
      );
    mix-blend-mode: overlay;
    opacity: 0.38;
  }

  .hanan-category-card__content {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 34px;
    z-index: 3;
    transform: translateY(0);
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-category-card__subtitle {
    margin: 0 0 14px;
    font-size: 10px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #d9b26f;
  }

  .hanan-category-card__title {
    margin: 0;
    font-size: clamp(34px, 3.8vw, 64px);
    line-height: 0.88;
    font-weight: 900;
    letter-spacing: 0.085em;
    text-transform: uppercase;
    color: var(--text-color);
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-category-card__button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 26px;
    padding-bottom: 8px;
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--text-color);
    opacity: 0.9;
  }

  .hanan-category-card__button::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 18px);
    height: 1px;
    background: #d9b26f;
    transform: scaleX(1);
    transform-origin: left;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-category-card__button span {
    font-size: 12px;
    transform: translateX(0);
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-category-card:hover .hanan-category-card__image {
    transform: scale(1.12) translateY(-10px);
    filter: contrast(1.1) saturate(0.92) brightness(0.78);
  }

  .hanan-category-card:hover .hanan-category-card__overlay {
    opacity: 0.96;
  }

  .hanan-category-card:hover .hanan-category-card__content {
    transform: translateY(-10px);
  }

  .hanan-category-card:hover .hanan-category-card__button::after {
    transform: scaleX(0.62);
  }

  .hanan-category-card:hover .hanan-category-card__button span {
    transform: translateX(4px);
  }

  @keyframes hanan-card-reveal {
    from {
      opacity: 0;
      transform: translateY(34px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-featured-categories__inner {
      padding: 0 22px;
    }

    .hanan-featured-categories__grid {
      gap: 16px;
    }

    .hanan-category-card {
      min-height: 560px;
    }

    .hanan-category-card__content {
      left: 24px;
      right: 24px;
      bottom: 28px;
    }

    .hanan-category-card__title {
      font-size: clamp(28px, 4vw, 44px);
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-featured-categories {
      padding-top: calc(var(--section-padding-top) * 0.78);
      padding-bottom: calc(var(--section-padding-bottom) * 0.78);
    }

    .hanan-featured-categories__inner {
      padding: 0 16px;
    }

    .hanan-featured-categories__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .hanan-category-card {
      min-height: 460px;
      transform: translateY(24px) scale(0.99);
    }

    .hanan-category-card__image,
    .hanan-category-card__placeholder {
      transform: scale(1.03);
      filter: contrast(1.04) saturate(0.9) brightness(0.82);
    }

    .hanan-category-card__content {
      left: 22px;
      right: 22px;
      bottom: 26px;
    }

    .hanan-category-card__subtitle {
      margin-bottom: 12px;
      font-size: 9px;
      letter-spacing: 0.22em;
    }

    .hanan-category-card__title {
      font-size: 36px;
      letter-spacing: 0.075em;
    }

    .hanan-category-card__button {
      margin-top: 22px;
      font-size: 9px;
      letter-spacing: 0.22em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-category-card,
    .hanan-category-card__image,
    .hanan-category-card__placeholder,
    .hanan-category-card__content,
    .hanan-category-card__button::after,
    .hanan-category-card__button span,
    .hanan-category-card__overlay {
      animation: none;
      transition: none;
    }

    .hanan-category-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Featured Categories",
  "settings": [
    {
      "type": "color",
      "id": "section_background",
      "label": "Color de fondo",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#F2ECDD"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad del overlay",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Velocidad de animación",
      "min": 600,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "category_title",
          "label": "Título",
          "default": "SNEAKERS"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtítulo",
          "default": "DISCOVER THE DROP"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "default": "EXPLORE"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link del botón"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HANAN Featured Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "category_title": "SNEAKERS",
            "subtitle": "DISCOVER THE DROP",
            "button_label": "EXPLORE"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "APPAREL",
            "subtitle": "CURATED STREETWEAR",
            "button_label": "EXPLORE"
          }
        },
        {
          "type": "category",
          "settings": {
            "category_title": "ACCESSORIES",
            "subtitle": "PREMIUM ESSENTIALS",
            "button_label": "EXPLORE"
          }
        }
      ]
    }
  ]
}
{% endschema %}