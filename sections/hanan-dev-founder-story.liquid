{%- liquid
  assign section_id = 'hanan-dev-founder-story-' | append: section.id
  assign founder_image = section.settings.founder_image
  assign founder_mobile_image = section.settings.founder_mobile_image
  assign rendered_founder_image = founder_image | default: founder_mobile_image
  assign founder_alt = section.settings.founder_image_alt | default: section.settings.heading | escape
  assign has_founder_image = false

  if rendered_founder_image != blank
    assign has_founder_image = true
  endif
-%}

<section
  id="{{ section_id }}"
  class="hanan-dev-founder-story hanan-dev-founder-story--image-{{ section.settings.image_position }} {% if has_founder_image %}hanan-dev-founder-story--has-image{% else %}hanan-dev-founder-story--no-image{% endif %}"
  style="
    --hanan-dev-founder-bg: {{ section.settings.background_color }};
    --hanan-dev-founder-text: {{ section.settings.text_color }};
    --hanan-dev-founder-accent: {{ section.settings.accent_color }};
    --hanan-dev-founder-max-width: {{ section.settings.section_max_width }}px;
    --hanan-dev-founder-padding-desktop: {{ section.settings.padding_desktop }}px;
    --hanan-dev-founder-padding-mobile: {{ section.settings.padding_mobile }}px;
    --hanan-dev-founder-image-width: {{ section.settings.image_width }}%;
    --hanan-dev-founder-image-radius: {{ section.settings.image_border_radius }}px;
  "
  aria-labelledby="{{ section_id }}-heading"
>
  <div class="hanan-dev-founder-story__inner">
    <header class="hanan-dev-founder-story__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hanan-dev-founder-story__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 id="{{ section_id }}-heading" class="hanan-dev-founder-story__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
    </header>

    <div class="hanan-dev-founder-story__main">
      {%- if has_founder_image -%}
        <div class="hanan-dev-founder-story__media">
          <picture>
            {%- if founder_mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ founder_mobile_image | image_url: width: 600 }} 600w,
                  {{ founder_mobile_image | image_url: width: 900 }} 900w,
                  {{ founder_mobile_image | image_url: width: 1200 }} 1200w
                "
                sizes="100vw"
              >
            {%- endif -%}

            <img
              src="{{ rendered_founder_image | image_url: width: 1000 }}"
              srcset="
                {{ rendered_founder_image | image_url: width: 600 }} 600w,
                {{ rendered_founder_image | image_url: width: 900 }} 900w,
                {{ rendered_founder_image | image_url: width: 1200 }} 1200w,
                {{ rendered_founder_image | image_url: width: 1600 }} 1600w
              "
              sizes="(max-width: 749px) 100vw, {{ section.settings.image_width }}vw"
              alt="{{ founder_alt }}"
              width="{{ rendered_founder_image.width }}"
              height="{{ rendered_founder_image.height }}"
              loading="lazy"
              class="hanan-dev-founder-story__image"
            >
          </picture>
        </div>
      {%- endif -%}

      <div class="hanan-dev-founder-story__content">
        {%- if section.settings.story != blank -%}
          <div class="hanan-dev-founder-story__story">
            {{ section.settings.story }}
          </div>
        {%- endif -%}

        <dl class="hanan-dev-founder-story__metadata">
          {%- if section.settings.founder_name != blank -%}
            <div class="hanan-dev-founder-story__meta-item">
              <dt>Fundador</dt>
              <dd>{{ section.settings.founder_name }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.location != blank -%}
            <div class="hanan-dev-founder-story__meta-item">
              <dt>Ubicación</dt>
              <dd>{{ section.settings.location }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.years_in_business != blank -%}
            <div class="hanan-dev-founder-story__meta-item">
              <dt>Desde</dt>
              <dd>{{ section.settings.years_in_business }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.community_size != blank -%}
            <div class="hanan-dev-founder-story__meta-item">
              <dt>Comunidad</dt>
              <dd>{{ section.settings.community_size }}</dd>
            </div>
          {%- endif -%}
        </dl>

        {%- if section.settings.tagline != blank -%}
          <p class="hanan-dev-founder-story__tagline">
            {{ section.settings.tagline }}
          </p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="hanan-dev-history-gallery" aria-label="Galería de historia BORREGO">
        {%- for block in section.blocks -%}
          {%- liquid
            assign gallery_image = block.settings.image
            assign gallery_alt = block.settings.alt_text | default: block.settings.caption | default: section.settings.heading | escape
          -%}

          {%- if gallery_image != blank -%}
            <figure class="hanan-dev-history-gallery__item" {{ block.shopify_attributes }}>
              <div class="hanan-dev-history-gallery__media">
                <img
                  src="{{ gallery_image | image_url: width: 700 }}"
                  srcset="
                    {{ gallery_image | image_url: width: 360 }} 360w,
                    {{ gallery_image | image_url: width: 520 }} 520w,
                    {{ gallery_image | image_url: width: 700 }} 700w,
                    {{ gallery_image | image_url: width: 900 }} 900w
                  "
                  sizes="(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw"
                  alt="{{ gallery_alt }}"
                  width="{{ gallery_image.width }}"
                  height="{{ gallery_image.height }}"
                  loading="lazy"
                  class="hanan-dev-history-gallery__image"
                >
              </div>

              {%- if block.settings.caption != blank -%}
                <figcaption class="hanan-dev-history-gallery__caption">
                  {{ block.settings.caption }}
                </figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--hanan-dev-founder-bg);
    color: var(--hanan-dev-founder-text);
    padding-top: var(--hanan-dev-founder-padding-desktop);
    padding-bottom: var(--hanan-dev-founder-padding-desktop);
    overflow: hidden;
  }

  #{{ section_id }} .hanan-dev-founder-story__inner {
    width: min(100% - 40px, var(--hanan-dev-founder-max-width));
    margin: 0 auto;
  }

  #{{ section_id }} .hanan-dev-founder-story__header {
    max-width: 980px;
    margin-bottom: clamp(34px, 5vw, 70px);
  }

  #{{ section_id }} .hanan-dev-founder-story__eyebrow {
    margin: 0 0 18px;
    color: var(--hanan-dev-founder-accent);
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 800;
  }

  #{{ section_id }} .hanan-dev-founder-story__heading {
    margin: 0;
    max-width: 920px;
    color: currentColor;
    font-size: clamp(42px, 6.4vw, 94px);
    line-height: 0.9;
    letter-spacing: -0.06em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-founder-story__main {
    display: grid;
    grid-template-columns: minmax(0, var(--hanan-dev-founder-image-width)) minmax(0, 1fr);
    align-items: center;
    gap: clamp(34px, 5vw, 82px);
  }

  #{{ section_id }}.hanan-dev-founder-story--no-image .hanan-dev-founder-story__main {
    grid-template-columns: 1fr;
  }

  #{{ section_id }}.hanan-dev-founder-story--image-right .hanan-dev-founder-story__media {
    order: 2;
  }

  #{{ section_id }}.hanan-dev-founder-story--image-right .hanan-dev-founder-story__content {
    order: 1;
  }

  #{{ section_id }} .hanan-dev-founder-story__media {
    min-width: 0;
  }

  #{{ section_id }} .hanan-dev-founder-story__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: cover;
    border-radius: var(--hanan-dev-founder-image-radius);
    box-shadow: 0 28px 70px rgba(17, 17, 12, 0.16);
  }

  #{{ section_id }} .hanan-dev-founder-story__content {
    min-width: 0;
    max-width: 680px;
  }

  #{{ section_id }}.hanan-dev-founder-story--no-image .hanan-dev-founder-story__content {
    max-width: 820px;
  }

  #{{ section_id }} .hanan-dev-founder-story__story {
    color: currentColor;
    opacity: 0.84;
    font-size: clamp(16px, 1.35vw, 20px);
    line-height: 1.75;
  }

  #{{ section_id }} .hanan-dev-founder-story__story p {
    margin: 0;
  }

  #{{ section_id }} .hanan-dev-founder-story__story p + p {
    margin-top: 1.15em;
  }

  #{{ section_id }} .hanan-dev-founder-story__story strong,
  #{{ section_id }} .hanan-dev-founder-story__story b {
    color: currentColor;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-founder-story__story a {
    color: var(--hanan-dev-founder-accent);
    text-underline-offset: 4px;
  }

  #{{ section_id }} .hanan-dev-founder-story__metadata {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: clamp(30px, 4vw, 48px) 0 0;
    background: color-mix(in srgb, currentColor 16%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 24px;
    overflow: hidden;
  }

  #{{ section_id }} .hanan-dev-founder-story__metadata:empty {
    display: none;
  }

  #{{ section_id }} .hanan-dev-founder-story__meta-item {
    padding: 18px;
    background: color-mix(in srgb, var(--hanan-dev-founder-bg) 90%, var(--hanan-dev-founder-text) 10%);
  }

  #{{ section_id }} .hanan-dev-founder-story__meta-item dt {
    margin: 0 0 8px;
    color: var(--hanan-dev-founder-accent);
    font-size: 10px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-founder-story__meta-item dd {
    margin: 0;
    color: currentColor;
    font-size: 14px;
    line-height: 1.35;
    font-weight: 800;
  }

  #{{ section_id }} .hanan-dev-founder-story__tagline {
    margin: clamp(24px, 3vw, 36px) 0 0;
    color: var(--hanan-dev-founder-accent);
    font-size: clamp(12px, 1vw, 14px);
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-history-gallery {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 22px);
    margin-top: clamp(44px, 6vw, 86px);
  }

  #{{ section_id }} .hanan-dev-history-gallery__item {
    margin: 0;
    min-width: 0;
  }

  #{{ section_id }} .hanan-dev-history-gallery__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: calc(var(--hanan-dev-founder-image-radius) * 0.8);
    background: color-mix(in srgb, var(--hanan-dev-founder-bg) 86%, var(--hanan-dev-founder-text) 14%);
  }

  #{{ section_id }} .hanan-dev-history-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 360ms ease;
  }

  #{{ section_id }} .hanan-dev-history-gallery__item:hover .hanan-dev-history-gallery__image {
    transform: scale(1.055);
  }

  #{{ section_id }} .hanan-dev-history-gallery__caption {
    margin-top: 12px;
    color: currentColor;
    opacity: 0.68;
    font-size: 12px;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .hanan-dev-founder-story__main {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    #{{ section_id }}.hanan-dev-founder-story--image-right .hanan-dev-founder-story__media,
    #{{ section_id }}.hanan-dev-founder-story--image-right .hanan-dev-founder-story__content {
      order: initial;
    }

    #{{ section_id }} .hanan-dev-founder-story__image {
      max-height: 620px;
    }

    #{{ section_id }} .hanan-dev-founder-story__content {
      max-width: 780px;
    }

    #{{ section_id }} .hanan-dev-history-gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: var(--hanan-dev-founder-padding-mobile);
      padding-bottom: var(--hanan-dev-founder-padding-mobile);
    }

    #{{ section_id }} .hanan-dev-founder-story__inner {
      width: min(100% - 32px, 100%);
    }

    #{{ section_id }} .hanan-dev-founder-story__header {
      margin-bottom: 30px;
    }

    #{{ section_id }} .hanan-dev-founder-story__eyebrow {
      margin-bottom: 16px;
    }

    #{{ section_id }} .hanan-dev-founder-story__heading {
      font-size: clamp(36px, 12vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.02em;
    }

    #{{ section_id }} .hanan-dev-founder-story__image {
      max-height: 520px;
      border-radius: min(var(--hanan-dev-founder-image-radius), 24px);
    }

    #{{ section_id }} .hanan-dev-founder-story__story {
      font-size: 15px;
      line-height: 1.68;
    }

    #{{ section_id }} .hanan-dev-founder-story__metadata {
      grid-template-columns: 1fr;
      border-radius: 22px;
      margin-top: 28px;
    }

    #{{ section_id }} .hanan-dev-founder-story__meta-item {
      padding: 17px;
    }

    #{{ section_id }} .hanan-dev-founder-story__tagline {
      margin-top: 24px;
      font-size: 11px;
    }

    #{{ section_id }} .hanan-dev-history-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 42px;
    }

    #{{ section_id }} .hanan-dev-history-gallery__media {
      border-radius: min(var(--hanan-dev-founder-image-radius), 20px);
    }

    #{{ section_id }} .hanan-dev-history-gallery__caption {
      margin-top: 9px;
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "Hanan Dev Founder Story",
  "tag": "section",
  "class": "section-hanan-dev-founder-story",
  "settings": [
    {
      "type": "header",
      "content": "Contenido superior"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "BORREGO STREETWEAR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LA HISTORIA DETRÁS DE BORREGO"
    },
    {
      "type": "header",
      "content": "Historia"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Rich text story",
      "default": "<p>BORREGO nace desde la pasión por la cultura sneaker, el streetwear y las piezas difíciles de encontrar.</p><p>Cada producto es seleccionado con una mirada curada, priorizando autenticidad, estilo y conexión con una comunidad que entiende el valor de vestir piezas con historia.</p>"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder name",
      "default": "Juan Pérez"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Lima, Perú"
    },
    {
      "type": "text",
      "id": "years_in_business",
      "label": "Years in business",
      "default": "2018"
    },
    {
      "type": "text",
      "id": "community_size",
      "label": "Community size",
      "default": "Streetwear community"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Sneakers • Streetwear • Collectibles"
    },
    {
      "type": "header",
      "content": "Imagen principal"
    },
    {
      "type": "image_picker",
      "id": "founder_image",
      "label": "Founder desktop image"
    },
    {
      "type": "image_picker",
      "id": "founder_mobile_image",
      "label": "Founder mobile image"
    },
    {
      "type": "text",
      "id": "founder_image_alt",
      "label": "Founder image alt text",
      "default": "Fundador de BORREGO Streetwear"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width desktop",
      "min": 35,
      "max": 58,
      "step": 1,
      "unit": "%",
      "default": 46
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 42,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8733D"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Section max width",
      "min": 960,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Desktop padding",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Optional caption",
          "default": "BORREGO moment"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Imagen de historia BORREGO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hanan Dev Founder Story",
      "blocks": [
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        }
      ]
    }
  ]
}
{% endschema %}