{% liquid
  assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_message
%}

<section
  class="hanan-showroom-location {% if section.settings.enable_animation %}hanan-showroom-location--animated{% endif %}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --container-bg: {{ section.settings.container_background_color }};
    --map-bg: {{ section.settings.map_background_color }};
    --label-color: {{ section.settings.label_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --address-color: {{ section.settings.address_color }};
    --schedule-color: {{ section.settings.schedule_color }};
    --info-label-color: {{ section.settings.info_label_color }};
    --button-text: {{ section.settings.button_text_color }};
    --button-bg: {{ section.settings.button_background_color }};
    --button-border: {{ section.settings.button_border_color }};
    --button-hover-text: {{ section.settings.button_hover_text_color }};
    --button-hover-bg: {{ section.settings.button_hover_background_color }};
    --divider-color: {{ section.settings.divider_color }};
    --border-color: {{ section.settings.border_color }};
    --shadow-opacity: {{ section.settings.shadow_opacity | divided_by: 100.0 }};
    --radius: {{ section.settings.border_radius }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hanan-showroom-location__inner">
    <div class="hanan-showroom-location__map-card">
      <div class="hanan-showroom-location__map-frame">
        {% if section.settings.google_maps_embed != blank %}
          <iframe
            src="{{ section.settings.google_maps_embed }}"
            class="hanan-showroom-location__iframe"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Showroom Google Map"
          ></iframe>
        {% else %}
          <div class="hanan-showroom-location__map-placeholder">
            <span>GOOGLE MAPS</span>
            <small>Agrega la URL embed desde el editor</small>
          </div>
        {% endif %}
      </div>

      {% if section.settings.google_maps_url != blank %}
        <a
          href="{{ section.settings.google_maps_url }}"
          target="_blank"
          rel="noopener"
          class="hanan-showroom-location__map-cta"
        >
          VER EN MAPS →
        </a>
      {% endif %}
    </div>

    <div class="hanan-showroom-location__content-card">
      {% if section.settings.small_label != blank %}
        <p class="hanan-showroom-location__label">
          {{ section.settings.small_label }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hanan-showroom-location__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hanan-showroom-location__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="hanan-showroom-location__divider"></div>

      <div class="hanan-showroom-location__info">
        {% if section.settings.showroom_address != blank %}
          <div class="hanan-showroom-location__info-item">
            <span>SHOWROOM</span>
            <p class="hanan-showroom-location__address">{{ section.settings.showroom_address }}</p>
          </div>
        {% endif %}

        {% if section.settings.showroom_schedule != blank %}
          <div class="hanan-showroom-location__info-item">
            <span>HORARIO</span>
            <p class="hanan-showroom-location__schedule">{{ section.settings.showroom_schedule }}</p>
          </div>
        {% endif %}
      </div>

      {% if section.settings.cta_label != blank and section.settings.whatsapp_phone != blank %}
        <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="hanan-showroom-location__button">
          {{ section.settings.cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hanan-showroom-location {
    width: 100%;
    background:
      radial-gradient(circle at 18% 20%, rgba(217, 178, 111, 0.1), transparent 28%),
      radial-gradient(circle at 84% 74%, rgba(242, 236, 221, 0.045), transparent 30%),
      var(--section-bg);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hanan-showroom-location__inner {
    display: grid;
    grid-template-columns: 54% 46%;
    gap: clamp(18px, 2.4vw, 34px);
    padding: 0 5vw;
    align-items: stretch;
  }

  .hanan-showroom-location__map-card,
  .hanan-showroom-location__content-card {
    border-radius: var(--radius);
    background: var(--container-bg);
    border: 1px solid var(--border-color);
    box-shadow: 0 24px 70px rgba(0, 0, 0, var(--shadow-opacity));
    overflow: hidden;
  }

  .hanan-showroom-location__map-card {
    position: relative;
    min-height: 430px;
    background: var(--map-bg);
  }

  .hanan-showroom-location__map-frame {
    width: 100%;
    height: 100%;
    min-height: 430px;
    overflow: hidden;
  }

  .hanan-showroom-location__iframe {
    width: 100%;
    height: 100%;
    min-height: 430px;
    border: 0;
    display: block;
        filter: grayscale(0.3) contrast(1.1) brightness(0.82);
  }

  .hanan-showroom-location__map-placeholder {
    width: 100%;
    min-height: 430px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at center, rgba(217, 178, 111, 0.12), transparent 34%),
      #171711;
    color: #F2ECDD;
    text-align: center;
  }

  .hanan-showroom-location__map-placeholder span {
    font-size: 18px;
    font-weight: 850;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hanan-showroom-location__map-placeholder small {
    margin-top: 12px;
    font-size: 11px;
    opacity: 0.65;
  }

  .hanan-showroom-location__map-cta {
    position: absolute;
    left: 22px;
    bottom: 22px;
    z-index: 2;
    padding: 11px 15px;
    border: 1px solid rgba(242, 236, 221, 0.22);
    background: rgba(17, 17, 12, 0.72);
    color: #F2ECDD;
    text-decoration: none;
    font-size: 8.5px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    transition:
      background 550ms cubic-bezier(0.16, 1, 0.3, 1),
      color 550ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-showroom-location__map-cta:hover {
    background: #F2ECDD;
    color: #11110C;
    transform: translateY(-2px);
  }

  .hanan-showroom-location__content-card {
    padding: clamp(32px, 4.2vw, 58px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hanan-showroom-location__label {
    margin: 0 0 14px;
    color: var(--label-color);
    font-size: 8.5px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .hanan-showroom-location__heading {
    max-width: 460px;
    margin: 0;
    color: var(--heading-color);
    font-size: clamp(30px, 3.4vw, 54px);
    line-height: 0.92;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-showroom-location__description {
    max-width: 430px;
    margin-top: 18px;
    color: var(--description-color);
    font-size: 13.5px;
    line-height: 1.62;
    letter-spacing: 0.035em;
  }

  .hanan-showroom-location__description p {
    margin: 0;
  }

  .hanan-showroom-location__divider {
    width: 100%;
    height: 1px;
    margin: 26px 0;
    background: var(--divider-color);
    opacity: 0.7;
  }

  .hanan-showroom-location__info {
    display: grid;
    gap: 16px;
  }

  .hanan-showroom-location__info-item {
    display: grid;
    gap: 6px;
  }

  .hanan-showroom-location__info-item span {
    color: var(--info-label-color);
    font-size: 8px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .hanan-showroom-location__info-item p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.5;
    letter-spacing: 0.035em;
  }

  .hanan-showroom-location__address {
    color: var(--address-color);
  }

  .hanan-showroom-location__schedule {
    color: var(--schedule-color);
  }

  .hanan-showroom-location__button {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
    padding: 13px 18px;
    border: 1px solid var(--button-border);
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    font-size: 8.5px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition:
      background 550ms cubic-bezier(0.16, 1, 0.3, 1),
      color 550ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 550ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 550ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-showroom-location__button:hover {
    background: var(--button-hover-bg);
    color: var(--button-hover-text);
    border-color: var(--button-hover-bg);
    transform: translateY(-2px);
  }

  .hanan-showroom-location--animated .hanan-showroom-location__map-card,
  .hanan-showroom-location--animated .hanan-showroom-location__content-card {
    opacity: 0;
    transform: translateY(22px);
    animation: hananShowroomLocationReveal 900ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hanan-showroom-location--animated .hanan-showroom-location__content-card {
    animation-delay: 120ms;
  }

  @keyframes hananShowroomLocationReveal {
    from {
      opacity: 0;
      transform: translateY(22px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-showroom-location__inner {
      grid-template-columns: 1fr;
      padding: 0 28px;
    }

    .hanan-showroom-location__map-card,
    .hanan-showroom-location__map-frame,
    .hanan-showroom-location__iframe,
    .hanan-showroom-location__map-placeholder {
      min-height: 360px;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-showroom-location {
      padding-top: calc(var(--padding-top) * 0.72);
      padding-bottom: calc(var(--padding-bottom) * 0.72);
    }

    .hanan-showroom-location__inner {
      padding: 0 16px;
      gap: 16px;
    }

    .hanan-showroom-location__map-card,
    .hanan-showroom-location__map-frame,
    .hanan-showroom-location__iframe,
    .hanan-showroom-location__map-placeholder {
      min-height: 300px;
    }

    .hanan-showroom-location__map-cta {
      left: 16px;
      bottom: 16px;
      font-size: 8px;
      letter-spacing: 0.18em;
    }

    .hanan-showroom-location__content-card {
      padding: 28px 20px;
    }

    .hanan-showroom-location__label {
      font-size: 8px;
      letter-spacing: 0.22em;
    }

    .hanan-showroom-location__heading {
      font-size: 31px;
      letter-spacing: 0.06em;
    }

    .hanan-showroom-location__description {
      margin-top: 16px;
      font-size: 13px;
    }

    .hanan-showroom-location__button {
      width: 100%;
      margin-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-showroom-location__map-card,
    .hanan-showroom-location__content-card,
    .hanan-showroom-location__button,
    .hanan-showroom-location__map-cta {
      animation: none;
      transition: none;
    }

    .hanan-showroom-location--animated .hanan-showroom-location__map-card,
    .hanan-showroom-location--animated .hanan-showroom-location__content-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Showroom Location",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "small_label",
      "label": "Etiqueta pequeña",
      "default": "PRIVATE SHOWROOM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "VISÍTANOS EN LIMA"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Descubre sneakers, apparel y piezas premium en una experiencia privada y personalizada.</p>"
    },
    {
      "type": "text",
      "id": "showroom_address",
      "label": "Dirección showroom",
      "default": "Av. Ejemplo 123 — Lima, Perú"
    },
    {
      "type": "text",
      "id": "showroom_schedule",
      "label": "Horario showroom",
      "default": "Lunes — Sábado · 10AM — 8PM"
    },
    {
      "type": "url",
      "id": "google_maps_url",
      "label": "URL de Google Maps"
    },
    {
      "type": "text",
      "id": "google_maps_embed",
      "label": "URL embed de Google Maps"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto CTA WhatsApp",
      "default": "AGENDAR VISITA →"
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "Número de WhatsApp",
      "default": "51999999999"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje de WhatsApp",
      "default": "Hola, quiero agendar una visita al showroom de BORREGO."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color fondo sección",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "container_background_color",
      "label": "Color fondo contenedor",
      "default": "rgba(247, 241, 225, 0.06)"
    },
    {
      "type": "color",
      "id": "map_background_color",
      "label": "Color fondo mapa",
      "default": "#171711"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color etiqueta",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color título",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color descripción",
      "default": "rgba(242, 236, 221, 0.68)"
    },
    {
      "type": "color",
      "id": "info_label_color",
      "label": "Color etiquetas info",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "address_color",
      "label": "Color dirección",
      "default": "rgba(242, 236, 221, 0.78)"
    },
    {
      "type": "color",
      "id": "schedule_color",
      "label": "Color horario",
      "default": "rgba(242, 236, 221, 0.68)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color texto botón",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Color fondo botón",
      "default": "rgba(242, 236, 221, 0)"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Color borde botón",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Color texto hover botón",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Color fondo hover botón",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color divisor",
      "default": "rgba(217, 178, 111, 0.38)"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color borde contenedores",
      "default": "rgba(242, 236, 221, 0.12)"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Opacidad sombra",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 24,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio de bordes",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Activar animación",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HANAN Showroom Location"
    }
  ]
}
{% endschema %}