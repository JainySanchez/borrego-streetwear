{% liquid
  assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_message
%}

<section
  class="hanan-showroom-location {% if section.settings.enable_blur %}hanan-showroom-location--blur{% endif %} {% if section.settings.enable_animation %}hanan-showroom-location--animated{% endif %}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --container-bg: {{ section.settings.container_background_color }};
    --map-bg: {{ section.settings.map_background_color }};
    --label-color: {{ section.settings.label_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --info-label-color: {{ section.settings.info_label_color }};
    --info-text-color: {{ section.settings.info_text_color }};
    --button-text: {{ section.settings.button_text_color }};
    --button-border: {{ section.settings.button_border_color }};
    --button-hover-text: {{ section.settings.button_hover_text_color }};
    --button-hover-bg: {{ section.settings.button_hover_background_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --shadow-opacity: {{ section.settings.shadow_intensity | divided_by: 100.0 }};
    --radius: {{ section.settings.border_radius }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hanan-showroom-location__inner">
    <div class="hanan-showroom-location__map-card">
      <a
        href="{{ section.settings.google_maps_url }}"
        target="_blank"
        rel="noopener"
        class="hanan-showroom-location__map-link"
      >
        {% if section.settings.enable_embed_map and section.settings.google_maps_embed != blank %}
          <iframe
            src="{{ section.settings.google_maps_embed }}"
            class="hanan-showroom-location__iframe"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Showroom map"
          ></iframe>
        {% elsif section.settings.map_image != blank %}
          {{
            section.settings.map_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600',
              sizes: '(max-width: 749px) 100vw, 55vw',
              class: 'hanan-showroom-location__map-image'
          }}
        {% else %}
          <div class="hanan-showroom-location__map-placeholder">
            <span>LIMA</span>
            <small>PRIVATE SHOWROOM</small>
          </div>
        {% endif %}

        <div class="hanan-showroom-location__map-overlay"></div>

        <div class="hanan-showroom-location__map-cta">
          VER EN MAPS →
        </div>
      </a>
    </div>

    <div class="hanan-showroom-location__content-card">
      {% if section.settings.small_label != blank %}
        <p class="hanan-showroom-location__label">
          {{ section.settings.small_label }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hanan-showroom-location__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hanan-showroom-location__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="hanan-showroom-location__divider"></div>

      <div class="hanan-showroom-location__info">
        {% if section.settings.showroom_address != blank %}
          <div class="hanan-showroom-location__info-item">
            <span>SHOWROOM</span>
            <p>{{ section.settings.showroom_address }}</p>
          </div>
        {% endif %}

        {% if section.settings.showroom_schedule != blank %}
          <div class="hanan-showroom-location__info-item">
            <span>HORARIO</span>
            <p>{{ section.settings.showroom_schedule }}</p>
          </div>
        {% endif %}
      </div>

      {% if section.settings.cta_label != blank and section.settings.whatsapp_phone != blank %}
        <a href="{{ whatsapp_url }}" target="_blank" rel="noopener" class="hanan-showroom-location__button">
          {{ section.settings.cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hanan-showroom-location {
    width: 100%;
    position: relative;
    background:
      radial-gradient(circle at 18% 18%, rgba(217, 178, 111, 0.1), transparent 32%),
      radial-gradient(circle at 82% 74%, rgba(242, 236, 221, 0.055), transparent 34%),
      linear-gradient(180deg, rgba(255,255,255,0.018), transparent 48%),
      var(--section-bg);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hanan-showroom-location::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.2;
    background-image:
      linear-gradient(rgba(242, 236, 221, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 236, 221, 0.022) 1px, transparent 1px);
    background-size: 90px 90px;
    mask-image: radial-gradient(circle at center, black, transparent 74%);
  }

  .hanan-showroom-location__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 55% 45%;
    gap: clamp(22px, 3vw, 42px);
    width: 100%;
    padding: 0 5vw;
    align-items: stretch;
  }

  .hanan-showroom-location__map-card,
  .hanan-showroom-location__content-card {
    position: relative;
    border-radius: var(--radius);
    background:
      linear-gradient(145deg, rgba(255,255,255,0.055), rgba(255,255,255,0)),
      var(--container-bg);
    border: 1px solid rgba(242, 236, 221, 0.12);
    box-shadow:
      0 34px 90px rgba(0, 0, 0, var(--shadow-opacity)),
      inset 0 1px 0 rgba(255,255,255,0.06);
    overflow: hidden;
  }

  .hanan-showroom-location--blur .hanan-showroom-location__map-card,
  .hanan-showroom-location--blur .hanan-showroom-location__content-card {
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .hanan-showroom-location__map-card {
    min-height: 620px;
    background: var(--map-bg);
  }

  .hanan-showroom-location__map-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 620px;
    color: inherit;
    text-decoration: none;
  }

  .hanan-showroom-location__map-image,
  .hanan-showroom-location__iframe {
    width: 100%;
    height: 100%;
    min-height: 620px;
    display: block;
    border: 0;
    object-fit: cover;
    object-position: center;
    filter: grayscale(1) contrast(1.12) brightness(0.7);
    transform: scale(1.03);
    transition:
      transform 1300ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 1300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-showroom-location__map-placeholder {
    width: 100%;
    min-height: 620px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background:
      radial-gradient(circle at center, rgba(217,178,111,0.12), transparent 34%),
      linear-gradient(135deg, #191812, #0f0f0b);
    color: #F2ECDD;
  }

  .hanan-showroom-location__map-placeholder span {
    font-size: clamp(62px, 8vw, 120px);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
    opacity: 0.9;
  }

  .hanan-showroom-location__map-placeholder small {
    margin-top: 18px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(242, 236, 221, 0.64);
  }

  .hanan-showroom-location__map-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(17,17,12,0.1) 0%,
        rgba(17,17,12,0.18) 45%,
        rgba(17,17,12,0.68) 100%
      ),
      rgba(17, 17, 12, var(--overlay-opacity));
    pointer-events: none;
  }

  .hanan-showroom-location__map-cta {
    position: absolute;
    left: 28px;
    bottom: 28px;
    z-index: 2;
    color: #F2ECDD;
    font-size: 9px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    padding-bottom: 8px;
  }

  .hanan-showroom-location__map-cta::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 18px);
    height: 1px;
    background: #D9B26F;
    transition: transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left;
  }

  .hanan-showroom-location__map-link:hover .hanan-showroom-location__map-image,
  .hanan-showroom-location__map-link:hover .hanan-showroom-location__iframe {
    transform: scale(1.07);
    filter: grayscale(1) contrast(1.18) brightness(0.62);
  }

  .hanan-showroom-location__map-link:hover .hanan-showroom-location__map-cta::after {
    transform: scaleX(0.62);
  }

  .hanan-showroom-location__content-card {
    padding: clamp(38px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hanan-showroom-location__label {
    margin: 0 0 20px;
    color: var(--label-color);
    font-size: 9px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .hanan-showroom-location__heading {
    max-width: 520px;
    margin: 0;
    color: var(--heading-color);
    font-size: clamp(34px, 4.2vw, 68px);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-showroom-location__description {
    max-width: 460px;
    margin-top: 24px;
    color: var(--description-color);
    font-size: 14px;
    line-height: 1.72;
    letter-spacing: 0.035em;
  }

  .hanan-showroom-location__description p {
    margin: 0;
  }

  .hanan-showroom-location__divider {
    width: 100%;
    height: 1px;
    margin: 34px 0;
    background: linear-gradient(90deg, var(--button-border), transparent);
    opacity: 0.42;
  }

  .hanan-showroom-location__info {
    display: grid;
    gap: 20px;
  }

  .hanan-showroom-location__info-item {
    display: grid;
    gap: 7px;
  }

  .hanan-showroom-location__info-item span {
    color: var(--info-label-color);
    font-size: 8.5px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .hanan-showroom-location__info-item p {
    margin: 0;
    color: var(--info_text_color);
    font-size: 13px;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .hanan-showroom-location__button {
    position: relative;
    width: fit-content;
    display: inline-flex;
    margin-top: 38px;
    padding: 0 0 8px;
    color: var(--button-text);
    text-decoration: none;
    font-size: 9px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    transition:
      color 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-showroom-location__button::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 18px);
    height: 1px;
    background: var(--button-border);
    transform-origin: left;
    transition:
      background 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-showroom-location__button:hover {
    color: var(--button-hover-text);
    transform: translateY(-2px);
  }

  .hanan-showroom-location__button:hover::after {
    background: var(--button-hover-bg);
    transform: scaleX(0.62);
  }

  .hanan-showroom-location--animated .hanan-showroom-location__map-card,
  .hanan-showroom-location--animated .hanan-showroom-location__content-card {
    opacity: 0;
    transform: translateY(28px);
    animation: hananShowroomLocationReveal 1000ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hanan-showroom-location--animated .hanan-showroom-location__content-card {
    animation-delay: 140ms;
  }

  @keyframes hananShowroomLocationReveal {
    from {
      opacity: 0;
      transform: translateY(28px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-showroom-location__inner {
      grid-template-columns: 1fr;
      padding: 0 28px;
    }

    .hanan-showroom-location__map-card,
    .hanan-showroom-location__map-link,
    .hanan-showroom-location__map-image,
    .hanan-showroom-location__iframe,
    .hanan-showroom-location__map-placeholder {
      min-height: 440px;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-showroom-location {
      padding-top: calc(var(--padding-top) * 0.72);
      padding-bottom: calc(var(--padding-bottom) * 0.72);
    }

    .hanan-showroom-location__inner {
      padding: 0 16px;
      gap: 18px;
    }

    .hanan-showroom-location__map-card,
    .hanan-showroom-location__map-link,
    .hanan-showroom-location__map-image,
    .hanan-showroom-location__iframe,
    .hanan-showroom-location__map-placeholder {
      min-height: 340px;
    }

    .hanan-showroom-location__map-cta {
      left: 20px;
      bottom: 20px;
      font-size: 8.5px;
      letter-spacing: 0.22em;
    }

    .hanan-showroom-location__content-card {
      padding: 32px 22px;
    }

    .hanan-showroom-location__label {
      margin-bottom: 16px;
      font-size: 8px;
      letter-spacing: 0.24em;
    }

    .hanan-showroom-location__heading {
      font-size: 34px;
      letter-spacing: 0.065em;
    }

    .hanan-showroom-location__description {
      margin-top: 18px;
      font-size: 13px;
      line-height: 1.64;
    }

    .hanan-showroom-location__divider {
      margin: 28px 0;
    }

    .hanan-showroom-location__button {
      margin-top: 32px;
      font-size: 8.5px;
      letter-spacing: 0.22em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-showroom-location__map-card,
    .hanan-showroom-location__content-card,
    .hanan-showroom-location__map-image,
    .hanan-showroom-location__iframe,
    .hanan-showroom-location__button {
      animation: none;
      transition: none;
    }

    .hanan-showroom-location--animated .hanan-showroom-location__map-card,
    .hanan-showroom-location--animated .hanan-showroom-location__content-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Showroom Location",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "small_label",
      "label": "Etiqueta pequeña",
      "default": "PRIVATE SHOWROOM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "VISÍTANOS EN LIMA"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Descubre sneakers, apparel y piezas premium en una experiencia privada y personalizada.</p>"
    },
    {
      "type": "text",
      "id": "showroom_address",
      "label": "Dirección showroom",
      "default": "📍 Av. Ejemplo 123 — Lima, Perú"
    },
    {
      "type": "text",
      "id": "showroom_schedule",
      "label": "Horario showroom",
      "default": "🕒 Lunes — Sábado · 10AM — 8PM"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Imagen de mapa"
    },
    {
      "type": "url",
      "id": "google_maps_url",
      "label": "URL de Google Maps"
    },
    {
      "type": "checkbox",
      "id": "enable_embed_map",
      "label": "Activar mapa embebido",
      "default": false
    },
    {
      "type": "text",
      "id": "google_maps_embed",
      "label": "URL embed de Google Maps"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto CTA WhatsApp",
      "default": "AGENDAR VISITA →"
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "Número de WhatsApp",
      "default": "51999999999"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje de WhatsApp",
      "default": "Hola, quiero agendar una visita al showroom de BORREGO."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "container_background_color",
      "label": "Color de contenedor",
      "default": "rgba(232, 226, 213, 0.06)"
    },
    {
      "type": "color",
      "id": "map_background_color",
      "label": "Color fondo mapa",
      "default": "#171711"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color etiqueta",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color título",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color descripción",
      "default": "rgba(242, 236, 221, 0.68)"
    },
    {
      "type": "color",
      "id": "info_label_color",
      "label": "Color etiqueta info",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "info_text_color",
      "label": "Color texto info",
      "default": "rgba(242, 236, 221, 0.72)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color texto botón",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Color línea botón",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Color texto hover botón",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Color línea hover botón",
      "default": "#F2ECDD"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Opacidad overlay mapa",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "enable_blur",
      "label": "Activar efecto blur",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 32,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 32,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Radio de bordes",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "shadow_intensity",
      "label": "Intensidad sombra",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Activar animación",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HANAN Showroom Location"
    }
  ]
}
{% endschema %}