{%- liquid
  assign section_id = 'hanan-dev-community-gallery-' | append: section.id
  assign cta_url = section.settings.cta_link | default: '#'
-%}

<section
  id="{{ section_id }}"
  class="hanan-dev-community-gallery hanan-dev-community-gallery--align-{{ section.settings.header_alignment }}"
  style="
    --hanan-dev-community-bg: {{ section.settings.background_color }};
    --hanan-dev-community-text: {{ section.settings.text_color }};
    --hanan-dev-community-accent: {{ section.settings.accent_color }};
    --hanan-dev-community-max-width: {{ section.settings.section_max_width }}px;
    --hanan-dev-community-padding-desktop: {{ section.settings.padding_desktop }}px;
    --hanan-dev-community-padding-mobile: {{ section.settings.padding_mobile }}px;
    --hanan-dev-community-radius: {{ section.settings.image_border_radius }}px;
    --hanan-dev-community-gap: {{ section.settings.image_gap }}px;
    --hanan-dev-community-desktop-columns: {{ section.settings.desktop_columns }};
    --hanan-dev-community-tablet-columns: {{ section.settings.tablet_columns }};
    --hanan-dev-community-mobile-columns: {{ section.settings.mobile_columns }};
  "
  aria-labelledby="{{ section_id }}-heading"
>
  <div class="hanan-dev-community-gallery__inner">
    <header class="hanan-dev-community-gallery__header">
      <div class="hanan-dev-community-gallery__header-content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hanan-dev-community-gallery__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 id="{{ section_id }}-heading" class="hanan-dev-community-gallery__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hanan-dev-community-gallery__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_cta and section.settings.button_text != blank -%}
        <div class="hanan-dev-community-gallery__cta-wrapper">
          <a
            href="{{ cta_url }}"
            class="hanan-dev-community-cta"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ section.settings.button_text | escape }}"
          >
            {{ section.settings.button_text }}
          </a>
        </div>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="hanan-dev-community-grid" aria-label="Galería de comunidad BORREGO">
        {%- for block in section.blocks -%}
          {%- liquid
            assign gallery_image = block.settings.image
            assign gallery_alt = block.settings.alt_text | default: block.settings.caption | default: section.settings.heading | escape
          -%}

          {%- if gallery_image != blank -%}
            <figure class="hanan-dev-community-card" {{ block.shopify_attributes }}>
              <div class="hanan-dev-community-card__media hanan-dev-community-card__media--{{ section.settings.image_aspect_ratio }}">
                <img
                  src="{{ gallery_image | image_url: width: 700 }}"
                  srcset="
                    {{ gallery_image | image_url: width: 360 }} 360w,
                    {{ gallery_image | image_url: width: 520 }} 520w,
                    {{ gallery_image | image_url: width: 700 }} 700w,
                    {{ gallery_image | image_url: width: 900 }} 900w,
                    {{ gallery_image | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 749px) 50vw, (max-width: 989px) 33vw, 25vw"
                  alt="{{ gallery_alt }}"
                  width="{{ gallery_image.width }}"
                  height="{{ gallery_image.height }}"
                  loading="lazy"
                  class="hanan-dev-community-card__image"
                >
              </div>

              {%- if block.settings.caption != blank -%}
                <figcaption class="hanan-dev-community-card__caption">
                  {{ block.settings.caption }}
                </figcaption>
              {%- endif -%}
            </figure>
          {%- else -%}
            <figure
              class="hanan-dev-community-card hanan-dev-community-card--placeholder"
              {{ block.shopify_attributes }}
            >
              <div class="hanan-dev-community-card__media hanan-dev-community-card__media--{{ section.settings.image_aspect_ratio }}">
                <div class="hanan-dev-community-card__placeholder" aria-hidden="true">
                  <span>BORREGO</span>
                </div>
              </div>

              {%- if block.settings.caption != blank -%}
                <figcaption class="hanan-dev-community-card__caption">
                  {{ block.settings.caption }}
                </figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="hanan-dev-community-grid hanan-dev-community-grid--empty" aria-hidden="true">
        {%- for index in (1..8) -%}
          <figure class="hanan-dev-community-card hanan-dev-community-card--placeholder">
            <div class="hanan-dev-community-card__media hanan-dev-community-card__media--{{ section.settings.image_aspect_ratio }}">
              <div class="hanan-dev-community-card__placeholder">
                <span>BORREGO</span>
              </div>
            </div>
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--hanan-dev-community-bg);
    color: var(--hanan-dev-community-text);
    padding-top: var(--hanan-dev-community-padding-desktop);
    padding-bottom: var(--hanan-dev-community-padding-desktop);
    overflow: hidden;
  }

  #{{ section_id }} .hanan-dev-community-gallery__inner {
    width: min(100% - 40px, var(--hanan-dev-community-max-width));
    margin: 0 auto;
  }

  #{{ section_id }} .hanan-dev-community-gallery__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 64px);
    margin-bottom: clamp(34px, 5vw, 68px);
  }

  #{{ section_id }} .hanan-dev-community-gallery__header-content {
    max-width: 820px;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-center .hanan-dev-community-gallery__header {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-center .hanan-dev-community-gallery__header-content {
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-right .hanan-dev-community-gallery__header {
    text-align: right;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-right .hanan-dev-community-gallery__header-content {
    margin-left: auto;
  }

  #{{ section_id }} .hanan-dev-community-gallery__eyebrow {
    margin: 0 0 18px;
    color: var(--hanan-dev-community-accent);
    font-size: clamp(11px, 1vw, 13px);
    line-height: 1.2;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 800;
  }

  #{{ section_id }} .hanan-dev-community-gallery__heading {
    margin: 0;
    max-width: 820px;
    color: currentColor;
    font-size: clamp(42px, 6.4vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-center .hanan-dev-community-gallery__heading {
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-right .hanan-dev-community-gallery__heading {
    margin-left: auto;
  }

  #{{ section_id }} .hanan-dev-community-gallery__description {
    margin-top: clamp(22px, 2.8vw, 34px);
    max-width: 620px;
    color: currentColor;
    opacity: 0.76;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.7;
  }

  #{{ section_id }} .hanan-dev-community-gallery__description p {
    margin: 0;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-center .hanan-dev-community-gallery__description {
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }}.hanan-dev-community-gallery--align-right .hanan-dev-community-gallery__description {
    margin-left: auto;
  }

  #{{ section_id }} .hanan-dev-community-gallery__cta-wrapper {
    flex: 0 0 auto;
  }

  #{{ section_id }} .hanan-dev-community-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 16px 28px;
    border-radius: 999px;
    background: var(--hanan-dev-community-accent);
    border: 1px solid var(--hanan-dev-community-accent);
    color: #f2ecdd;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 900;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 180ms ease, background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  #{{ section_id }} .hanan-dev-community-cta:hover {
    transform: translateY(-2px);
    background: currentColor;
    border-color: currentColor;
    background: #11110C;
  }

  #{{ section_id }} .hanan-dev-community-cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #{{ section_id }} .hanan-dev-community-grid {
    display: grid;
    grid-template-columns: repeat(var(--hanan-dev-community-desktop-columns), minmax(0, 1fr));
    gap: var(--hanan-dev-community-gap);
  }

  #{{ section_id }} .hanan-dev-community-card {
    margin: 0;
    min-width: 0;
  }

  #{{ section_id }} .hanan-dev-community-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--hanan-dev-community-radius);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--hanan-dev-community-bg) 86%, var(--hanan-dev-community-text) 14%), color-mix(in srgb, var(--hanan-dev-community-accent) 22%, var(--hanan-dev-community-bg) 78%));
    isolation: isolate;
  }

  #{{ section_id }} .hanan-dev-community-card__media--square {
    aspect-ratio: 1 / 1;
  }

  #{{ section_id }} .hanan-dev-community-card__media--portrait {
    aspect-ratio: 4 / 5;
  }

  #{{ section_id }} .hanan-dev-community-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 360ms ease, filter 360ms ease;
  }

  #{{ section_id }} .hanan-dev-community-card:hover .hanan-dev-community-card__image {
    transform: scale(1.055);
    filter: contrast(1.03);
  }

  #{{ section_id }} .hanan-dev-community-card__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 180px;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at top right, color-mix(in srgb, var(--hanan-dev-community-accent) 26%, transparent), transparent 36%),
      #11110c;
    color: rgba(242, 236, 221, 0.78);
  }

  #{{ section_id }} .hanan-dev-community-card__placeholder span {
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 900;
  }

  #{{ section_id }} .hanan-dev-community-card__caption {
    margin-top: 12px;
    color: currentColor;
    opacity: 0.68;
    font-size: 12px;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .hanan-dev-community-gallery__header {
      flex-direction: column;
      align-items: flex-start;
    }

    #{{ section_id }}.hanan-dev-community-gallery--align-center .hanan-dev-community-gallery__header {
      align-items: center;
    }

    #{{ section_id }}.hanan-dev-community-gallery--align-right .hanan-dev-community-gallery__header {
      align-items: flex-end;
    }

    #{{ section_id }} .hanan-dev-community-grid {
      grid-template-columns: repeat(var(--hanan-dev-community-tablet-columns), minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: var(--hanan-dev-community-padding-mobile);
      padding-bottom: var(--hanan-dev-community-padding-mobile);
    }

    #{{ section_id }} .hanan-dev-community-gallery__inner {
      width: min(100% - 32px, 100%);
    }

    #{{ section_id }} .hanan-dev-community-gallery__header {
      gap: 26px;
      margin-bottom: 30px;
    }

    #{{ section_id }} .hanan-dev-community-gallery__eyebrow {
      margin-bottom: 16px;
    }

    #{{ section_id }} .hanan-dev-community-gallery__heading {
      font-size: clamp(36px, 12vw, 56px);
      line-height: 0.96;
      letter-spacing: -0.05em;
    }

    #{{ section_id }} .hanan-dev-community-gallery__description {
      margin-top: 22px;
      max-width: 100%;
      font-size: 15px;
      line-height: 1.65;
    }

    #{{ section_id }} .hanan-dev-community-gallery__cta-wrapper {
      width: 100%;
    }

    #{{ section_id }} .hanan-dev-community-cta {
      width: 100%;
      min-height: 54px;
      padding-left: 20px;
      padding-right: 20px;
    }

    #{{ section_id }} .hanan-dev-community-grid {
      grid-template-columns: repeat(var(--hanan-dev-community-mobile-columns), minmax(0, 1fr));
      gap: max(10px, calc(var(--hanan-dev-community-gap) * 0.7));
    }

    #{{ section_id }} .hanan-dev-community-card__media {
      border-radius: min(var(--hanan-dev-community-radius), 20px);
    }

    #{{ section_id }} .hanan-dev-community-card__caption {
      margin-top: 8px;
      font-size: 11px;
      line-height: 1.35;
    }
  }
</style>

{% schema %}
{
  "name": "Hanan Community Gallery",
  "tag": "section",
  "class": "section-hanan-dev-community-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Contenido superior"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "BORREGO COMMUNITY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COMUNIDAD BORREGO"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Nuestra comunidad comparte la pasión por los sneakers, el streetwear y las piezas auténticas.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "WhatsApp CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Únete a la comunidad"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Galería"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#A8733D"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "label": "Section max width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Desktop padding",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile padding",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "community_image",
      "name": "Community image",
      "limit": 24,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Momento de la comunidad BORREGO"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Optional caption",
          "default": "BORREGO moment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hanan Community Gallery",
      "blocks": [
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        },
        {
          "type": "community_image"
        }
      ]
    }
  ]
}
{% endschema %}
