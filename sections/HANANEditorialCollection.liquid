{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.78 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.78 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.products_to_show
-%}

<section class="hanan-editorial-collection" id="hanan-editorial-collection-{{ section.id }}">
  <div class="hanan-editorial-collection__inner section-{{ section.id }}-padding">
    <div class="hanan-editorial-collection__top">
      <div class="hanan-editorial-collection__header">
        {% if section.settings.title != blank %}
          <h2 class="hanan-editorial-collection__title">
            {{ section.settings.title }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hanan-editorial-collection__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="hanan-editorial-collection__controls">
        <button class="hanan-editorial-collection__arrow hanan-editorial-collection__arrow--prev" type="button" aria-label="Previous products">
          <span>‹</span>
        </button>

        <button class="hanan-editorial-collection__arrow hanan-editorial-collection__arrow--next" type="button" aria-label="Next products">
          <span>›</span>
        </button>
      </div>
    </div>

    <div class="hanan-editorial-slider-wrapper">
      <div class="hanan-editorial-slider">
        {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
          {% for product in section.settings.collection.products limit: products_to_display %}
            <a href="{{ product.url }}" class="hanan-product-card" style="--delay: {{ forloop.index0 }};">
              <div class="hanan-product-card__media">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      widths: '600, 800, 1000, 1200, 1500',
                      sizes: '(max-width: 749px) 84vw, 42vw',
                      class: 'hanan-product-card__image'
                  }}
                {% endif %}

                <div class="hanan-product-card__overlay"></div>
                <span class="hanan-product-card__view">VIEW PRODUCT →</span>
              </div>

              <div class="hanan-product-card__content">
                <h3 class="hanan-product-card__title">
                  {{ product.title }}
                </h3>

                <span class="hanan-product-card__price">
                  {{ product.price | money }}
                </span>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .hanan-editorial-collection {
    background: #11110C;
    color: #F2ECDD;
    overflow: hidden;
  }

  .hanan-editorial-collection__inner {
    width: 100%;
  }

  .hanan-editorial-collection__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding: 0 5vw;
    margin-bottom: 42px;
  }

  .hanan-editorial-collection__header {
    display: flex;
    align-items: flex-end;
    gap: 28px;
  }

  .hanan-editorial-collection__title {
    margin: 0;
    color: #F2ECDD;
    font-size: clamp(28px, 3vw, 48px);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-editorial-collection__description {
    max-width: 340px;
    color: rgba(242, 236, 221, 0.68);
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .hanan-editorial-collection__description p {
    margin: 0;
  }

  .hanan-editorial-collection__controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hanan-editorial-collection__arrow {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    border: 1px solid rgba(242, 236, 221, 0.28);
    background: rgba(242, 236, 221, 0.04);
    color: #F2ECDD;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 500ms cubic-bezier(0.16, 1, 0.3, 1), border-color 500ms cubic-bezier(0.16, 1, 0.3, 1), transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-editorial-collection__arrow span {
    display: block;
    font-size: 24px;
    line-height: 1;
    transform: translateY(-1px);
  }

  .hanan-editorial-collection__arrow:hover {
    background: #F2ECDD;
    color: #11110C;
    border-color: #F2ECDD;
    transform: translateY(-2px);
  }

  .hanan-editorial-slider-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-left: 5vw;
  }

  .hanan-editorial-slider-wrapper::-webkit-scrollbar {
    display: none;
  }

  .hanan-editorial-slider {
    display: flex;
    gap: 34px;
    width: max-content;
    padding-right: 5vw;
  }

  .hanan-product-card {
    width: min(43vw, 610px);
    min-width: min(43vw, 610px);
    text-decoration: none;
    color: #F2ECDD;
    opacity: 0;
    transform: translateY(32px);
    animation: hananProductReveal 1100ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--delay) * 120ms);
  }

  .hanan-product-card__media {
    position: relative;
    aspect-ratio: 0.86;
    overflow: hidden;
    background: linear-gradient(135deg, #F2ECDD 0%, #ECE5D8 100%);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28);
  }

  .hanan-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 9%;
    transform: scale(1);
    filter: contrast(1.02) saturate(0.96);
    transition: transform 1300ms cubic-bezier(0.16, 1, 0.3, 1), filter 1300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 22%, rgba(255, 255, 255, 0.28), transparent 34%),
      linear-gradient(180deg, transparent 0%, rgba(17, 17, 12, 0.08) 55%, rgba(17, 17, 12, 0.28) 100%);
    opacity: 0.75;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card__view {
    position: absolute;
    left: 26px;
    bottom: 24px;
    color: #11110C;
    font-size: 10px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card__content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-top: 22px;
  }

  .hanan-product-card__title {
    margin: 0;
    max-width: 70%;
    color: #F2ECDD;
    font-size: 14px;
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hanan-product-card__price {
    color: rgba(242, 236, 221, 0.72);
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.07em;
    white-space: nowrap;
  }

  .hanan-product-card:hover .hanan-product-card__image {
    transform: scale(1.06) translateY(-6px);
    filter: contrast(1.07) saturate(0.98);
  }

  .hanan-product-card:hover .hanan-product-card__overlay {
    opacity: 1;
  }

  .hanan-product-card:hover .hanan-product-card__view {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes hananProductReveal {
    from {
      opacity: 0;
      transform: translateY(32px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-editorial-collection__top {
      padding: 0 28px;
      margin-bottom: 34px;
    }

    .hanan-editorial-collection__header {
      gap: 20px;
    }

    .hanan-editorial-slider-wrapper {
      padding-left: 28px;
    }

    .hanan-editorial-slider {
      gap: 22px;
      padding-right: 28px;
    }

    .hanan-product-card {
      width: 58vw;
      min-width: 58vw;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-editorial-collection__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
      padding: 0 18px;
      margin-bottom: 30px;
    }

    .hanan-editorial-collection__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .hanan-editorial-collection__title {
      font-size: 30px;
      letter-spacing: 0.1em;
    }

    .hanan-editorial-collection__description {
      font-size: 13px;
      max-width: 100%;
    }

    .hanan-editorial-collection__controls {
      align-self: flex-end;
    }

    .hanan-editorial-collection__arrow {
      width: 38px;
      height: 38px;
    }

    .hanan-editorial-slider-wrapper {
      padding-left: 18px;
    }

    .hanan-editorial-slider {
      gap: 18px;
      padding-right: 18px;
    }

    .hanan-product-card {
      width: 84vw;
      min-width: 84vw;
    }

    .hanan-product-card__media {
      aspect-ratio: 0.82;
    }

    .hanan-product-card__content {
      flex-direction: column;
      gap: 8px;
      padding-top: 16px;
    }

    .hanan-product-card__title {
      max-width: 100%;
      font-size: 13px;
    }

    .hanan-product-card__price {
      font-size: 12px;
    }

    .hanan-product-card__view {
      opacity: 1;
      transform: none;
      left: 20px;
      bottom: 20px;
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-product-card,
    .hanan-product-card__image,
    .hanan-product-card__overlay,
    .hanan-product-card__view,
    .hanan-editorial-collection__arrow {
      animation: none;
      transition: none;
    }

    .hanan-product-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#hanan-editorial-collection-{{ section.id }}');
    if (!section) return;

    const sliderWrapper = section.querySelector('.hanan-editorial-slider-wrapper');
    const nextButton = section.querySelector('.hanan-editorial-collection__arrow--next');
    const prevButton = section.querySelector('.hanan-editorial-collection__arrow--prev');

    if (!sliderWrapper || !nextButton || !prevButton) return;

    const getScrollAmount = () => {
      const card = section.querySelector('.hanan-product-card');
      if (!card) return sliderWrapper.clientWidth * 0.8;
      const gap = window.innerWidth < 750 ? 18 : window.innerWidth < 990 ? 22 : 34;
      return card.offsetWidth + gap;
    };

    nextButton.addEventListener('click', () => {
      sliderWrapper.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth'
      });
    });

    prevButton.addEventListener('click', () => {
      sliderWrapper.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth'
      });
    });
  })();
</script>

{% schema %}
{
  "name": "HANAN Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "NEW ARRIVALS",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Curated sneakers and apparel.</p>",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 88,
      "label": "Top spacing"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96,
      "label": "Bottom spacing"
    }
  ],
  "presets": [
    {
      "name": "HANAN Collection"
    }
  ]
}
{% endschema %}