{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.8 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.products_to_show
-%}

<section class="hanan-editorial-collection color-{{ section.settings.color_scheme }}">
  <div class="hanan-editorial-collection__inner section-{{ section.id }}-padding">

    {% if section.settings.title != blank or section.settings.description != blank %}
      <div class="hanan-editorial-collection__header">
        {% if section.settings.title != blank %}
          <h2 class="hanan-editorial-collection__title">
            {{ section.settings.title }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hanan-editorial-collection__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="hanan-editorial-slider-wrapper">
      <div class="hanan-editorial-slider">
        {% for product in section.settings.collection.products limit: products_to_display %}
          <a
            href="{{ product.url }}"
            class="hanan-product-card"
            style="--delay: {{ forloop.index0 }};"
          >
            <div class="hanan-product-card__media">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 800, 1000, 1200, 1400',
                    sizes: '(max-width: 749px) 82vw, 33vw',
                    class: 'hanan-product-card__image'
                }}
              {% endif %}

              <div class="hanan-product-card__overlay"></div>
            </div>

            <div class="hanan-product-card__content">
              <h3 class="hanan-product-card__title">
                {{ product.title }}
              </h3>

              <div class="hanan-product-card__bottom">
                <span class="hanan-product-card__price">
                  {{ product.price | money }}
                </span>

                <span class="hanan-product-card__cta">
                  VIEW →
                </span>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<style>
  .hanan-editorial-collection {
    background: #11110C;
    overflow: hidden;
  }

  .hanan-editorial-collection__inner {
    width: 100%;
  }

  .hanan-editorial-collection__header {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 68px;
    padding: 0 5vw;
  }

  .hanan-editorial-collection__title {
    margin: 0;
    color: #F2ECDD;
    font-size: clamp(42px, 5vw, 88px);
    line-height: 0.9;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: "Arial Narrow", sans-serif;
    max-width: 8ch;
  }

  .hanan-editorial-collection__description {
    max-width: 520px;
    color: rgba(242, 236, 221, 0.72);
    font-size: 15px;
    line-height: 1.7;
    letter-spacing: 0.04em;
  }

  .hanan-editorial-slider-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    padding-left: 5vw;
  }

  .hanan-editorial-slider-wrapper::-webkit-scrollbar {
    display: none;
  }

  .hanan-editorial-slider {
    display: flex;
    gap: 32px;
    width: max-content;
    padding-right: 5vw;
  }

  .hanan-product-card {
    position: relative;
    width: min(38vw, 560px);
    min-width: 320px;
    text-decoration: none;
    overflow: hidden;
    background: #151512;
    opacity: 0;
    transform: translateY(40px) scale(0.985);
    animation: hananReveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--delay) * 140ms);
  }

  .hanan-product-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 0.78;
    background: #1b1a14;
  }

  .hanan-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.03);
    transition:
      transform 1400ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 1400ms cubic-bezier(0.16, 1, 0.3, 1);
    filter:
      contrast(1.04)
      saturate(0.9)
      brightness(0.88);
  }

  .hanan-product-card__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(17,17,12,0.06) 0%,
        rgba(17,17,12,0.18) 42%,
        rgba(17,17,12,0.82) 100%
      ),
      radial-gradient(
        circle at top,
        rgba(242,236,221,0.06),
        transparent 42%
      );
    transition: opacity 900ms ease;
  }

  .hanan-product-card__content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px 6px 0;
  }

  .hanan-product-card__title {
    margin: 0;
    color: #F2ECDD;
    font-size: 17px;
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hanan-product-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .hanan-product-card__price {
    color: rgba(242,236,221,0.82);
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .hanan-product-card__cta {
    position: relative;
    color: #D9B26F;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(-8px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card:hover .hanan-product-card__image {
    transform: scale(1.09) translateY(-6px);
    filter:
      contrast(1.08)
      saturate(0.92)
      brightness(0.78);
  }

  .hanan-product-card:hover .hanan-product-card__overlay {
    opacity: 0.92;
  }

  .hanan-product-card:hover .hanan-product-card__cta {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes hananReveal {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-editorial-collection__header {
      margin-bottom: 48px;
    }

    .hanan-editorial-slider {
      gap: 22px;
    }

    .hanan-product-card {
      width: 52vw;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-editorial-collection__header {
      gap: 14px;
      margin-bottom: 38px;
      padding: 0 20px;
    }

    .hanan-editorial-collection__title {
      font-size: 40px;
      letter-spacing: 0.07em;
    }

    .hanan-editorial-collection__description {
      font-size: 13px;
      line-height: 1.6;
    }

    .hanan-editorial-slider-wrapper {
      padding-left: 20px;
    }

    .hanan-editorial-slider {
      gap: 16px;
      padding-right: 20px;
    }

    .hanan-product-card {
      width: 82vw;
      min-width: 82vw;
    }

    .hanan-product-card__content {
      padding-top: 18px;
      gap: 16px;
    }

    .hanan-product-card__title {
      font-size: 15px;
      line-height: 1.4;
    }

    .hanan-product-card__bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .hanan-product-card__price {
      font-size: 13px;
    }

    .hanan-product-card__cta {
      opacity: 1;
      transform: none;
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-product-card,
    .hanan-product-card__image,
    .hanan-product-card__overlay,
    .hanan-product-card__cta {
      animation: none;
      transition: none;
    }

    .hanan-product-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "NEW ARRIVALS",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Curated sneakers and apparel.</p>",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 120,
      "label": "Top spacing"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 120,
      "label": "Bottom spacing"
    }
  ],
  "presets": [
    {
      "name": "HANAN Collection"
    }
  ]
}
{% endschema %}