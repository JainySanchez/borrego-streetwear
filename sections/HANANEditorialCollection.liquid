{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.72 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.78 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign products_to_display = section.settings.products_to_show
-%}

<section class="hanan-editorial-collection" id="hanan-editorial-collection-{{ section.id }}">
  <div class="hanan-editorial-collection__inner section-{{ section.id }}-padding">
    <div class="hanan-editorial-collection__top">
      <div class="hanan-editorial-collection__header">
        {% if section.settings.title != blank %}
          <h2 class="hanan-editorial-collection__title">
            {{ section.settings.title }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hanan-editorial-collection__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      <div class="hanan-editorial-collection__controls">
        <button class="hanan-editorial-collection__arrow hanan-editorial-collection__arrow--prev" type="button" aria-label="Previous products">
          <span>‹</span>
        </button>

        <button class="hanan-editorial-collection__arrow hanan-editorial-collection__arrow--next" type="button" aria-label="Next products">
          <span>›</span>
        </button>
      </div>
    </div>

    <div class="hanan-editorial-slider-wrapper">
      <div class="hanan-editorial-slider">
        {% if section.settings.collection != blank and section.settings.collection.products.size > 0 %}
          {% for product in section.settings.collection.products limit: products_to_display %}
            <a href="{{ product.url }}" class="hanan-product-card" style="--delay: {{ forloop.index0 }};">
              <div class="hanan-product-card__media">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      widths: '500, 700, 900, 1100, 1400',
                      sizes: '(max-width: 749px) 82vw, 30vw',
                      class: 'hanan-product-card__image'
                  }}
                {% endif %}

                <div class="hanan-product-card__soft-glow"></div>
                <span class="hanan-product-card__view">VIEW PRODUCT →</span>
              </div>

              <div class="hanan-product-card__content">
                <h3 class="hanan-product-card__title">
                  {{ product.title }}
                </h3>

                <span class="hanan-product-card__price">
                  {{ product.price | money }}
                </span>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .hanan-editorial-collection {
    background: #F2ECDD;
    color: #11110C;
    overflow: hidden;
  }

  .hanan-editorial-collection__inner {
    width: 100%;
  }

  .hanan-editorial-collection__top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    padding: 0 5vw;
    margin-bottom: 34px;
  }

  .hanan-editorial-collection__header {
    display: flex;
    align-items: flex-end;
    gap: 24px;
  }

  .hanan-editorial-collection__title {
    margin: 0;
    color: #11110C;
    font-size: clamp(26px, 2.4vw, 38px);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-editorial-collection__description {
    max-width: 340px;
    color: rgba(17, 17, 12, 0.62);
    font-size: 13px;
    line-height: 1.6;
    letter-spacing: 0.04em;
    margin-bottom: 1px;
  }

  .hanan-editorial-collection__description p {
    margin: 0;
  }

  .hanan-editorial-collection__controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hanan-editorial-collection__arrow {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(17, 17, 12, 0.28);
    background: transparent;
    color: #11110C;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 450ms cubic-bezier(0.16, 1, 0.3, 1),
      color 450ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-editorial-collection__arrow span {
    display: block;
    font-size: 23px;
    line-height: 1;
    transform: translateY(-1px);
  }

  .hanan-editorial-collection__arrow:hover {
    background: #11110C;
    color: #F2ECDD;
    transform: translateY(-2px);
  }

  .hanan-editorial-slider-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-left: 5vw;
  }

  .hanan-editorial-slider-wrapper::-webkit-scrollbar {
    display: none;
  }

  .hanan-editorial-slider {
    display: flex;
    gap: 26px;
    width: max-content;
    padding-right: 5vw;
  }

  .hanan-product-card {
    width: calc((90vw - 52px) / 3);
    min-width: calc((90vw - 52px) / 3);
    text-decoration: none;
    color: #11110C;
    opacity: 0;
    transform: translateY(28px);
    animation: hananProductReveal 950ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--delay) * 110ms);
  }

  .hanan-product-card__media {
    position: relative;
    height: clamp(360px, 38vw, 520px);
    overflow: hidden;
    background: linear-gradient(135deg, #ECE5D8 0%, #F7F1E6 100%);
    box-shadow: 0 18px 44px rgba(17, 17, 12, 0.1);
  }

  .hanan-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    padding: 12%;
    transform: scale(0.96);
    filter: contrast(1.02) saturate(0.98);
    transition:
      transform 1100ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 1100ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card__soft-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.34), transparent 36%),
      linear-gradient(180deg, transparent 0%, rgba(17, 17, 12, 0.05) 100%);
    opacity: 0.68;
    transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card__view {
    position: absolute;
    left: 24px;
    bottom: 22px;
    color: #11110C;
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-product-card__content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    padding-top: 18px;
  }

  .hanan-product-card__title {
    margin: 0;
    max-width: 70%;
    color: #11110C;
    font-size: 13px;
    line-height: 1.45;
    font-weight: 800;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .hanan-product-card__price {
    color: rgba(17, 17, 12, 0.64);
    font-size: 13px;
    line-height: 1.45;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .hanan-product-card:hover .hanan-product-card__image {
    transform: scale(1.02) translateY(-4px);
    filter: contrast(1.05) saturate(1);
  }

  .hanan-product-card:hover .hanan-product-card__soft-glow {
    opacity: 0.92;
  }

  .hanan-product-card:hover .hanan-product-card__view {
    opacity: 1;
    transform: translateY(0);
  }

  @keyframes hananProductReveal {
    from {
      opacity: 0;
      transform: translateY(28px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 989px) {
    .hanan-editorial-collection__top {
      padding: 0 28px;
      margin-bottom: 30px;
    }

    .hanan-editorial-collection__header {
      gap: 18px;
    }

    .hanan-editorial-slider-wrapper {
      padding-left: 28px;
    }

    .hanan-editorial-slider {
      gap: 20px;
      padding-right: 28px;
    }

    .hanan-product-card {
      width: 44vw;
      min-width: 44vw;
    }

    .hanan-product-card__media {
      height: 430px;
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-editorial-collection__top {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
      padding: 0 18px;
      margin-bottom: 26px;
    }

    .hanan-editorial-collection__header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .hanan-editorial-collection__title {
      font-size: 28px;
      letter-spacing: 0.09em;
    }

    .hanan-editorial-collection__description {
      font-size: 13px;
      max-width: 100%;
    }

    .hanan-editorial-collection__controls {
      align-self: flex-end;
    }

    .hanan-editorial-collection__arrow {
      width: 38px;
      height: 38px;
    }

    .hanan-editorial-slider-wrapper {
      padding-left: 18px;
    }

    .hanan-editorial-slider {
      gap: 16px;
      padding-right: 18px;
    }

    .hanan-product-card {
      width: 82vw;
      min-width: 82vw;
    }

    .hanan-product-card__media {
      height: 410px;
    }

    .hanan-product-card__image {
      padding: 13%;
      transform: scale(0.95);
    }

    .hanan-product-card__content {
      flex-direction: column;
      gap: 6px;
      padding-top: 14px;
    }

    .hanan-product-card__title {
      max-width: 100%;
      font-size: 12px;
    }

    .hanan-product-card__price {
      font-size: 12px;
    }

    .hanan-product-card__view {
      opacity: 1;
      transform: none;
      left: 20px;
      bottom: 20px;
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-product-card,
    .hanan-product-card__image,
    .hanan-product-card__soft-glow,
    .hanan-product-card__view,
    .hanan-editorial-collection__arrow {
      animation: none;
      transition: none;
    }

    .hanan-product-card {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector('#hanan-editorial-collection-{{ section.id }}');
    if (!section) return;

    const sliderWrapper = section.querySelector('.hanan-editorial-slider-wrapper');
    const nextButton = section.querySelector('.hanan-editorial-collection__arrow--next');
    const prevButton = section.querySelector('.hanan-editorial-collection__arrow--prev');

    if (!sliderWrapper || !nextButton || !prevButton) return;

    const getScrollAmount = () => {
      const card = section.querySelector('.hanan-product-card');
      if (!card) return sliderWrapper.clientWidth * 0.85;
      const gap = window.innerWidth < 750 ? 16 : window.innerWidth < 990 ? 20 : 26;
      return card.offsetWidth + gap;
    };

    nextButton.addEventListener('click', () => {
      sliderWrapper.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth'
      });
    });

    prevButton.addEventListener('click', () => {
      sliderWrapper.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth'
      });
    });
  })();
</script>

{% schema %}
{
  "name": "HANAN Collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "NEW ARRIVALS",
      "label": "Title"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Curated sneakers and apparel.</p>",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 35,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 70,
      "label": "Top spacing"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 92,
      "label": "Bottom spacing"
    }
  ],
  "presets": [
    {
      "name": "HANAN Collection"
    }
  ]
}
{% endschema %}