{% liquid
  assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_message
%}

<section
  class="hanan-private-showroom {% if section.settings.enable_blur %}hanan-private-showroom--blur{% endif %} {% if section.settings.enable_animation %}hanan-private-showroom--animated{% endif %} {% if section.settings.enable_hover %}hanan-private-showroom--hover{% endif %}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --section-glow: {{ section.settings.background_glow_color }};
    --card-bg: {{ section.settings.card_background_color }};
    --card-border: {{ section.settings.card_border_color }};
    --label-color: {{ section.settings.label_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --info-label-color: {{ section.settings.info_label_color }};
    --info-text-color: {{ section.settings.info_text_color }};
    --button-text: {{ section.settings.button_text_color }};
    --button-border: {{ section.settings.button_border_color }};
    --button-hover-text: {{ section.settings.button_hover_text_color }};
    --button-hover-bg: {{ section.settings.button_hover_background_color }};
    --shadow-opacity: {{ section.settings.shadow_intensity | divided_by: 100.0 }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --logo-size-desktop: {{ section.settings.logo_size_desktop }}px;
    --logo-size-mobile: {{ section.settings.logo_size_mobile }}px;
    --logo-opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
  "
>
  <div class="hanan-private-showroom__inner">
    <div class="hanan-private-showroom__card">
      <div class="hanan-private-showroom__ambient"></div>

      {% if section.settings.small_label != blank %}
        <p class="hanan-private-showroom__label">
          {{ section.settings.small_label }}
        </p>
      {% endif %}

      <div class="hanan-private-showroom__logo-wrap">
        {% if section.settings.logo_image != blank %}
          {{
            section.settings.logo_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              widths: '320, 520, 720, 960, 1200',
              sizes: '(max-width: 749px) 78vw, 680px',
              class: 'hanan-private-showroom__logo'
          }}
        {% else %}
          <div class="hanan-private-showroom__logo-placeholder">
            BORREGO
          </div>
        {% endif %}
      </div>

      <div class="hanan-private-showroom__divider"></div>

      {% if section.settings.heading != blank %}
        <h2 class="hanan-private-showroom__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hanan-private-showroom__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="hanan-private-showroom__info">
        {% if section.settings.showroom_address != blank %}
          <div class="hanan-private-showroom__info-item">
            <span>SHOWROOM</span>
            <p>{{ section.settings.showroom_address }}</p>
          </div>
        {% endif %}

        {% if section.settings.showroom_schedule != blank %}
          <div class="hanan-private-showroom__info-item">
            <span>HORARIO</span>
            <p>{{ section.settings.showroom_schedule }}</p>
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank and section.settings.whatsapp_phone != blank %}
        <a
          href="{{ whatsapp_url }}"
          target="_blank"
          rel="noopener"
          class="hanan-private-showroom__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hanan-private-showroom {
    width: 100%;
    position: relative;
    background:
      radial-gradient(circle at 50% 4%, color-mix(in srgb, var(--section-glow) 18%, transparent), transparent 34%),
      radial-gradient(circle at 12% 70%, rgba(242, 236, 221, 0.055), transparent 28%),
      radial-gradient(circle at 88% 62%, rgba(217, 178, 111, 0.075), transparent 30%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent 45%),
      var(--section-bg);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hanan-private-showroom::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.28;
    background-image:
      linear-gradient(rgba(242, 236, 221, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 236, 221, 0.025) 1px, transparent 1px);
    background-size: 80px 80px;
    mask-image: radial-gradient(circle at center, black, transparent 72%);
  }

  .hanan-private-showroom__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 5vw;
    display: flex;
    justify-content: center;
  }

  .hanan-private-showroom__card {
    position: relative;
    width: min(100%, 960px);
    padding: clamp(40px, 5vw, 68px) clamp(24px, 6vw, 86px);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08)),
      var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow:
      0 38px 110px rgba(0, 0, 0, var(--shadow-opacity)),
      0 1px 0 rgba(255, 255, 255, 0.08) inset,
      0 -1px 0 rgba(17, 17, 12, 0.08) inset;
    text-align: center;
    overflow: hidden;
    transition:
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-private-showroom--blur .hanan-private-showroom__card {
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .hanan-private-showroom--hover .hanan-private-showroom__card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 48px 130px rgba(0, 0, 0, calc(var(--shadow-opacity) + 0.08)),
      0 1px 0 rgba(255, 255, 255, 0.1) inset;
  }

  .hanan-private-showroom__ambient {
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(17, 17, 12, 0.08);
    pointer-events: none;
  }

  .hanan-private-showroom__ambient::before,
  .hanan-private-showroom__ambient::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 120px;
    height: 1px;
    transform: translateX(-50%);
    background: linear-gradient(90deg, transparent, var(--button-border), transparent);
    opacity: 0.48;
  }

  .hanan-private-showroom__ambient::before {
    top: -1px;
  }

  .hanan-private-showroom__ambient::after {
    bottom: -1px;
  }

  .hanan-private-showroom__label {
    position: relative;
    z-index: 1;
    margin: 0 0 26px;
    color: var(--label-color);
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .hanan-private-showroom__logo-wrap {
    position: relative;
    z-index: 1;
    width: min(100%, var(--logo-size-desktop));
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .hanan-private-showroom__logo {
    width: 100%;
    max-width: var(--logo-size-desktop);
    height: auto;
    max-height: 210px;
    display: block;
    object-fit: contain;
    object-position: center;
    opacity: var(--logo-opacity);
  /*  filter: drop-shadow(0 18px 32px rgba(17, 17, 12, 0.16));*/
  }

  .hanan-private-showroom__logo-placeholder {
    color: var(--heading-color);
    font-size: clamp(54px, 9vw, 128px);
    line-height: 0.86;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
    opacity: var(--logo-opacity);
  }

  .hanan-private-showroom__divider {
    position: relative;
    z-index: 1;
    width: min(220px, 48%);
    height: 1px;
    margin: 34px auto 28px;
    background: linear-gradient(90deg, transparent, var(--button-border), transparent);
    opacity: 0.68;
  }

  .hanan-private-showroom__heading {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    color: var(--heading-color);
    font-size: clamp(28px, 3.4vw, 50px);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-private-showroom__description {
    position: relative;
    z-index: 1;
    max-width: 620px;
    margin: 20px auto 0;
    color: var(--description-color);
    font-size: 14px;
    line-height: 1.72;
    letter-spacing: 0.035em;
  }

  .hanan-private-showroom__description p {
    margin: 0;
  }

  .hanan-private-showroom__info {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    max-width: 640px;
    margin: 34px auto 0;
    border-top: 1px solid rgba(17, 17, 12, 0.12);
    border-bottom: 1px solid rgba(17, 17, 12, 0.12);
  }

  .hanan-private-showroom__info-item {
    padding: 20px 22px;
  }

  .hanan-private-showroom__info-item + .hanan-private-showroom__info-item {
    border-left: 1px solid rgba(17, 17, 12, 0.12);
  }

  .hanan-private-showroom__info-item span {
    display: block;
    margin-bottom: 8px;
    color: var(--info-label-color);
    font-size: 8.5px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .hanan-private-showroom__info-item p {
    margin: 0;
    color: var(--info-text-color);
    font-size: 12.5px;
    line-height: 1.55;
    letter-spacing: 0.04em;
  }

  .hanan-private-showroom__button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    padding: 0 0 8px;
    color: var(--button-text);
    text-decoration: none;
    font-size: 9px;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    background: transparent;
    transition:
      color 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-private-showroom__button::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(100% - 18px);
    height: 1px;
    background: var(--button-border);
    transform: scaleX(1);
    transform-origin: left;
    transition:
      background 650ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-private-showroom__button:hover {
    color: var(--button-hover-text);
    transform: translateY(-2px);
  }

  .hanan-private-showroom__button:hover::after {
    background: var(--button-hover-bg);
    transform: scaleX(0.62);
  }

  .hanan-private-showroom--animated .hanan-private-showroom__card {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    animation: hananPrivateShowroomReveal 1000ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hananPrivateShowroomReveal {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-private-showroom {
      padding-top: calc(var(--padding-top) * 0.7);
      padding-bottom: calc(var(--padding-bottom) * 0.7);
    }

    .hanan-private-showroom__inner {
      padding: 0 16px;
    }

    .hanan-private-showroom__card {
      padding: 36px 20px;
    }

    .hanan-private-showroom__ambient {
      inset: 12px;
    }

    .hanan-private-showroom__label {
      margin-bottom: 22px;
      font-size: 8px;
      letter-spacing: 0.24em;
    }

    .hanan-private-showroom__logo-wrap {
      width: min(100%, var(--logo-size-mobile));
    }

    .hanan-private-showroom__logo {
      max-width: var(--logo-size-mobile);
      max-height: 130px;
    }

    .hanan-private-showroom__divider {
      margin: 28px auto 24px;
      width: 52%;
    }

    .hanan-private-showroom__heading {
      font-size: 28px;
      letter-spacing: 0.065em;
    }

    .hanan-private-showroom__description {
      margin-top: 16px;
      font-size: 13px;
      line-height: 1.62;
    }

    .hanan-private-showroom__info {
      grid-template-columns: 1fr;
      margin-top: 28px;
    }

    .hanan-private-showroom__info-item {
      padding: 18px 10px;
    }

    .hanan-private-showroom__info-item + .hanan-private-showroom__info-item {
      border-left: 0;
      border-top: 1px solid rgba(17, 17, 12, 0.12);
    }

    .hanan-private-showroom__button {
      margin-top: 28px;
      font-size: 8.5px;
      letter-spacing: 0.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-private-showroom__card,
    .hanan-private-showroom__button {
      animation: none;
      transition: none;
    }

    .hanan-private-showroom--animated .hanan-private-showroom__card {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Private Showroom",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "small_label",
      "label": "Etiqueta pequeña",
      "default": "PRIVATE SHOWROOM EXPERIENCE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "VISITA NUESTRO SHOWROOM"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Agenda una visita y descubre sneakers, apparel y piezas seleccionadas en una experiencia personalizada.</p>"
    },
    {
      "type": "text",
      "id": "showroom_address",
      "label": "Dirección showroom",
      "default": "Av. Example 123, Lima, Perú"
    },
    {
      "type": "text",
      "id": "showroom_schedule",
      "label": "Horario showroom",
      "default": "Lunes a Sábado · 10:00 AM — 8:00 PM"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "AGENDAR VISITA →"
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "Número de WhatsApp",
      "default": "51999999999"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje de WhatsApp",
      "default": "Hola, quiero agendar una visita al showroom de BORREGO."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "background_glow_color",
      "label": "Color de glow",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Color de fondo del card",
      "default": "#F7F3EA"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color de borde del card",
      "default": "rgba(242, 236, 221, 0.18)"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color de etiqueta",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de título",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de descripción",
      "default": "rgba(17, 17, 12, 0.68)"
    },
    {
      "type": "color",
      "id": "info_label_color",
      "label": "Color etiquetas de información",
      "default": "#8A6634"
    },
    {
      "type": "color",
      "id": "info_text_color",
      "label": "Color texto de información",
      "default": "rgba(17, 17, 12, 0.72)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color texto botón",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Color línea botón",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Color texto hover botón",
      "default": "#8A6634"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Color línea hover botón",
      "default": "#11110C"
    },
    {
      "type": "range",
      "id": "shadow_intensity",
      "label": "Intensidad de sombra",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "enable_blur",
      "label": "Activar efecto blur",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_hover",
      "label": "Activar hover",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 32,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 76
    },
    {
      "type": "range",
      "id": "logo_size_desktop",
      "label": "Tamaño logo desktop",
      "min": 220,
      "max": 820,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "label": "Tamaño logo mobile",
      "min": 160,
      "max": 380,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Opacidad logo",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Activar animación",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HANAN Private Showroom"
    }
  ]
}
{% endschema %}