{% liquid
  assign whatsapp_phone = section.settings.whatsapp_phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign whatsapp_message = section.settings.whatsapp_message | url_encode
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_phone | append: '?text=' | append: whatsapp_message
%}

<section
  class="hanan-private-showroom {% if section.settings.enable_blur %}hanan-private-showroom--blur{% endif %} {% if section.settings.enable_animation %}hanan-private-showroom--animated{% endif %}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --card-bg: {{ section.settings.card_background_color }};
    --card-border: {{ section.settings.card_border_color }};
    --label-color: {{ section.settings.label_color }};
    --heading-color: {{ section.settings.heading_color }};
    --description-color: {{ section.settings.description_color }};
    --button-text: {{ section.settings.button_text_color }};
    --button-border: {{ section.settings.button_border_color }};
    --button-hover-text: {{ section.settings.button_hover_text_color }};
    --button-hover-bg: {{ section.settings.button_hover_background_color }};
    --shadow-opacity: {{ section.settings.shadow_intensity | divided_by: 100.0 }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --logo-size-desktop: {{ section.settings.logo_size_desktop }}px;
    --logo-size-mobile: {{ section.settings.logo_size_mobile }}px;
  "
>
  <div class="hanan-private-showroom__inner">
    <div class="hanan-private-showroom__card">
      <div class="hanan-private-showroom__logo-wrap">
        {% if section.settings.logo_image != blank %}
          {{
            section.settings.logo_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '260, 420, 620, 760, 900',
              sizes: '(max-width: 749px) 70vw, 520px',
              class: 'hanan-private-showroom__logo'
          }}
        {% else %}
          <div class="hanan-private-showroom__logo-placeholder">
            BORREGO
          </div>
        {% endif %}
      </div>

      <div class="hanan-private-showroom__divider"></div>

      {% if section.settings.small_label != blank %}
        <p class="hanan-private-showroom__label">
          {{ section.settings.small_label }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hanan-private-showroom__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hanan-private-showroom__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.whatsapp_phone != blank %}
        <a
          href="{{ whatsapp_url }}"
          target="_blank"
          rel="noopener"
          class="hanan-private-showroom__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .hanan-private-showroom {
    width: 100%;
    background:
      radial-gradient(circle at 50% 0%, rgba(217, 178, 111, 0.09), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent 44%),
      var(--section-bg);
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
    overflow: hidden;
  }

  .hanan-private-showroom__inner {
    width: 100%;
    padding: 0 5vw;
    display: flex;
    justify-content: center;
  }

  .hanan-private-showroom__card {
    position: relative;
    width: min(100%, 880px);
    padding: clamp(42px, 6vw, 76px) clamp(26px, 6vw, 84px);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0)),
      var(--card-bg);
    border: 1px solid var(--card-border);
    box-shadow:
      0 34px 90px rgba(0, 0, 0, var(--shadow-opacity)),
      inset 0 1px 0 rgba(242, 236, 221, 0.055);
    text-align: center;
    overflow: hidden;
  }

  .hanan-private-showroom--blur .hanan-private-showroom__card {
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .hanan-private-showroom__card::before,
  .hanan-private-showroom__card::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }

  .hanan-private-showroom__card::before {
    inset: 18px;
    border: 1px solid rgba(242, 236, 221, 0.055);
  }

  .hanan-private-showroom__card::after {
    width: 220px;
    height: 220px;
    right: -80px;
    top: -90px;
    background: radial-gradient(circle, rgba(217, 178, 111, 0.12), transparent 68%);
  }

  .hanan-private-showroom__logo-wrap {
    position: relative;
    z-index: 1;
    width: min(100%, var(--logo-size-desktop));
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .hanan-private-showroom__logo {
    width: 100%;
    max-width: var(--logo-size-desktop);
    height: auto;
    max-height: 180px;
    display: block;
    object-fit: contain;
    object-position: center;
    opacity: 0.92;
  }

  .hanan-private-showroom__logo-placeholder {
    color: var(--heading-color);
    font-size: clamp(42px, 8vw, 96px);
    line-height: 0.9;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
    opacity: 0.92;
  }

  .hanan-private-showroom__divider {
    position: relative;
    z-index: 1;
    width: 76px;
    height: 1px;
    margin: 34px auto 28px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--button-border),
      transparent
    );
    opacity: 0.8;
  }

  .hanan-private-showroom__label {
    position: relative;
    z-index: 1;
    margin: 0 0 18px;
    color: var(--label-color);
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .hanan-private-showroom__heading {
    position: relative;
    z-index: 1;
    max-width: 620px;
    margin: 0 auto;
    color: var(--heading-color);
    font-size: clamp(30px, 4vw, 56px);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-family: "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  }

  .hanan-private-showroom__description {
    position: relative;
    z-index: 1;
    max-width: 520px;
    margin: 22px auto 0;
    color: var(--description-color);
    font-size: 14px;
    line-height: 1.7;
    letter-spacing: 0.035em;
  }

  .hanan-private-showroom__description p {
    margin: 0;
  }

  .hanan-private-showroom__button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 34px;
    min-height: 46px;
    padding: 15px 28px;
    border: 1px solid var(--button-border);
    color: var(--button-text);
    text-decoration: none;
    font-size: 9px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    background: transparent;
    transition:
      background 600ms cubic-bezier(0.16, 1, 0.3, 1),
      color 600ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hanan-private-showroom__button:hover {
    background: var(--button-hover-bg);
    color: var(--button-hover-text);
    border-color: var(--button-hover-bg);
    transform: translateY(-2px);
  }

  .hanan-private-showroom--animated .hanan-private-showroom__card {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    animation: hananPrivateShowroomReveal 1000ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hananPrivateShowroomReveal {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 749px) {
    .hanan-private-showroom {
      padding-top: calc(var(--padding-top) * 0.72);
      padding-bottom: calc(var(--padding-bottom) * 0.72);
    }

    .hanan-private-showroom__inner {
      padding: 0 16px;
    }

    .hanan-private-showroom__card {
      padding: 38px 22px;
    }

    .hanan-private-showroom__logo-wrap {
      width: min(100%, var(--logo-size-mobile));
    }

    .hanan-private-showroom__logo {
      max-width: var(--logo-size-mobile);
      max-height: 120px;
    }

    .hanan-private-showroom__divider {
      margin: 28px auto 24px;
    }

    .hanan-private-showroom__label {
      margin-bottom: 14px;
      font-size: 8px;
      letter-spacing: 0.24em;
    }

    .hanan-private-showroom__heading {
      font-size: 30px;
      letter-spacing: 0.065em;
    }

    .hanan-private-showroom__description {
      margin-top: 18px;
      font-size: 13px;
      line-height: 1.62;
    }

    .hanan-private-showroom__button {
      width: 100%;
      margin-top: 28px;
      padding: 15px 18px;
      font-size: 8.5px;
      letter-spacing: 0.2em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hanan-private-showroom__card,
    .hanan-private-showroom__button {
      animation: none;
      transition: none;
    }

    .hanan-private-showroom--animated .hanan-private-showroom__card {
      opacity: 1;
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "HANAN Private Showroom",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "small_label",
      "label": "Etiqueta pequeña",
      "default": "PRIVATE SHOWROOM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "VISITA NUESTRO SHOWROOM"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Descripción",
      "default": "<p>Agenda una visita y descubre sneakers, apparel y piezas seleccionadas en una experiencia personalizada.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "AGENDAR VISITA →"
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "Número de WhatsApp",
      "default": "51999999999"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje de WhatsApp",
      "default": "Hola, quiero agendar una visita al showroom de BORREGO."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Color de fondo del card",
      "default":"#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Color de borde del card",
      "default": "rgba(242, 236, 221, 0.14)"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Color de etiqueta",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color de título",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color de descripción",
      "default": "rgba(242, 236, 221, 0.68)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Color texto botón",
      "default": "#F2ECDD"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Color borde botón",
      "default": "#D9B26F"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Color texto hover botón",
      "default": "#11110C"
    },
    {
      "type": "color",
      "id": "button_hover_background_color",
      "label": "Color fondo hover botón",
      "default": "#D9B26F"
    },
    {
      "type": "range",
      "id": "shadow_intensity",
      "label": "Intensidad de sombra",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "enable_blur",
      "label": "Activar efecto blur",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 32,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 32,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "logo_size_desktop",
      "label": "Tamaño logo desktop",
      "min": 180,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "label": "Tamaño logo mobile",
      "min": 140,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Activar animación",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "HANAN Private Showroom"
    }
  ]
}
{% endschema %}