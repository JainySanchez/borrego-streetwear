{%- liquid
  assign desktop_menu = section.settings.menu
  assign mobile_menu = section.settings.mobile_menu
  if mobile_menu == blank
    assign mobile_menu = desktop_menu
  endif

  assign transparent_home = false
  if request.page_type == 'index' and section.settings.transparent_on_home
    assign transparent_home = true
  endif
-%}

{% style %}
  #hanan-dev-borrego-header-{{ section.id }} {
    --hanan-dev-header-bg: {{ section.settings.header_background }};
    --hanan-dev-header-text: {{ section.settings.header_text_color }};
    --hanan-dev-header-hover: {{ section.settings.header_hover_color }};
    --hanan-dev-header-scrolled-bg: {{ section.settings.header_scrolled_background }};
    --hanan-dev-transparent-text: {{ section.settings.transparent_text_color }};
    --hanan-dev-logo-desktop-width: {{ section.settings.logo_width_desktop }}px;
    --hanan-dev-logo-mobile-width: {{ section.settings.logo_width_mobile }}px;
    --hanan-dev-mobile-community-icon: {{ section.settings.mobile_community_icon_color }};
    --hanan-dev-mobile-community-text: {{ section.settings.mobile_community_text_color }};
    position: relative;
    z-index: 40;
  }

  {%- if transparent_home -%}
    #shopify-section-{{ section.id }} {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      background: transparent;
    }
  {%- endif -%}

  body.hanan-dev-header-lock {
    overflow: hidden;
  }

  .hanan-dev-borrego-header {
    color: var(--hanan-dev-header-text);
    background: transparent;
  }

  .hanan-dev-header-shell {
    position: sticky;
    top: 0;
    z-index: 8;
    background: var(--hanan-dev-header-bg);
    color: var(--hanan-dev-header-text);
    transition: background 180ms ease, color 180ms ease, backdrop-filter 180ms ease, box-shadow 180ms ease;
  }

  .hanan-dev-borrego-header.is-transparent .hanan-dev-header-shell {
    position: fixed;
    left: 0;
    right: 0;
    width: 100%;
  }

  .hanan-dev-borrego-header.is-transparent:not(.is-scrolled) .hanan-dev-header-shell {
    background: transparent;
    color: var(--hanan-dev-transparent-text);
    backdrop-filter: none;
    box-shadow: none;
  }

  .hanan-dev-borrego-header.is-scrolled .hanan-dev-header-shell,
  .hanan-dev-borrego-header.is-mobile-open .hanan-dev-header-shell {
    background: {{ section.settings.header_scrolled_background | color_modify: 'alpha', 0.92 }};
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 rgba(242, 236, 221, 0.08);
  }

  .hanan-dev-header-bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: 7.8rem;
    max-width: 152rem;
    margin: 0 auto;
    padding: 0 3.2rem;
    gap: 2rem;
  }

  .hanan-dev-desktop-nav-list,
  .hanan-dev-header-icons,
  .hanan-dev-mobile-nav,
  .hanan-dev-mobile-subnav,
  .hanan-dev-mobile-actions,
  .hanan-dev-mobile-socials {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hanan-dev-desktop-nav {
    justify-self: start;
  }

  .hanan-dev-desktop-nav-list {
    display: flex;
    align-items: center;
    gap: 2.8rem;
  }

  .hanan-dev-desktop-link,
  .hanan-dev-header-icon,
  .hanan-dev-mobile-toggle,
  .hanan-dev-mobile-close,
  .hanan-dev-mobile-link,
  .hanan-dev-mobile-parent-button,
  .hanan-dev-mobile-subnav-link,
  .hanan-dev-mobile-action,
  .hanan-dev-mobile-social-link,
  .hanan-dev-mobile-community-link {
    color: currentColor;
    text-decoration: none;
  }

  .hanan-dev-desktop-link {
    display: inline-flex;
    align-items: center;
    min-height: 7.8rem;
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 160ms ease;
  }

  .hanan-dev-desktop-link:hover,
  .hanan-dev-desktop-link:focus-visible,
  .hanan-dev-header-icon:hover,
  .hanan-dev-header-icon:focus-visible,
  .hanan-dev-mobile-link:hover,
  .hanan-dev-mobile-link:focus-visible,
  .hanan-dev-mobile-parent-button:hover,
  .hanan-dev-mobile-parent-button:focus-visible,
  .hanan-dev-mobile-subnav-link:hover,
  .hanan-dev-mobile-subnav-link:focus-visible,
  .hanan-dev-mobile-action:hover,
  .hanan-dev-mobile-action:focus-visible,
  .hanan-dev-mobile-social-link:hover,
  .hanan-dev-mobile-social-link:focus-visible {
    color: var(--hanan-dev-header-hover);
  }

  .hanan-dev-logo {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 9rem;
    color: currentColor;
    text-align: center;
    text-decoration: none;
  }

  .hanan-dev-logo-image {
    display: block;
    width: var(--hanan-dev-logo-desktop-width);
    max-width: 28vw;
    height: auto;
  }

  .hanan-dev-logo-image--transparent,
  .hanan-dev-logo-image--mobile {
    display: none;
  }

  .hanan-dev-borrego-header.is-transparent:not(.is-scrolled) .hanan-dev-logo-image--primary.has-transparent-logo {
    display: none;
  }

  .hanan-dev-borrego-header.is-transparent:not(.is-scrolled) .hanan-dev-logo-image--transparent {
    display: block;
  }

  .hanan-dev-logo-text {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hanan-dev-header-utilities {
    justify-self: end;
  }

  .hanan-dev-header-icons {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.4rem;
  }

  .hanan-dev-header-icon,
  .hanan-dev-mobile-toggle,
  .hanan-dev-mobile-close {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    transition: color 160ms ease;
  }

  .hanan-dev-header-icon svg,
  .hanan-dev-mobile-toggle svg,
  .hanan-dev-mobile-close svg,
  .hanan-dev-mobile-action svg,
  .hanan-dev-mobile-social-link svg {
    display: block;
    width: 3rem;
    height: 3rem;
  }

  .hanan-dev-header-icon .svg-wrapper,
  .hanan-dev-mobile-toggle .svg-wrapper,
  .hanan-dev-mobile-close .svg-wrapper,
  .hanan-dev-mobile-action .svg-wrapper {
    display: inline-flex;
    width: 2.2rem;
    height: 2.2rem;
  }

  .hanan-dev-cart-icon svg {
    width: 2.2rem;
    height: 2.2rem;
    overflow: visible;
  }

  .hanan-dev-cart-count {
    position: absolute;
    top: 0.1rem;
    right: 0;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--hanan-dev-header-hover);
    color: #11110c;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.8rem;
    text-align: center;
  }

  .hanan-dev-mobile-toggle,
  .hanan-dev-mobile-close,
  .hanan-dev-mobile-cart {
    display: none;
  }

  .hanan-dev-header-drawer {
    position: fixed;
    inset: 0;
    z-index: 20;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .hanan-dev-borrego-header.is-mobile-open .hanan-dev-header-drawer {
    pointer-events: auto;
    opacity: 1;
  }

  .hanan-dev-drawer-overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(17, 17, 12, 0.64);
    cursor: pointer;
  }

  .hanan-dev-drawer-panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    flex-direction: column;
    width: min(100%, 48rem);
    max-width: 100vw;
    background: #11110c;
    color: #f2ecdd;
    transform: translateX(100%);
    transition: transform 220ms ease;
  }

  .hanan-dev-borrego-header.is-mobile-open .hanan-dev-drawer-panel {
    transform: translateX(0);
  }

  .hanan-dev-drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.8rem 2rem;
  }

  .hanan-dev-drawer-kicker {
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hanan-dev-drawer-scroll {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.6rem 2rem 2.4rem;
  }

  .hanan-dev-mobile-nav {
    display: grid;
    gap: 0.2rem;
  }

  .hanan-dev-mobile-nav-item {
    border-bottom: 1px solid rgba(242, 236, 221, 0.08);
  }

  .hanan-dev-mobile-link,
  .hanan-dev-mobile-parent-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 5.8rem;
    padding: 1.4rem 0;
    border: 0;
    background: transparent;
    color: currentColor;
    font: inherit;
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }

  .hanan-dev-mobile-parent-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    flex: 0 0 auto;
    margin-left: 1.2rem;
    transition: transform 160ms ease;
  }

  .hanan-dev-mobile-parent-button[aria-expanded='true'] .hanan-dev-mobile-parent-icon {
    transform: rotate(180deg);
  }

  .hanan-dev-mobile-parent-icon svg {
    width: 1.7rem;
    height: 1.7rem;
  }

  .hanan-dev-mobile-subnav {
    display: grid;
    gap: 0.9rem;
    max-height: 0;
    overflow: hidden;
    padding: 0;
    opacity: 0;
    transform: translateY(-0.4rem);
    transition: max-height 220ms ease, opacity 180ms ease, transform 180ms ease, padding 180ms ease;
  }

  .hanan-dev-mobile-subnav.is-open {
    max-height: 48rem;
    padding: 0 0 1.8rem 1.4rem;
    opacity: 1;
    transform: translateY(0);
  }

  .hanan-dev-mobile-subnav-link {
    display: inline-flex;
    width: fit-content;
    max-width: 100%;
    font-size: 1.45rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
  }

  .hanan-dev-mobile-footer {
    margin-top: auto;
    padding-top: 3.6rem;
  }

.hanan-dev-mobile-community-link {
  display: flex;
  align-items: center;
  gap: 1rem;
  width: fit-content;
  max-width: 100%;
  min-height: 4.8rem;
  margin-bottom: 2.4rem;
  padding: 1.1rem 1.4rem;
  border: 1px solid rgba(217, 178, 111, 0.42);
  border-radius: 999px;
  background: rgba(217, 178, 111, 0.12);
  color: var(--hanan-dev-mobile-community-text);
  font-size: 1.05rem;
  font-weight: 900;
  letter-spacing: 0.13em;
  line-height: 1.25;
  text-transform: uppercase;
  box-shadow: 0 0 0 1px rgba(242, 236, 221, 0.03), 0 12px 28px rgba(0, 0, 0, 0.22);
  transition: opacity 160ms ease, color 160ms ease, transform 160ms ease, background 160ms ease, border-color 160ms ease;
}

.hanan-dev-mobile-community-link::after {
  content: "↗";
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-left: 0.2rem;
  color: var(--hanan-dev-mobile-community-icon);
  font-size: 1.2rem;
  line-height: 1;
}

.hanan-dev-mobile-community-link:hover,
.hanan-dev-mobile-community-link:focus-visible {
  opacity: 1;
  color: var(--hanan-dev-header-hover);
  background: rgba(217, 178, 111, 0.18);
  border-color: rgba(217, 178, 111, 0.75);
  transform: translateY(-0.2rem);
}

.hanan-dev-mobile-community-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.8rem;
  height: 2.8rem;
  flex: 0 0 2.8rem;
  color: var(--hanan-dev-mobile-community-icon);
  border-radius: 999px;
  background: rgba(217, 178, 111, 0.16);
}

.hanan-dev-mobile-community-icon svg {
  display: block;
  width: 2rem;
  height: 2rem;
  fill: currentColor;
}

  .hanan-dev-mobile-community-text {
    display: inline-block;
    min-width: 0;
  }

  .hanan-dev-mobile-socials {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-bottom: 2.4rem;
  }

  .hanan-dev-mobile-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    color: rgba(242, 236, 221, 0.86);
    transition: color 160ms ease, transform 160ms ease;
  }

  .hanan-dev-mobile-social-link:hover,
  .hanan-dev-mobile-social-link:focus-visible {
    transform: translateY(-0.1rem);
  }

  .hanan-dev-mobile-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hanan-dev-mobile-action {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4rem;
    padding: 0 1.2rem;
    border: 1px solid rgba(242, 236, 221, 0.12);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hanan-dev-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hanan-dev-borrego-header :focus-visible {
    outline: 0.2rem solid var(--hanan-dev-header-hover);
    outline-offset: 0.3rem;
  }

  @media screen and (max-width: 989px) {
    .hanan-dev-header-bar {
      min-height: 6.4rem;
      padding: 0 1.6rem;
      grid-template-columns: 4rem minmax(0, 1fr) 4rem;
    }

    .hanan-dev-desktop-nav,
    .hanan-dev-header-utilities {
      display: none;
    }

    .hanan-dev-mobile-toggle,
    .hanan-dev-mobile-close,
    .hanan-dev-mobile-cart {
      display: inline-flex;
    }

    .hanan-dev-mobile-toggle {
      justify-self: start;
    }

    .hanan-dev-mobile-cart {
      justify-self: end;
    }

    .hanan-dev-header-icon svg,
    .hanan-dev-mobile-toggle svg,
    .hanan-dev-mobile-close svg,
    .hanan-dev-mobile-action svg,
    .hanan-dev-cart-icon svg {
      width: 2.4rem;
      height: 2.4rem;
    }

    .hanan-dev-header-icon .svg-wrapper,
    .hanan-dev-mobile-toggle .svg-wrapper,
    .hanan-dev-mobile-close .svg-wrapper,
    .hanan-dev-mobile-action .svg-wrapper {
      width: 2.4rem;
      height: 2.4rem;
    }

    .hanan-dev-logo-image {
      width: var(--hanan-dev-logo-mobile-width);
      max-width: 42vw;
    }

    .hanan-dev-logo-image--primary.has-mobile-logo,
    .hanan-dev-borrego-header.is-transparent:not(.is-scrolled) .hanan-dev-logo-image--transparent.has-mobile-logo {
      display: none;
    }

    .hanan-dev-logo-image--mobile {
      display: block;
    }
  }

  @media screen and (min-width: 990px) {
    .hanan-dev-mobile-cart {
      display: none;
    }
  }
{% endstyle %}

<hanan-dev-borrego-header
  id="hanan-dev-borrego-header-{{ section.id }}"
  class="hanan-dev-borrego-header{% if transparent_home %} is-transparent{% endif %}"
>
  <div class="hanan-dev-header-shell">
    <div class="hanan-dev-header-bar">
      <button
        type="button"
        class="hanan-dev-mobile-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="hanan-dev-header-drawer-{{ section.id }}"
        data-hanan-dev-mobile-open
      >
        {{ 'icon-hamburger.svg' | inline_asset_content }}
      </button>

      <nav class="hanan-dev-desktop-nav" aria-label="Main menu">
        <ul class="hanan-dev-desktop-nav-list">
          {%- for link in desktop_menu.links -%}
            <li>
              <a class="hanan-dev-desktop-link" href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <a class="hanan-dev-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- liquid
          assign primary_logo_class = 'hanan-dev-logo-image hanan-dev-logo-image--primary'
          assign transparent_logo_class = 'hanan-dev-logo-image hanan-dev-logo-image--transparent'

          if section.settings.logo_transparent != blank
            assign primary_logo_class = primary_logo_class | append: ' has-transparent-logo'
          endif

          if section.settings.logo_mobile != blank
            assign primary_logo_class = primary_logo_class | append: ' has-mobile-logo'
            assign transparent_logo_class = transparent_logo_class | append: ' has-mobile-logo'
          endif
        -%}

        {%- if section.settings.logo_desktop != blank -%}
          {{
            section.settings.logo_desktop
            | image_url: width: 700
            | image_tag:
              class: primary_logo_class,
              widths: '140, 220, 320, 440, 700',
              sizes: '(min-width: 990px) var(--hanan-dev-logo-desktop-width), var(--hanan-dev-logo-mobile-width)',
              preload: true,
              alt: section.settings.logo_desktop.alt
          }}
        {%- elsif section.settings.logo_transparent != blank -%}
          {{
            section.settings.logo_transparent
            | image_url: width: 700
            | image_tag:
              class: primary_logo_class,
              widths: '140, 220, 320, 440, 700',
              sizes: '(min-width: 990px) var(--hanan-dev-logo-desktop-width), var(--hanan-dev-logo-mobile-width)',
              preload: true,
              alt: section.settings.logo_transparent.alt
          }}
        {%- elsif section.settings.logo_transparent == blank and section.settings.logo_mobile == blank -%}
          <span class="hanan-dev-logo-text">{{ shop.name }}</span>
        {%- endif -%}

        {%- if section.settings.logo_transparent != blank and section.settings.logo_desktop != blank -%}
          {{
            section.settings.logo_transparent
            | image_url: width: 700
            | image_tag:
              class: transparent_logo_class,
              widths: '140, 220, 320, 440, 700',
              sizes: '(min-width: 990px) var(--hanan-dev-logo-desktop-width), var(--hanan-dev-logo-mobile-width)',
              preload: true,
              alt: section.settings.logo_transparent.alt
          }}
        {%- endif -%}

        {%- if section.settings.logo_mobile != blank -%}
          {{
            section.settings.logo_mobile
            | image_url: width: 420
            | image_tag:
              class: 'hanan-dev-logo-image hanan-dev-logo-image--mobile',
              widths: '90, 140, 220, 320, 420',
              sizes: 'var(--hanan-dev-logo-mobile-width)',
              preload: true,
              alt: section.settings.logo_mobile.alt
          }}
        {%- endif -%}
      </a>

      <div class="hanan-dev-header-utilities">
        <ul class="hanan-dev-header-icons">
          <li>
            <a class="hanan-dev-header-icon" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
              {{ 'icon-search.svg' | inline_asset_content }}
            </a>
          </li>
          {%- if section.settings.show_account_icon and shop.customer_accounts_enabled -%}
            <li>
              <a
                class="hanan-dev-header-icon"
                href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
                aria-label="{% if customer %}{{ 'customer.account_fallback' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}"
                rel="nofollow"
              >
                {{ 'icon-account.svg' | inline_asset_content }}
              </a>
            </li>
          {%- endif -%}
          {%- if section.settings.show_wishlist_icon -%}
            <li>
              <a
                class="hanan-dev-header-icon"
                href="{% if section.settings.wishlist_link != blank %}{{ section.settings.wishlist_link }}{% else %}/pages/wishlist{% endif %}"
                aria-label="Wishlist"
              >
                {{ 'icon-heart.svg' | inline_asset_content }}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <a class="hanan-dev-header-icon hanan-dev-mobile-cart" href="{{ routes.search_url }}" aria-label="{{ 'general.search.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>
    </div>
  </div>

  <div class="hanan-dev-header-drawer" id="hanan-dev-header-drawer-{{ section.id }}" data-hanan-dev-drawer>
    <button class="hanan-dev-drawer-overlay" type="button" aria-label="Close menu" data-hanan-dev-mobile-close></button>
    <aside class="hanan-dev-drawer-panel" aria-label="Mobile menu">
      <div class="hanan-dev-drawer-top">
        <span class="hanan-dev-drawer-kicker">Borrego Streetwear</span>
        <button type="button" class="hanan-dev-mobile-close" aria-label="Close menu" data-hanan-dev-mobile-close>
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="hanan-dev-drawer-scroll">
        <nav aria-label="Mobile menu">
          <ul class="hanan-dev-mobile-nav">
            {%- for link in mobile_menu.links -%}
              <li class="hanan-dev-mobile-nav-item">
                {%- if link.links.size > 0 -%}
                  <button
                    type="button"
                    class="hanan-dev-mobile-parent-button"
                    aria-expanded="false"
                    aria-controls="hanan-dev-mobile-subnav-{{ section.id }}-{{ forloop.index }}"
                    data-hanan-dev-accordion-trigger
                  >
                    <span>{{ link.title | escape }}</span>
                    <span class="hanan-dev-mobile-parent-icon" aria-hidden="true">
                      {{ 'icon-caret.svg' | inline_asset_content }}
                    </span>
                  </button>
                  <ul
                    class="hanan-dev-mobile-subnav"
                    id="hanan-dev-mobile-subnav-{{ section.id }}-{{ forloop.index }}"
                    data-hanan-dev-accordion-panel
                  >
                    <li>
                      <a class="hanan-dev-mobile-subnav-link" href="{{ link.url }}" data-hanan-dev-mobile-link>
                        View all {{ link.title | escape }}
                      </a>
                    </li>
                    {%- for child_link in link.links -%}
                      <li>
                        <a class="hanan-dev-mobile-subnav-link" href="{{ child_link.url }}" data-hanan-dev-mobile-link>
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  <a class="hanan-dev-mobile-link" href="{{ link.url }}" data-hanan-dev-mobile-link>
                    {{ link.title | escape }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>

        <div class="hanan-dev-mobile-footer">
          {%- if section.settings.enable_mobile_community_link and section.settings.mobile_community_url != blank -%}
            <a
              class="hanan-dev-mobile-community-link"
              href="{{ section.settings.mobile_community_url }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="{{ section.settings.mobile_community_text | default: 'Únete a nuestra comunidad' | escape }}"
            >
              <span class="hanan-dev-mobile-community-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M12.04 2C6.58 2 2.13 6.42 2.13 11.86c0 1.74.46 3.43 1.34 4.93L2 22l5.35-1.4a9.95 9.95 0 0 0 4.69 1.19h.01c5.46 0 9.91-4.42 9.91-9.86C21.96 6.45 17.51 2 12.04 2Zm.01 18.12h-.01a8.25 8.25 0 0 1-4.2-1.15l-.3-.18-3.18.83.85-3.09-.2-.32a8.13 8.13 0 0 1-1.25-4.35c0-4.51 3.72-8.18 8.3-8.18 2.21 0 4.29.86 5.85 2.4a8.08 8.08 0 0 1 2.43 5.78c0 4.51-3.72 8.26-8.29 8.26Zm4.55-6.18c-.25-.12-1.47-.72-1.7-.8-.23-.08-.4-.12-.56.12-.17.25-.65.8-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.38-2-1.22-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.77-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.08s.89 2.41 1.02 2.58c.12.17 1.76 2.68 4.27 3.76.6.26 1.06.41 1.42.52.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.16-.48-.29Z"></path>
                </svg>
              </span>
              <span class="hanan-dev-mobile-community-text">
                {{ section.settings.mobile_community_text }}
              </span>
            </a>
          {%- endif -%}

          {%- if section.settings.instagram_link != blank or section.settings.tiktok_link != blank or section.settings.whatsapp_link != blank -%}
            <ul class="hanan-dev-mobile-socials" aria-label="Social links">
              {%- if section.settings.instagram_link != blank -%}
                <li>
                  <a class="hanan-dev-mobile-social-link" href="{{ section.settings.instagram_link }}" aria-label="Instagram">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
                      <rect x="4" y="4" width="16" height="16" rx="4.2" stroke="currentColor" stroke-width="1.7"/>
                      <circle cx="12" cy="12" r="3.4" stroke="currentColor" stroke-width="1.7"/>
                      <circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.tiktok_link != blank -%}
                <li>
                  <a class="hanan-dev-mobile-social-link" href="{{ section.settings.tiktok_link }}" aria-label="TikTok">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
                      <path d="M14.3 4V14.1C14.3 17 12.4 19 9.8 19C7.5 19 5.8 17.5 5.8 15.4C5.8 13.2 7.5 11.8 9.8 11.8C10.3 11.8 10.8 11.9 11.2 12.1V8.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M14.3 5.3C15.1 7.6 16.7 9.1 19 9.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.whatsapp_link != blank -%}
                <li>
                  <a class="hanan-dev-mobile-social-link" href="{{ section.settings.whatsapp_link }}" aria-label="WhatsApp">
                    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
                      <path d="M5.6 19L6.5 15.7C5.9 14.7 5.6 13.6 5.6 12.4C5.6 8.8 8.5 5.9 12.1 5.9C15.7 5.9 18.6 8.8 18.6 12.4C18.6 16 15.7 18.9 12.1 18.9C11 18.9 9.9 18.6 9 18.1L5.6 19Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M9.6 10.1C9.8 13 11.4 14.7 14.1 15.2L15.1 14.1L13.7 12.9L13 13.6C11.9 13.1 11.2 12.4 10.8 11.3L11.5 10.6L10.3 9.2L9.6 10.1Z" fill="currentColor"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          {%- endif -%}

          <ul class="hanan-dev-mobile-actions">
            <li>
              <a class="hanan-dev-mobile-action" href="{{ routes.search_url }}" data-hanan-dev-mobile-link>
                {{ 'icon-search.svg' | inline_asset_content }}
                <span>Search</span>
              </a>
            </li>
            {%- if section.settings.show_account_icon and shop.customer_accounts_enabled -%}
              <li>
                <a
                  class="hanan-dev-mobile-action"
                  href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
                  rel="nofollow"
                  data-hanan-dev-mobile-link
                >
                  {{ 'icon-account.svg' | inline_asset_content }}
                  <span>Account</span>
                </a>
              </li>
            {%- endif -%}
            {%- if section.settings.show_wishlist_icon -%}
              <li>
                <a
                  class="hanan-dev-mobile-action"
                  href="{% if section.settings.wishlist_link != blank %}{{ section.settings.wishlist_link }}{% else %}/pages/wishlist{% endif %}"
                  data-hanan-dev-mobile-link
                >
                  {{ 'icon-heart.svg' | inline_asset_content }}
                  <span>Wishlist</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      </div>
    </aside>
  </div>
</hanan-dev-borrego-header>

<script>
  (() => {
    if (customElements.get('hanan-dev-borrego-header')) return;

    class HananDevBorregoHeader extends HTMLElement {
      connectedCallback() {
        this.openButton = this.querySelector('[data-hanan-dev-mobile-open]');
        this.closeButtons = this.querySelectorAll('[data-hanan-dev-mobile-close]');
        this.mobileLinks = this.querySelectorAll('[data-hanan-dev-mobile-link]');
        this.accordionTriggers = this.querySelectorAll('[data-hanan-dev-accordion-trigger]');
        this.onScroll = this.handleScroll.bind(this);
        this.onKeydown = this.handleKeydown.bind(this);

        this.openButton?.addEventListener('click', () => this.openMobileMenu());
        this.closeButtons.forEach((button) => button.addEventListener('click', () => this.closeMobileMenu()));
        this.mobileLinks.forEach((link) => link.addEventListener('click', () => this.closeMobileMenu()));
        this.accordionTriggers.forEach((trigger) => {
          trigger.addEventListener('click', () => this.toggleAccordion(trigger));
        });
        window.addEventListener('scroll', this.onScroll, { passive: true });
        document.addEventListener('keydown', this.onKeydown);
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        document.removeEventListener('keydown', this.onKeydown);
        document.body.classList.remove('hanan-dev-header-lock');
      }

      handleScroll() {
        this.classList.toggle('is-scrolled', window.scrollY > 12);
      }

      handleKeydown(event) {
        if (event.key === 'Escape') this.closeMobileMenu();
      }

      openMobileMenu() {
        this.classList.add('is-mobile-open');
        this.openButton?.setAttribute('aria-expanded', 'true');
        document.body.classList.add('hanan-dev-header-lock');
      }

      closeMobileMenu() {
        this.classList.remove('is-mobile-open');
        this.openButton?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('hanan-dev-header-lock');
      }

      toggleAccordion(trigger) {
        const panelId = trigger.getAttribute('aria-controls');
        const panel = panelId ? this.querySelector(`#${CSS.escape(panelId)}`) : null;
        const expanded = trigger.getAttribute('aria-expanded') === 'true';

        trigger.setAttribute('aria-expanded', String(!expanded));
        panel?.classList.toggle('is-open', !expanded);
      }
    }

    customElements.define('hanan-dev-borrego-header', HananDevBorregoHeader);
  })();
</script>

