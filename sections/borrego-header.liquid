{%- liquid
  assign borrego_menu = section.settings.menu
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --header-bg: {{ section.settings.header_background }};
    --header-sticky-bg: {{ section.settings.header_sticky_background }};
    --header-text: {{ section.settings.header_text_color }};
    --header-icon: {{ section.settings.header_icon_color }};
    --header-transparent-text: {{ section.settings.transparent_text_color }};
    --header-transparent-icon: {{ section.settings.transparent_icon_color }};
    --header-hover: {{ section.settings.header_hover_color }};
    --submenu-bg: {{ section.settings.submenu_background }};
    --submenu-text: {{ section.settings.submenu_text_color }};
    --submenu-hover: {{ section.settings.submenu_hover_color }};
    --divider-color: {{ section.settings.divider_color }};
    --logo-size: {{ section.settings.logo_size }}px;
    --header-height: {{ section.settings.header_height }}px;
    position: relative;
    z-index: 50;
  }

  body.borrego-header-lock {
    overflow: hidden;
  }

  .borrego-header {
    position: {% if section.settings.enable_sticky %}sticky{% else %}relative{% endif %};
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    color: var(--header-text);
    border-bottom: 1px solid var(--divider-color);
    transition: background 360ms ease, color 360ms ease, box-shadow 360ms ease, backdrop-filter 360ms ease, border-color 360ms ease;
  }

  {% if section.settings.enable_transparent_header %}
    .borrego-header {
      background: transparent;
      color: var(--header-transparent-text);
      border-bottom-color: transparent;
    }
  {% endif %}

  .borrego-header.is-scrolled,
  .borrego-header.is-mobile-open {
    background: var(--header-sticky-bg);
    color: var(--header-text);
    border-bottom-color: var(--divider-color);
    box-shadow: 0 10px 34px rgba(17, 17, 12, 0.08);
    {% if section.settings.enable_blur %}
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    {% endif %}
  }

  .borrego-header__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: var(--header-height);
    max-width: 152rem;
    margin: 0 auto;
    padding: 0 {{ section.settings.desktop_spacing }}px;
    gap: 1.4rem;
  }

  .borrego-header__nav-list,
  .borrego-header__utility-list,
  .borrego-header__mobile-list,
  .borrego-header__mobile-sublinks,
  .borrego-header__mobile-socials {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .borrego-header__desktop-nav {
    justify-self: start;
  }

  .borrego-header__nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .borrego-header__nav-item {
    position: relative;
  }

  .borrego-header__nav-link,
  .borrego-header__submenu-link,
  .borrego-header__logo,
  .borrego-header__icon,
  .borrego-header__mobile-link,
  .borrego-header__mobile-summary,
  .borrego-header__mobile-sublink,
  .borrego-header__mobile-social,
  .borrego-header__mobile-toggle,
  .borrego-header__mobile-close {
    color: currentColor;
    text-decoration: none;
  }

  .borrego-header__nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--header-height);
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 1.02rem;
    font-weight: 720;
    letter-spacing: 0.145em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0.92;
    transition: color 320ms ease, opacity 320ms ease;
  }

  .borrego-header__nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 2rem;
    width: 100%;
    height: 1px;
    background: var(--header-hover);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .borrego-header__nav-link:hover,
  .borrego-header__nav-link:focus-visible,
  .borrego-header__nav-item:hover .borrego-header__nav-link {
    color: var(--header-hover);
    opacity: 1;
  }

  .borrego-header__nav-link:hover::after,
  .borrego-header__nav-item:hover .borrego-header__nav-link::after,
  .borrego-header__nav-item:focus-within .borrego-header__nav-link::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .borrego-header__submenu {
    position: absolute;
    top: calc(100% - 1px);
    left: -2rem;
    min-width: 23rem;
    padding: 2.1rem 2.3rem;
    background: var(--submenu-bg);
    color: var(--submenu-text);
    border: 1px solid var(--divider-color);
    box-shadow: 0 24px 60px rgba(17, 17, 12, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 260ms cubic-bezier(0.16, 1, 0.3, 1), transform 260ms cubic-bezier(0.16, 1, 0.3, 1), visibility 260ms ease;
  }

  .borrego-header__nav-item:hover .borrego-header__submenu,
  .borrego-header__nav-item:focus-within .borrego-header__submenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .borrego-header__submenu-list {
    display: grid;
    gap: 1.2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .borrego-header__submenu-link {
    position: relative;
    display: inline-flex;
    width: fit-content;
    color: var(--submenu-text);
    font-size: 1.2rem;
    line-height: 1.3;
    font-weight: 620;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    transition: color 300ms cubic-bezier(0.16, 1, 0.3, 1), transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .borrego-header__submenu-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.4rem;
    width: 100%;
    height: 1px;
    background: var(--submenu-hover);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .borrego-header__submenu-link:hover {
    color: var(--submenu-hover);
    transform: translateX(0.35rem);
  }

  .borrego-header__submenu-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .borrego-header__logo {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .borrego-header__logo-image {
    display: block;
    width: var(--logo-size);
    max-width: 34vw;
    height: auto;
  }

  .borrego-header__logo-text {
    color: currentColor;
    font-size: 1.2rem;
    line-height: 1;
    font-weight: 680;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .borrego-header__utilities {
    justify-self: end;
  }

  .borrego-header__utility-list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  .borrego-header__icon,
  .borrego-header__mobile-toggle,
  .borrego-header__mobile-close {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border: 0;
    background: transparent;
    color: {% if section.settings.enable_transparent_header %}var(--header-transparent-icon){% else %}var(--header-icon){% endif %};
    cursor: pointer;
    transition: color 260ms ease, transform 260ms ease, opacity 260ms ease;
  }

  .borrego-header.is-scrolled .borrego-header__icon,
  .borrego-header.is-scrolled .borrego-header__mobile-toggle,
  .borrego-header.is-scrolled .borrego-header__mobile-close,
  .borrego-header.is-mobile-open .borrego-header__icon,
  .borrego-header.is-mobile-open .borrego-header__mobile-toggle,
  .borrego-header.is-mobile-open .borrego-header__mobile-close {
    color: var(--header-icon);
  }

  .borrego-header__icon:hover,
  .borrego-header__mobile-toggle:hover,
  .borrego-header__mobile-close:hover {
    color: var(--header-hover);
    transform: translateY(-1px);
  }

  .borrego-header__icon svg,
  .borrego-header__mobile-toggle svg,
  .borrego-header__mobile-close svg {
    width: 2.05rem;
    height: 2.05rem;
    stroke-width: 1.7;
  }

  .borrego-header__icon--cart svg {
    width: 2.05rem;
    height: 2.05rem;
    overflow: visible;
  }

  .borrego-header__cart-count {
    position: absolute;
    top: 0.32rem;
    right: 0.25rem;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.35rem;
    border-radius: 999px;
    background: rgba(217, 178, 111, 0.78);
    color: #11110c;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.35rem;
    text-align: center;
  }

  .borrego-header__mobile-toggle,
  .borrego-header__mobile-cart {
    display: none;
  }

  .borrego-header__mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 80;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 280ms ease, visibility 280ms ease;
  }

  .borrego-header.is-mobile-open .borrego-header__mobile-drawer {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .borrego-header__mobile-overlay {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(17, 17, 12, 0.42);
  }

  .borrego-header__mobile-panel {
    position: absolute;
    inset: 0 0 0 auto;
    display: flex;
    flex-direction: column;
    width: min(100%, 45rem);
    background: var(--submenu-bg);
    color: var(--submenu-text);
    transform: translateX(100%);
    transition: transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .borrego-header.is-mobile-open .borrego-header__mobile-panel {
    transform: translateX(0);
  }

  .borrego-header__mobile-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 7rem;
    padding: 0 2rem;
    border-bottom: 1px solid var(--divider-color);
  }

  .borrego-header__mobile-brand {
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .borrego-header__mobile-content {
    flex: 1;
    overflow-y: auto;
    padding: 2.8rem 2rem 2.4rem;
  }

  .borrego-header__mobile-list {
    display: grid;
    gap: 0.2rem;
  }

  .borrego-header__mobile-link,
  .borrego-header__mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.45rem 0;
    border: 0;
    border-bottom: 1px solid var(--divider-color);
    background: transparent;
    color: var(--submenu-text);
    font: inherit;
    font-size: clamp(2.4rem, 7vw, 4rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .borrego-header__mobile-summary::-webkit-details-marker {
    display: none;
  }

  .borrego-header__mobile-summary svg {
    width: 1.6rem;
    height: 1.6rem;
    transition: transform 260ms ease;
  }

  .borrego-header__mobile-details[open] .borrego-header__mobile-summary svg {
    transform: rotate(180deg);
  }

  .borrego-header__mobile-sublinks {
    display: grid;
    gap: 1.1rem;
    padding: 1.5rem 0 2rem;
  }

  .borrego-header__mobile-sublink {
    width: fit-content;
    color: var(--submenu-text);
    font-size: 1.35rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.74;
  }

  .borrego-header__mobile-sublink:hover {
    color: var(--submenu-hover);
    opacity: 1;
  }

  .borrego-header__mobile-footer {
    margin-top: 3.8rem;
    padding-top: 2.4rem;
    border-top: 1px solid var(--divider-color);
  }

  .borrego-header__mobile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin-bottom: 3rem;
  }

  .borrego-header__mobile-social {
    color: var(--submenu-text);
    font-size: 1rem;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .borrego-header__mobile-social:hover {
    color: var(--submenu-hover);
    opacity: 1;
  }

  .borrego-header__mobile-showroom {
    display: grid;
    gap: 0.8rem;
  }

  .borrego-header__mobile-showroom strong {
    color: var(--submenu-hover);
    font-size: 1rem;
    line-height: 1;
    font-weight: 850;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .borrego-header__mobile-showroom span {
    color: var(--submenu-text);
    font-size: 1.25rem;
    line-height: 1.5;
    opacity: 0.72;
  }

  .borrego-header__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .borrego-header :focus-visible {
    outline: 0.2rem solid var(--header-hover);
    outline-offset: 0.3rem;
  }

  @media screen and (max-width: 989px) {
    .borrego-header__bar {
      grid-template-columns: 3.8rem minmax(0, 1fr) 3.8rem;
      min-height: 6.4rem;
      padding: 0 1.2rem;
    }

    .borrego-header__desktop-nav,
    .borrego-header__utilities {
      display: none;
    }

    .borrego-header__mobile-toggle,
    .borrego-header__mobile-cart {
      display: inline-flex;
    }

    .borrego-header__mobile-toggle {
      justify-self: start;
    }

    .borrego-header__mobile-cart {
      justify-self: end;
    }

    .borrego-header__logo-image {
      width: {{ section.settings.mobile_logo_size }}px;
      max-width: 42vw;
    }

    .borrego-header__logo-text {
      font-size: 1.05rem;
      font-weight: 680;
      letter-spacing: 0.125em;
    }
  }
{% endstyle %}

<borrego-header class="borrego-header">
  <div class="borrego-header__bar">
    <button
      type="button"
      class="borrego-header__mobile-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      data-borrego-mobile-open
    >
      {{ 'icon-hamburger.svg' | inline_asset_content }}
    </button>

    <nav class="borrego-header__desktop-nav" aria-label="Main menu">
      <ul class="borrego-header__nav-list">
        {%- for link in borrego_menu.links -%}
          <li class="borrego-header__nav-item">
            <a class="borrego-header__nav-link" href="{{ link.url }}">
              {{ link.title | escape }}
            </a>

            {%- if link.links.size > 0 -%}
              <div class="borrego-header__submenu">
                <ul class="borrego-header__submenu-list">
                  {%- for child_link in link.links -%}
                    <li>
                      <a class="borrego-header__submenu-link" href="{{ child_link.url }}">
                        {{ child_link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <a class="borrego-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {% assign logo_sizes = '(min-width: 990px) var(--logo-size), ' | append: section.settings.mobile_logo_size | append: 'px' %}
        {{
          section.settings.logo
          | image_url: width: 700
          | image_tag:
            class: 'borrego-header__logo-image',
            widths: '140, 220, 320, 440, 700',
            sizes: logo_sizes,
            preload: true,
            alt: section.settings.logo.alt
        }}
      {% else %}
        <span class="borrego-header__logo-text">BORREGO STREETWEAR</span>
      {% endif %}
    </a>

    <div class="borrego-header__utilities">
      <ul class="borrego-header__utility-list">
        <li>
          <a class="borrego-header__icon" href="{{ routes.search_url }}" aria-label="Search">
            {{ 'icon-search.svg' | inline_asset_content }}
          </a>
        </li>
        {% if section.settings.show_account_icon and shop.customer_accounts_enabled %}
          <li>
            <a
              class="borrego-header__icon"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="Account"
              rel="nofollow"
            >
              {{ 'icon-account.svg' | inline_asset_content }}
            </a>
          </li>
        {% endif %}
        <li>
          <a class="borrego-header__icon borrego-header__icon--cart" href="{{ routes.cart_url }}" aria-label="Cart">
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
              <path d="M6.8 8.4H17.2L18.1 20.2H5.9L6.8 8.4Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
              <path d="M9.1 8.4V6.7C9.1 4.85 10.35 3.6 12 3.6C13.65 3.6 14.9 4.85 14.9 6.7V8.4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/>
            </svg>
            {% if cart != empty %}
              <span class="borrego-header__cart-count">{{ cart.item_count }}</span>
            {% endif %}
          </a>
        </li>
      </ul>
    </div>

    <a class="borrego-header__icon borrego-header__icon--cart borrego-header__mobile-cart" href="{{ routes.cart_url }}" aria-label="Cart">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none">
        <path d="M6.8 8.4H17.2L18.1 20.2H5.9L6.8 8.4Z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/>
        <path d="M9.1 8.4V6.7C9.1 4.85 10.35 3.6 12 3.6C13.65 3.6 14.9 4.85 14.9 6.7V8.4" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/>
      </svg>
      {% if cart != empty %}
        <span class="borrego-header__cart-count">{{ cart.item_count }}</span>
      {% endif %}
    </a>
  </div>

  <div class="borrego-header__mobile-drawer">
    <button class="borrego-header__mobile-overlay" type="button" aria-label="Close menu" data-borrego-mobile-close></button>

    <aside class="borrego-header__mobile-panel" aria-label="Mobile menu">
      <div class="borrego-header__mobile-top">
        <span class="borrego-header__mobile-brand">BORREGO</span>
        <button type="button" class="borrego-header__mobile-close" aria-label="Close menu" data-borrego-mobile-close>
          {{ 'icon-close.svg' | inline_asset_content }}
        </button>
      </div>

      <div class="borrego-header__mobile-content">
        <ul class="borrego-header__mobile-list">
          {%- for link in borrego_menu.links -%}
            <li>
              {% if link.links.size > 0 %}
                <details class="borrego-header__mobile-details">
                  <summary class="borrego-header__mobile-summary">
                    <span>{{ link.title | escape }}</span>
                    {{ 'icon-caret.svg' | inline_asset_content }}
                  </summary>

                  <ul class="borrego-header__mobile-sublinks">
                    <li>
                      <a class="borrego-header__mobile-sublink" href="{{ link.url }}" data-borrego-mobile-link>
                        Ver todo
                      </a>
                    </li>
                    {% for child_link in link.links %}
                      <li>
                        <a class="borrego-header__mobile-sublink" href="{{ child_link.url }}" data-borrego-mobile-link>
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                <a class="borrego-header__mobile-link" href="{{ link.url }}" data-borrego-mobile-link>
                  {{ link.title | escape }}
                </a>
              {% endif %}
            </li>
          {%- endfor -%}
        </ul>

        <div class="borrego-header__mobile-footer">
          <ul class="borrego-header__mobile-socials">
            {% if section.settings.instagram_link != blank %}
              <li>
                <a class="borrego-header__mobile-social" href="{{ section.settings.instagram_link }}" target="_blank" rel="noopener">
                  Instagram
                </a>
              </li>
            {% endif %}
            {% if section.settings.tiktok_link != blank %}
              <li>
                <a class="borrego-header__mobile-social" href="{{ section.settings.tiktok_link }}" target="_blank" rel="noopener">
                  TikTok
                </a>
              </li>
            {% endif %}
            {% if section.settings.whatsapp_link != blank %}
              <li>
                <a class="borrego-header__mobile-social" href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener">
                  WhatsApp
                </a>
              </li>
            {% endif %}
          </ul>

          <div class="borrego-header__mobile-showroom">
            <strong>{{ section.settings.mobile_showroom_title }}</strong>
            <span>{{ section.settings.mobile_showroom_text }}</span>
          </div>
        </div>
      </div>
    </aside>
  </div>
</borrego-header>

<script>
  (() => {
    if (customElements.get('borrego-header')) return;

    class BorregoHeader extends HTMLElement {
      connectedCallback() {
        this.openButton = this.querySelector('[data-borrego-mobile-open]');
        this.closeButtons = this.querySelectorAll('[data-borrego-mobile-close]');
        this.mobileLinks = this.querySelectorAll('[data-borrego-mobile-link]');
        this.onScroll = this.handleScroll.bind(this);
        this.onKeydown = this.handleKeydown.bind(this);

        this.openButton?.addEventListener('click', () => this.openMobileMenu());
        this.closeButtons.forEach((button) => button.addEventListener('click', () => this.closeMobileMenu()));
        this.mobileLinks.forEach((link) => link.addEventListener('click', () => this.closeMobileMenu()));
        window.addEventListener('scroll', this.onScroll, { passive: true });
        document.addEventListener('keydown', this.onKeydown);
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.onScroll);
        document.removeEventListener('keydown', this.onKeydown);
        document.body.classList.remove('borrego-header-lock');
      }

      handleScroll() {
        this.classList.toggle('is-scrolled', window.scrollY > 12);
      }

      handleKeydown(event) {
        if (event.key !== 'Escape') return;
        this.closeMobileMenu();
      }

      openMobileMenu() {
        this.classList.add('is-mobile-open');
        this.openButton?.setAttribute('aria-expanded', 'true');
        document.body.classList.add('borrego-header-lock');
      }

      closeMobileMenu() {
        this.classList.remove('is-mobile-open');
        this.openButton?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('borrego-header-lock');
      }
    }

    customElements.define('borrego-header', BorregoHeader);
  })();
</script>

